detect_desktop_backend() {
    case ${UU_REMOTE_DESKTOP_BACKEND:-auto} in
        x11|x11-xtest)
            printf 'x11\n'
            return
            ;;
        wayland|wayland-xwayland|wayland-portal)
            printf 'wayland-xwayland\n'
            return
            ;;
        auto|'') ;;
        *)
            printf 'unsupported\n'
            return
            ;;
    esac

    case ${XDG_SESSION_TYPE:-} in
        wayland)
            if [[ -n ${WAYLAND_DISPLAY:-} && -n ${DISPLAY:-} ]]; then
                printf 'wayland-xwayland\n'
            else
                printf 'wayland-incomplete\n'
            fi
            ;;
        x11)
            printf 'x11\n'
            ;;
        *)
            if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
                printf 'wayland-xwayland\n'
            else
                # Preserve the historical headless/test default.
                printf 'x11\n'
            fi
            ;;
    esac
}

desktop_backend=$(detect_desktop_backend)
