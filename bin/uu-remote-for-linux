if ! flock -w "$operation_lock_timeout" 9; then
    die "另一个 UU 远程安装或启动操作仍在运行；等待 ${operation_lock_timeout} 秒后仍未获得操作锁"
fi

release_operation_lock() {
    flock -u 9 || true
    exec 9>&-
}

run_logged() {
    {
        printf '\n[%(%FT%T%z)T] ' -1
        printf '%q ' "$@"
        printf '\n'
        "$@" 9>&-
    } >>"$setup_log" 2>&1
}

download_installer() {
    local temp_file effective_url clean_url filename version checksum size magic
    local archive_file
    local source_url="${UU_REMOTE_OFFICIAL_INSTALLER_URL:-$official_installer_url_default}"

    temp_file=$(mktemp "$cache_dir/.UURemote_Setup.XXXXXX")
    notify_status "正在从网易官方下载客户端"
    printf '正在从网易官方下载 Windows 客户端……\n'
    if ! effective_url=$(network_curl --fail --location --retry 3 --connect-timeout 15 \
        --output "$temp_file" --write-out '%{url_effective}' "$source_url" 9>&-); then
        rm -f -- "$temp_file"
        die "官方安装包下载失败"
    fi

    size=$(stat -c '%s' "$temp_file")
    magic=$(od -An -tx1 -N2 "$temp_file" | tr -d '[:space:]')
    if ((size < 10485760)) || [[ $magic != 4d5a ]]; then
        rm -f -- "$temp_file"
        die "下载内容不是有效的 Windows 安装程序"
    fi

    clean_url=${effective_url%%\?*}
    filename=${clean_url##*/}
    version="unknown"
    if [[ $filename =~ UURemote_Setup_([0-9]+([.][0-9]+){2,3})_ ]]; then
        version=${BASH_REMATCH[1]}
    fi
    checksum=$(sha256sum "$temp_file")
    checksum=${checksum%% *}

    mkdir -p "$installer_archive_dir"
    archive_file="$installer_archive_dir/${version}-${checksum}.exe"
    if [[ -e $archive_file ]]; then
        cmp -s "$temp_file" "$archive_file" || {
            rm -f -- "$temp_file"
            die "同版本同哈希的安装包归档发生冲突；拒绝覆盖缓存"
        }
    else
        install -m0600 "$temp_file" "$archive_file" ||
            die "无法归档官方安装包"
    fi
    mv -f "$temp_file" "$installer"
    printf '%s\n' "$version" >"${installer_version_file}.tmp"
    mv -f "${installer_version_file}.tmp" "$installer_version_file"
    {
        printf 'version=%s\n' "$version"
        printf 'sha256=%s\n' "$checksum"
        printf 'size=%s\n' "$size"
        printf 'source=%s\n' "$source_url"
        printf 'effective_url=%s\n' "$effective_url"
        printf 'downloaded_at=%(%FT%T%z)T\n' -1
    } >"${installer_metadata_file}.tmp"
    mv -f "${installer_metadata_file}.tmp" "$installer_metadata_file"
    printf '已缓存官方安装包：版本 %s，SHA-256 %s\n' "$version" "$checksum"
}

if $refresh_installer; then
    download_installer
fi

stop_prefix_for_setup() {
    stop_managed_runtime_services
    [[ -f $prefix/system.reg ]] || return 0
    WINEPREFIX="$prefix" WINEDEBUG=-all "$wineserver" -k 9>&- \
        >>"$setup_log" 2>&1 || true
    WINEPREFIX="$prefix" WINEDEBUG=-all timeout 15s "$wineserver" -w \
        9>&- >>"$setup_log" 2>&1 ||
        die "更新前无法停止独立 Wine 前缀；请关闭 UU 远程后重试"
}

archive_streamer_original() {
    local source=$1 hash archive

    [[ -f $source ]] || return
    hash=$(file_sha256 "$source")
    archive="$streamer_archive/streamer-$hash.dll"
    if [[ ! -e $archive ]]; then
        install -Dm0600 "$source" "$archive" ||
            die "无法归档旧版 UU streamer.dll：$source"
    fi
}

streamer_bytes_at() {
    local file=$1 offset=$2

    dd if="$file" bs=1 skip="$offset" count=3 status=none |
        od -An -tx1 -v | tr -d ' \n'
}

deploy_streamer_patch() {
    local current_sha original_sha patched_temp installed_version

    if ! load_hwdecode_profile; then
        installed_version=$(
            registry_value "$installed_version_key" Version || true
        )
        if [[ -z $installed_version ]] ||
            ! ensure_hwdecode_profile "$installed_version"; then
            die "当前 UU 版本无法安全生成 NVDEC 兼容档案；未修改客户端"
        fi
    fi

    [[ -f $streamer_dll || -f $streamer_original ]] ||
        die "UU streamer.dll 缺失，请先运行：uu-remote-for-linux --repair"

    if [[ -f $streamer_original ]]; then
        original_sha=$(file_sha256 "$streamer_original")
        [[ $original_sha == "$streamer_original_sha" ]] ||
            die "streamer.dll 原版备份不属于受支持的 UU $streamer_profile_version；拒绝覆盖"

        if [[ -f $streamer_dll ]]; then
            current_sha=$(file_sha256 "$streamer_dll")
            if [[ $current_sha == "$streamer_patched_sha" ]]; then
                return
            fi
            [[ $current_sha == "$streamer_original_sha" ]] ||
                die "UU 已更新或 streamer.dll 被修改；当前版本尚无安全补丁，已保留所有文件"
        else
            install -Dm0644 "$streamer_original" "$streamer_dll" ||
                die "无法从备份恢复 UU streamer.dll"
        fi
    else
        [[ -f $streamer_dll ]] ||
            die "UU streamer.dll 缺失，请先运行：uu-remote-for-linux --repair"
        current_sha=$(file_sha256 "$streamer_dll")
        if [[ $current_sha == "$streamer_patched_sha" ]]; then
            die "发现已修改的 streamer.dll，但原版备份缺失；拒绝继续以避免数据丢失"
        fi
        [[ $current_sha == "$streamer_original_sha" ]] ||
            die "当前 streamer.dll 不属于受支持的 UU $streamer_profile_version；未应用版本相关补丁"
        mv "$streamer_dll" "$streamer_original" ||
            die "无法备份原版 UU streamer.dll"
    fi

    [[ $(streamer_bytes_at "$streamer_original" "$streamer_patch_offset_1") == "$streamer_patch_before_1" &&
        $(streamer_bytes_at "$streamer_original" "$streamer_patch_offset_2") == "$streamer_patch_before_2" ]] ||
        die "streamer.dll 补丁位置校验失败；未修改客户端"

    patched_temp="${streamer_dll}.uu-remote-new"
    install -Dm0644 "$streamer_original" "$patched_temp" ||
        die "无法暂存 UU streamer.dll"
    printf '%b' "\\x${streamer_patch_after_1:0:2}\\x${streamer_patch_after_1:2:2}\\x${streamer_patch_after_1:4:2}" |
        dd of="$patched_temp" bs=1 seek="$streamer_patch_offset_1" conv=notrunc status=none ||
        die "无法写入 NVDEC 选择补丁"
    printf '%b' "\\x${streamer_patch_after_2:0:2}\\x${streamer_patch_after_2:2:2}\\x${streamer_patch_after_2:4:2}" |
        dd of="$patched_temp" bs=1 seek="$streamer_patch_offset_2" conv=notrunc status=none ||
        die "无法写入 NVDEC 能力回填补丁"
    [[ $(file_sha256 "$patched_temp") == "$streamer_patched_sha" ]] || {
        rm -f -- "$patched_temp"
        die "streamer.dll 补丁后哈希不匹配；未替换客户端文件"
    }
    mv -f "$patched_temp" "$streamer_dll" ||
        die "无法安装已校验的 UU streamer.dll 补丁"

    if [[ -f $decoder_cache ]]; then
        if [[ ! -e $decoder_cache_backup ]]; then
            install -Dm0600 "$decoder_cache" "$decoder_cache_backup" ||
                die "无法备份 UU 解码能力缓存"
        fi
        rm -f -- "$decoder_cache"
    fi
}

remove_streamer_patch() {
    local current_sha original_sha

    load_hwdecode_profile || load_hwdecode_profile_from_streamer_files ||
        die "当前 UU 版本没有经过校验的 NVDEC 兼容档案；未修改客户端"

    if [[ -f $streamer_original ]]; then
        original_sha=$(file_sha256 "$streamer_original")
        [[ $original_sha == "$streamer_original_sha" ]] ||
            die "streamer.dll 原版备份无法验证；为避免数据丢失，未关闭硬解桥"

        if [[ ! -f $streamer_dll ]]; then
            mv "$streamer_original" "$streamer_dll" ||
                die "无法恢复原版 UU streamer.dll"
        else
            current_sha=$(file_sha256 "$streamer_dll")
            if [[ $current_sha == "$streamer_patched_sha" ]]; then
                rm -f -- "$streamer_dll"
                mv "$streamer_original" "$streamer_dll" ||
                    die "无法恢复原版 UU streamer.dll"
            else
                # An official update has already replaced the patched file.
                archive_streamer_original "$streamer_original"
                rm -f -- "$streamer_original"
            fi
        fi
    elif [[ -f $streamer_dll ]] &&
        [[ $(file_sha256 "$streamer_dll") == "$streamer_patched_sha" ]]; then
        die "已修改的 streamer.dll 缺少原版备份；为避免破坏客户端，未关闭硬解桥"
    fi
    rm -f -- "${streamer_dll}.uu-remote-new"

    rm -f -- "$decoder_cache"
    if [[ -f $decoder_cache_backup ]]; then
        install -Dm0600 "$decoder_cache_backup" "$decoder_cache" ||
            die "无法恢复原版 UU 解码能力缓存"
        rm -f -- "$decoder_cache_backup"
    fi
}

snapshot_exact_file_set() {
    local snapshot=$1 paths_name=$2 index path
    local -n snapshot_paths=$paths_name

    mkdir -p "$snapshot/files" || return 1
    for ((index = 0; index < ${#snapshot_paths[@]}; ++index)); do
        path=${snapshot_paths[index]}
        if [[ -e $path || -L $path ]]; then
            cp -a -- "$path" "$snapshot/files/$index" || return 1
        fi
    done
}

restore_exact_file_set() {
    local snapshot=$1 paths_name=$2 index path saved
    local status=0
    local -n snapshot_paths=$paths_name

    for ((index = 0; index < ${#snapshot_paths[@]}; ++index)); do
        path=${snapshot_paths[index]}
        saved="$snapshot/files/$index"
        if [[ -e $path || -L $path ]]; then
            rm -f -- "$path" || status=1
        fi
        if [[ -e $saved || -L $saved ]]; then
            mkdir -p -- "$(dirname -- "$path")" || status=1
            mv -- "$saved" "$path" || status=1
        fi
    done
    return "$status"
}

deploy_hwdecode_bridge_impl() {
    local name source target temp_manifest hash i generated_version
    local -a names sources targets

    hwdecode_runtime_ready ||
        die "软件包未包含完整硬件解码桥，请重新安装本项目"
    hwdecode_host_libraries_ready ||
        die "未找到 NVIDIA libcuda.so.1 和 libnvcuvid.so.1；请安装匹配当前内核的 NVIDIA 专有驱动"
    app_files_present ||
        die "UU 远程客户端尚未完整安装，请先运行：uu-remote-for-linux --setup-only"

    names=(d3d11 dxgi nvcuda nvcuvid dxgi-probe)
    sources=(
        "$hwdecode_dxvk_dir/d3d11.dll"
        "$hwdecode_dxvk_dir/dxgi.dll"
        "$hwdecode_wine_dir/x86_64-windows/nvcuda.dll"
        "$hwdecode_wine_dir/x86_64-windows/nvcuvid.dll"
        "$hwdecode_dxgi_probe_source"
    )
    targets=(
        "$hwdecode_d3d11"
        "$hwdecode_dxgi"
        "$hwdecode_nvcuda"
        "$hwdecode_nvcuvid"
        "$hwdecode_dxgi_probe"
    )

    for ((i = 0; i < ${#names[@]}; i++)); do
        name=${names[i]}
        source=${sources[i]}
        target=${targets[i]}
        if [[ -e $target ]] && ! hwdecode_file_owned "$name" "$source" "$target"; then
            die "发现非本项目管理的 $target；为避免覆盖，未启用硬件解码桥"
        fi
    done

    deploy_streamer_patch
    for ((i = 0; i < ${#names[@]}; i++)); do
        source=${sources[i]}
        target=${targets[i]}
        install -Dm0644 "$source" "${target}.uu-remote-new" ||
            die "无法暂存硬件解码 DLL：$target"
        mv -f "${target}.uu-remote-new" "$target" ||
            die "无法安装硬件解码 DLL：$target"
    done

    temp_manifest=$(mktemp "$data_dir/.hwdecode-manifest.XXXXXX")
    for ((i = 0; i < ${#names[@]}; i++)); do
        hash=$(sha256sum "${sources[i]}")
        hash=${hash%% *}
        printf '%s=%s\n' "${names[i]}" "$hash" >>"$temp_manifest"
    done
    mv -f "$temp_manifest" "$hwdecode_manifest"
    printf '%s\n' "$package_version" >"${hwdecode_enabled_stamp}.tmp"
    mv -f "${hwdecode_enabled_stamp}.tmp" "$hwdecode_enabled_stamp"

    hwdecode_files_deployed ||
        die "硬件解码桥写入后核验失败"

    if hwdecode_profile_generated "$streamer_profile_version"; then
        generated_version=$streamer_profile_version
        if ! probe_hwdecode_bridge; then
            printf '自动生成的 NVDEC 档案未通过真实运行验证，正在恢复官方解码文件。\n' >&2
            remove_hwdecode_bridge
            remove_generated_hwdecode_profile "$generated_version"
            die "UU $generated_version 的自动 NVDEC 补丁已安全撤销；客户端未保留未经验证的二进制修改"
        fi
        printf 'UU %s 的自动 NVDEC 补丁已通过 DXGI 与官方解码探测器验证。\n' \
            "$generated_version"
    fi
}

deploy_hwdecode_bridge() {
    local snapshot status
    local -a paths=(
        "$hwdecode_d3d11"
        "$hwdecode_dxgi"
        "$hwdecode_nvcuda"
        "$hwdecode_nvcuvid"
        "$hwdecode_dxgi_probe"
        "${hwdecode_d3d11}.uu-remote-new"
        "${hwdecode_dxgi}.uu-remote-new"
        "${hwdecode_nvcuda}.uu-remote-new"
        "${hwdecode_nvcuvid}.uu-remote-new"
        "${hwdecode_dxgi_probe}.uu-remote-new"
        "$streamer_dll"
        "$streamer_original"
        "${streamer_dll}.uu-remote-new"
        "$decoder_cache"
        "$decoder_cache_backup"
        "$hwdecode_manifest"
        "$hwdecode_enabled_stamp"
        "${hwdecode_enabled_stamp}.tmp"
    )

    mkdir -p "$data_dir"
    snapshot=$(mktemp -d "$data_dir/.hwdecode-deploy-snapshot.XXXXXX") ||
        die "无法创建 NVDEC 部署事务快照；客户端未作修改"
    if ! snapshot_exact_file_set "$snapshot" paths; then
        rm -rf -- "$snapshot"
        die "无法保存 NVDEC 部署前状态；客户端未作修改"
    fi
    if (deploy_hwdecode_bridge_impl); then
        rm -rf -- "$snapshot"
        return 0
    else
        status=$?
    fi
    if restore_exact_file_set "$snapshot" paths; then
        rm -rf -- "$snapshot"
        printf 'NVDEC 部署失败，已精确恢复部署前文件。\n' >&2
    else
        printf 'NVDEC 部署失败且未能完整恢复；事务快照已保留：%s\n' \
            "$snapshot" >&2
    fi
    return "$status"
}

remove_hwdecode_bridge() {
    local name source target i
    local -a names sources targets

    names=(d3d11 dxgi nvcuda nvcuvid dxgi-probe)
    sources=(
        "$hwdecode_dxvk_dir/d3d11.dll"
        "$hwdecode_dxvk_dir/dxgi.dll"
        "$hwdecode_wine_dir/x86_64-windows/nvcuda.dll"
        "$hwdecode_wine_dir/x86_64-windows/nvcuvid.dll"
        "$hwdecode_dxgi_probe_source"
    )
    targets=(
        "$hwdecode_d3d11"
        "$hwdecode_dxgi"
        "$hwdecode_nvcuda"
        "$hwdecode_nvcuvid"
        "$hwdecode_dxgi_probe"
    )

    remove_streamer_patch
    for ((i = 0; i < ${#names[@]}; i++)); do
        name=${names[i]}
        source=${sources[i]}
        target=${targets[i]}
        if hwdecode_file_owned "$name" "$source" "$target"; then
            if [[ $name == d3d11 || $name == dxgi ]] && hwencode_enabled; then
                :
            else
                rm -f -- "$target"
            fi
        elif [[ -e $target ]]; then
            printf '保留非本项目管理或已被修改的文件：%s\n' "$target" >&2
        fi
        rm -f -- "${target}.uu-remote-new"
    done
    rm -f -- "$hwdecode_enabled_stamp" "$hwdecode_manifest"
}

deploy_hwencode_bridge_impl() {
    local name source target temp_manifest hash i status=0
    local -a names sources targets

    hwencode_runtime_ready || {
        printf '软件包未包含完整 NVENC 编码桥。\n' >&2
        return 1
    }
    hwencode_host_libraries_ready || {
        printf '未找到 NVIDIA libcuda.so.1 或 libnvidia-encode.so.1。\n' >&2
        return 1
    }
    app_files_present || {
        printf 'UU 远程客户端尚未完整安装。\n' >&2
        return 1
    }

    names=(d3d11 dxgi nvencodeapi64 nvenc-probe)
    sources=(
        "$hwdecode_dxvk_dir/d3d11.dll"
        "$hwdecode_dxvk_dir/dxgi.dll"
        "$hwdecode_wine_dir/x86_64-windows/nvencodeapi64.dll"
        "$hwencode_probe_source"
    )
    targets=(
        "$hwdecode_d3d11"
        "$hwdecode_dxgi"
        "$hwencode_nvencode"
        "$hwencode_probe"
    )

    for ((i = 0; i < ${#names[@]}; i++)); do
        name=${names[i]}
        source=${sources[i]}
        target=${targets[i]}
        if [[ -e $target ]] && ! cmp -s "$source" "$target" &&
            ! hwencode_file_owned "$name" "$source" "$target"; then
            printf '发现非本项目管理的 %s；拒绝覆盖。\n' "$target" >&2
            return 1
        fi
    done

    for ((i = 0; i < ${#names[@]}; i++)); do
        source=${sources[i]}
        target=${targets[i]}
        install -Dm0644 "$source" "${target}.uu-remote-new" || {
            status=1
            break
        }
        mv -f "${target}.uu-remote-new" "$target" || {
            status=1
            break
        }
    done
    if ((status != 0)); then
        printf '无法安装 NVENC/DXVK 编码桥文件。\n' >&2
        return 1
    fi
    printf 'dxgi.hideNvidiaGpu = False\n' >"${hwencode_dxvk_config}.tmp"
    mv -f "${hwencode_dxvk_config}.tmp" "$hwencode_dxvk_config"

    temp_manifest=$(mktemp "$data_dir/.hwencode-manifest.XXXXXX")
    for ((i = 0; i < ${#names[@]}; i++)); do
        hash=$(file_sha256 "${sources[i]}") || return 1
        printf '%s=%s\n' "${names[i]}" "$hash" >>"$temp_manifest"
    done
    mv -f "$temp_manifest" "$hwencode_manifest"

    if ! hwencode_files_deployed || ! probe_hwencode_bridge; then
        printf 'NVENC 深层探测失败，正在保留 OpenH264 安全回退。\n' >&2
        "$hwencode_policy" disable \
            "$encoder_cache" "$encoder_cache_backup" \
            >>"$setup_log" 2>&1 || true
        rm -f -- "$hwencode_enabled_stamp"
        return 1
    fi

    printf '%s\n' "$package_version" >"${hwencode_enabled_stamp}.tmp"
    mv -f "${hwencode_enabled_stamp}.tmp" "$hwencode_enabled_stamp"
    rm -f -- "$hwencode_disabled_stamp" "$hwencode_failed_stamp"
    apply_hwencode_policy || status=$?
    if ((status != 0 && status != 2)); then
        printf 'NVENC 已通过深层探测，但编码能力缓存尚未能切换。\n' >&2
        return 1
    fi
}

deploy_hwencode_bridge() {
    local snapshot status
    local -a paths=(
        "$hwdecode_d3d11"
        "$hwdecode_dxgi"
        "$hwencode_nvencode"
        "$hwencode_probe"
        "${hwdecode_d3d11}.uu-remote-new"
        "${hwdecode_dxgi}.uu-remote-new"
        "${hwencode_nvencode}.uu-remote-new"
        "${hwencode_probe}.uu-remote-new"
        "$hwencode_dxvk_config"
        "${hwencode_dxvk_config}.tmp"
        "$hwencode_manifest"
        "$hwencode_probe_status"
        "$hwencode_enabled_stamp"
        "${hwencode_enabled_stamp}.tmp"
        "$hwencode_disabled_stamp"
        "$hwencode_failed_stamp"
        "$encoder_cache"
        "$encoder_cache_backup"
    )

    mkdir -p "$data_dir" "$state_dir"
    snapshot=$(mktemp -d "$data_dir/.hwencode-deploy-snapshot.XXXXXX") || {
        printf '无法创建 NVENC 部署事务快照；客户端未作修改。\n' >&2
        return 1
    }
    if ! snapshot_exact_file_set "$snapshot" paths; then
        rm -rf -- "$snapshot"
        printf '无法保存 NVENC 部署前状态；客户端未作修改。\n' >&2
        return 1
    fi
    if (deploy_hwencode_bridge_impl); then
        rm -rf -- "$snapshot"
        return 0
    else
        status=$?
    fi
    if restore_exact_file_set "$snapshot" paths; then
        rm -rf -- "$snapshot"
        printf 'NVENC 部署失败，已精确恢复部署前文件。\n' >&2
    else
        printf 'NVENC 部署失败且未能完整恢复；事务快照已保留：%s\n' \
            "$snapshot" >&2
    fi
    return "$status"
}

remove_hwencode_bridge() {
    local name source target i
    local -a names sources targets

    stop_hwencode_policy_runtime
    # Make the compatibility watcher exit before restoring the original cache.
    # The systemd unit is stopped above; this also covers the nohup fallback.
    rm -f -- "$hwencode_enabled_stamp"
    "$hwencode_policy" disable \
        "$encoder_cache" "$encoder_cache_backup" \
        >>"$setup_log" 2>&1 || true
    names=(d3d11 dxgi nvencodeapi64 nvenc-probe)
    sources=(
        "$hwdecode_dxvk_dir/d3d11.dll"
        "$hwdecode_dxvk_dir/dxgi.dll"
        "$hwdecode_wine_dir/x86_64-windows/nvencodeapi64.dll"
        "$hwencode_probe_source"
    )
    targets=(
        "$hwdecode_d3d11"
        "$hwdecode_dxgi"
        "$hwencode_nvencode"
        "$hwencode_probe"
    )
    for ((i = 0; i < ${#names[@]}; i++)); do
        name=${names[i]}
        source=${sources[i]}
        target=${targets[i]}
        if [[ $name == d3d11 || $name == dxgi ]] && hwdecode_enabled; then
            continue
        fi
        if hwencode_file_owned "$name" "$source" "$target"; then
            rm -f -- "$target"
        elif [[ -e $target && $name != d3d11 && $name != dxgi ]]; then
            printf '保留非本项目管理或已被修改的文件：%s\n' "$target" >&2
        fi
        rm -f -- "${target}.uu-remote-new"
    done
    rm -f -- "$hwencode_enabled_stamp" "$hwencode_manifest" \
        "$hwencode_probe_status" "$hwencode_dxvk_config"
}

ensure_auto_hwencode() {
    local status=0

    [[ ${UU_REMOTE_DISABLE_AUTO_HWENCODE:-0} != 1 ]] || return 0
    hwencode_disabled && return 0
    hwencode_runtime_ready && hwencode_host_libraries_ready || return 0
    if hwencode_failure_current; then
        return 0
    fi
    if hwencode_files_deployed && hwencode_probe_current; then
        configure_hwencode_environment
        apply_hwencode_policy || status=$?
        ((status == 0 || status == 2)) && return 0
    fi

    stop_prefix_for_setup
    if deploy_hwencode_bridge; then
        notify_status "NVIDIA NVENC/HEVC 编码桥已自动验证并启用"
        printf 'NVIDIA NVENC/HEVC 编码桥已自动验证并启用。\n'
        return 0
    fi
    mark_hwencode_failure
    notify_status "NVENC 深层验证失败，已保留 OpenH264 回退"
    printf '警告：NVENC 深层验证失败；当前客户端版本安全保留 OpenH264，更新后将重新探测。\n' >&2
}

finalize_hwencode_policy() {
    local attempt status=0 previous_hash="" current_hash="" stable=0

    hwencode_enabled || return 0
    # GameViewerServer may regenerate this cache just after process startup
    # when DXVK exposes the real NVIDIA PCI ID.  Wait for the file to settle,
    # then apply the policy after that official probe instead of accepting the
    # stale pre-start cache as final.
    for ((attempt = 0; attempt < 60; attempt++)); do
        if [[ -f $encoder_cache ]]; then
            current_hash=$(file_sha256 "$encoder_cache" 2>/dev/null || true)
            if [[ -n $current_hash && $current_hash == "$previous_hash" ]]; then
                stable=$((stable + 1))
                ((stable >= 10)) && break
            else
                stable=0
                previous_hash=$current_hash
            fi
        fi
        sleep 0.2
    done
    apply_hwencode_policy || status=$?
    if ((status == 0)); then
        printf 'UU 编码器能力缓存已切换为 NVIDIA NVENC 优先。\n'
        return 0
    fi
    "$hwencode_policy" disable \
        "$encoder_cache" "$encoder_cache_backup" \
        >>"$setup_log" 2>&1 || true
    rm -f -- "$hwencode_enabled_stamp"
    mark_hwencode_failure
    notify_status "NVENC 能力缓存验证失败，已恢复 OpenH264"
    printf '警告：NVENC 能力缓存验证失败；已恢复 OpenH264 安全回退。\n' >&2
    return 1
}

configure_hwdecode_environment() {
    export WINEDLLPATH="${hwdecode_wine_dir}${WINEDLLPATH:+:$WINEDLLPATH}"
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+${WINEDLLOVERRIDES};}d3d11=n;dxgi=n;nvcuda=b;nvcuvid=b"
    export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-none}"
}

probe_hwdecode_bridge() {
    local adapters results device_id adapter_id vendor_id adapter_index
    local detector_ok=false

    [[ -f $hwdecode_dxgi_probe && -f $codec_detector ]] || return 1
    adapters=$(mktemp "$cache_dir/.hwdecode-adapters.XXXXXX")
    results=$(mktemp "$cache_dir/.hwdecode-results.XXXXXX")
    configure_hwdecode_environment

    if ! (
        cd "$install_dir/bin"
        env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
            -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
            -u ALL_PROXY -u NO_PROXY \
            timeout 30s "$wine" "$hwdecode_dxgi_probe"
    ) >"$adapters" 2>>"$setup_log"; then
        rm -f -- "$adapters" "$results"
        printf 'DXGI 无法枚举可用于 UU 的真实显卡。\n' >&2
        return 1
    fi
    sed -i 's/\r$//' "$adapters"

    while IFS=$'\t' read -r \
        device_id adapter_id vendor_id adapter_index; do
        [[ $device_id =~ ^[0-9]+$ &&
            $adapter_id =~ ^-?[0-9]+$ &&
            $vendor_id =~ ^[0-9]+$ &&
            $adapter_index =~ ^[0-9]+$ ]] || continue
        : >"$results"
        if (
            cd "$install_dir/bin"
            env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
                -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
                -u ALL_PROXY -u NO_PROXY \
                timeout 60s "$wine" "$codec_detector" \
                    --batch 33 "$device_id" "$adapter_id"
        ) >"$results" 2>>"$setup_log"; then
            sed -i 's/\r$//' "$results"
            if grep -qx 'BATCH_DONE' "$results" &&
                awk -F, '
                $1 == "RESULT" && $2 == 1 && $3 == 1 && $4 == 8 &&
                    $5 >= 1920 && $6 >= 1080 && $7 == 1 { h264 = 1 }
                $1 == "RESULT" && $2 == 2 && $3 == 1 && $4 == 8 &&
                    $5 >= 1920 && $6 >= 1080 && $7 == 1 { h265 = 1 }
                END { exit !(h264 && h265) }
                ' "$results"; then
                detector_ok=true
                {
                    printf '\n[%(%FT%T%z)T] NVDEC 自动补丁运行验证通过；' -1
                    printf 'DXGI adapter=%s device=%s luid=%s vendor=%s\n' \
                        "$adapter_index" "$device_id" "$adapter_id" "$vendor_id"
                    sed -n '/^RESULT,/p; /^BATCH_DONE$/p' "$results"
                } >>"$setup_log"
                break
            fi
        fi
    done <"$adapters"

    $detector_ok || {
        {
            printf '\n[%(%FT%T%z)T] NVDEC 自动补丁运行验证失败；' -1
            printf '仅记录解码能力结果\n'
            sed -n '/^RESULT,/p; /^BATCH_/p' "$results"
        } >>"$setup_log"
        rm -f -- "$adapters" "$results"
        printf 'UU 自带解码探测器未确认 H.264/H.265 NVDEC 能力。\n' >&2
        return 1
    }
    rm -f -- "$adapters" "$results"
}

apply_decoder_selection() {
    local requested effective cuda_index installed_version

    requested=$(saved_decoder_selection || true)
    [[ -n $requested ]] || return 0

    effective=$requested
    if [[ $requested == auto ]]; then
        effective=$("$decoder_selector" --best-id 2>/dev/null || printf 'cpu')
    fi

    case $effective in
        cpu)
            if hwdecode_enabled || streamer_bridge_ready; then
                stop_prefix_for_setup
                remove_hwdecode_bridge
                printf '已按设备策略切换到 UU CPU 解码路径。\n'
            fi
            ;;
        nvidia:*)
            installed_version=$(
                registry_value "$installed_version_key" Version || true
            )
            if [[ -n $installed_version ]] &&
                ! ensure_hwdecode_profile "$installed_version"; then
                if hwdecode_enabled || streamer_bridge_ready; then
                    stop_prefix_for_setup
                    remove_hwdecode_bridge
                fi
                printf 'UU %s 的 NVDEC 指令布局无法安全自动识别；本次使用 CPU 解码，已保留所选 NVIDIA 设备。\n' \
                    "$installed_version"
                return 0
            fi
            cuda_index=${effective#nvidia:}
            [[ $cuda_index =~ ^[0-9]+$ ]] ||
                die "无效的 NVIDIA 解码设备：$effective"
            "$decoder_selector" --supports-id "$effective" ||
                die "选定的 NVIDIA 解码设备当前不可用：$effective。请重新运行 --select-decoder"
            export UU_REMOTE_CUDA_DEVICE="$cuda_index"
            if ! hwdecode_enabled || ! hwdecode_files_deployed; then
                stop_prefix_for_setup
                deploy_hwdecode_bridge
                printf '已按设备策略启用 NVIDIA NVDEC 桥。\n'
            fi
            ;;
        *)
            die "不支持的解码设备选择：$effective"
            ;;
    esac
}

prepare_prefix() {
    local wine_desktop wine_user

    if [[ ! -f $prefix/system.reg ]]; then
        mkdir -p "$prefix"
        notify_status "正在创建独立 Wine 前缀"
        if ! WINEARCH=win64 WINEDLLOVERRIDES='mscoree,mshtml=;winemenubuilder.exe=d' \
            WINEDEBUG=-all "$wineboot" --init 9>&- >>"$setup_log" 2>&1; then
            die "创建 Wine 前缀失败，详见 $setup_log"
        fi
    fi

    wine_user=$(id -un)
    wine_desktop="$prefix/drive_c/users/$wine_user/Desktop"
    if [[ -L $wine_desktop ]]; then
        rm -f -- "$wine_desktop"
    fi
    mkdir -p "$wine_desktop"

    run_logged "$winecfg" -v win10 ||
        die "无法把 Wine 前缀设置为 Windows 10"
}

install_or_update_app() {
    local installed_version="" cached_version="unknown"
    local install_required=false attempt

    if app_files_present; then
        installed_version=$(registry_value "$installed_version_key" Version || true)
    fi
    if [[ -r $installer_version_file ]]; then
        cached_version=$(<"$installer_version_file")
    fi

    if ! app_files_present || [[ -z $installed_version ]]; then
        install_required=true
    elif [[ $cached_version != unknown ]] &&
        ! version_at_least "$installed_version" "$cached_version"; then
        install_required=true
    fi

    if ! $install_required; then
        return
    fi

    if [[ ! -f $installer ]]; then
        download_installer
        cached_version=$(<"$installer_version_file")
    fi

    notify_status "正在安装网易 UU 远程 $cached_version"
    printf '正在安装网易 UU 远程 %s……\n' "$cached_version"
    if ! run_logged "$wine" "$installer" /S /launchapp=0 /autorun=0; then
        printf '安装程序返回非零状态；继续核验已安装文件。\n' >>"$setup_log"
    fi

    for ((attempt = 0; attempt < 160; attempt++)); do
        app_files_present && break
        sleep 0.25
    done
    app_files_present ||
        die "安装程序未生成预期的客户端和服务文件，详见 $setup_log"
    rm -f -- "$prefix/drive_c/users/$(id -un)/Desktop/UU远程.lnk"
}

deploy_input_hook() {
    [[ -r $input_hook_source && -r $input_injector_source ]] ||
        die "缺少 Win64 输入钩子或注入监视器"
    install -m 0644 "$input_hook_source" "$input_hook" ||
        die "无法把 Win64 输入钩子部署到独立 Wine 前缀"
    install -m 0644 "$input_hook_source" "$input_hook_preload" ||
        die "无法把 Win64 输入钩子部署到服务端预加载目录"
    install -m 0644 "$input_injector_source" "$input_injector" ||
        die "无法把 Win64 输入注入监视器部署到独立 Wine 前缀"
    input_hook_ready || die "Win64 输入钩子部署后核验失败"
}

configure_compatibility() {
    local attempt webview_version=""

    mkdir -p -- "$mobile_download_dir" ||
        die "无法创建移动设备文件接收目录：$mobile_download_dir"
    [[ -w $mobile_download_dir ]] ||
        die "移动设备文件接收目录不可写：$mobile_download_dir"
    install -m 0644 "$shim_source" "$native_wevtapi" ||
        die "无法安装 Event Log 兼容 DLL"
    deploy_update_blocker
    deploy_input_hook

    run_logged "$wine" reg query "$service_key" ||
        die "UU 远程未注册 $service_name"
    run_logged "$wine" reg add "$service_key" /v Start /t REG_DWORD /d 2 /f ||
        die "无法启用 $service_name"

    if ! webview_ready; then
        [[ -f $webview_setup ]] ||
            die "官方客户端未包含 WebView2 安装程序"
        notify_status "正在安装 Microsoft Edge WebView2"
        printf '正在安装 Microsoft Edge WebView2……\n'
        if ! run_logged "$wine" "$webview_setup" /silent /install; then
            printf 'WebView2 安装程序返回非零状态；继续核验运行库。\n' >>"$setup_log"
        fi
        for ((attempt = 0; attempt < 180; attempt++)); do
            webview_ready && break
            sleep 0.5
        done
        webview_ready ||
            die "WebView2 安装未完成，详见 $setup_log"
    fi

    run_logged "$wine" reg add \
        'HKCU\Software\Wine\AppDefaults\msedgewebview2.exe' \
        /v Version /t REG_SZ /d win8 /f ||
        die "无法配置 WebView2 兼容模式"
    # The Linux host supplies display and input integration.  Reporting Win7
    # only to the server prevents UU 4.36+ from installing Windows IDD,
    # gvInput, and ViGEm kernel drivers into Wine's emulated device database.
    # Repeated installs otherwise leave phantom devices and can terminate the
    # server before its IPC runtime starts, leaving only a transparent client
    # shell for tray activation.  The Qt controller keeps Wine's default
    # version so WebView2 and the visible application are unaffected.
    run_logged "$wine" reg add "$server_compat_key" \
        /v Version /t REG_SZ /d win7 /f ||
        die "无法隔离 UU 服务端的 Windows 内核驱动初始化"
    run_logged "$wine" reg add 'HKCU\Software\Wine\X11 Driver' \
        /v UseTakeFocus /t REG_SZ /d N /f ||
        die "无法配置 Wine X11 焦点处理"
    run_logged "$wine" reg add "$controller_xim_key" \
        /v UseXIM /t REG_SZ /d N /f ||
        die "无法禁用 UU 主控窗口的 Wine 本地 XIM 输入法"
    run_logged "$wine" reg add "$controller_xim_key" \
        /v UseTakeFocus /t REG_SZ /d Y /f ||
        die "无法启用 UU 主控窗口的 Wine WM_TAKE_FOCUS 协议"
    run_logged "$wine" reg add \
        'HKLM\Software\Microsoft\Windows NT\CurrentVersion\FontSubstitutes' \
        /v 'MS Shell Dlg' /t REG_SZ /d 'Noto Sans CJK SC' /f ||
        die "无法配置 Wine 托盘中文字体回退"
    run_logged "$wine" reg add \
        'HKLM\Software\Microsoft\Windows NT\CurrentVersion\FontSubstitutes' \
        /v 'MS Shell Dlg 2' /t REG_SZ /d 'Noto Sans CJK SC' /f ||
        die "无法配置 Wine 托盘中文字体回退"

    webview_version=$(registry_value "$webview_key" pv || true)
    app_files_present || die "设置过程中客户端文件丢失"
    shim_ready || die "Event Log 兼容 DLL 核验失败"
    input_hook_ready || die "Win64 输入钩子核验失败"
    update_blocker_ready || die "自动更新保护程序核验失败"
    server_windows_driver_compat_enabled ||
        die "UU 服务端 Windows 内核驱动隔离设置核验失败"
    controller_xim_disabled || die "Wine 主控窗口 XIM 禁用设置核验失败"
    controller_take_focus_enabled ||
        die "Wine 主控窗口 WM_TAKE_FOCUS 设置核验失败"
    [[ -n $webview_version &&
        -f "$webview_root/$webview_version/msedgewebview2.exe" ]] ||
        die "WebView2 核验失败"

    printf '%s\n' "$package_version" >"${package_stamp}.tmp"
    mv -f "${package_stamp}.tmp" "$package_stamp"
}

prefix_needs_configuration() {
    app_files_present || return 0
    webview_ready || return 0
    shim_ready || return 0
    update_blocker_ready || return 0
    server_windows_driver_compat_enabled || return 0
    controller_xim_disabled || return 0
    controller_take_focus_enabled || return 0
    if wol_enabled; then
        wol_runtime_bridge_ready || return 0
    fi
    [[ -d $mobile_download_dir && -w $mobile_download_dir ]] || return 0
    [[ -r $package_stamp && $(<"$package_stamp") == "$package_version" ]] || return 0
    return 1
}

create_update_snapshot() {
    local temp snapshot
    local relative_install='drive_c/Program Files/Netease/GameViewer'
    local -a paths

    mkdir -p "$update_rollback_dir"
    temp=$(mktemp "$update_rollback_dir/.snapshot.XXXXXX")
    snapshot="$update_rollback_dir/pre-update.tar"
    paths=("$relative_install")
    [[ -f $prefix/system.reg ]] && paths+=("system.reg")
    [[ -f $prefix/user.reg ]] && paths+=("user.reg")
    [[ -f $prefix/userdef.reg ]] && paths+=("userdef.reg")
    [[ -f $client_setting_file ]] &&
        paths+=("drive_c/users/$(id -un)/AppData/Local/GameViewer/setting.ini")
    [[ -d "$local_appdata/upgrade" ]] &&
        paths+=("drive_c/users/$(id -un)/AppData/Local/GameViewer/upgrade")
    [[ -f $hwdecode_nvcuda ]] &&
        paths+=("drive_c/windows/system32/nvcuda.dll")
    [[ -f $hwdecode_nvcuvid ]] &&
        paths+=("drive_c/windows/system32/nvcuvid.dll")
    [[ -f $hwencode_nvencode ]] &&
        paths+=("drive_c/windows/system32/nvEncodeAPI64.dll")

    notify_status "正在创建更新回滚点"
    if ! tar --format=pax -C "$prefix" -cf "$temp" "${paths[@]}"; then
        rm -f -- "$temp"
        die "无法创建更新回滚点；现有客户端未作修改"
    fi
    mv -f "$temp" "$snapshot"
    printf '%s\n' "$snapshot"
}

version_bridge_state_names() {
    local -n result=$1

    result=(
        update-blocker-manifest
        hwdecode-enabled
        hwdecode-manifest
        hwdecode-generated.tsv
        wol-generated.tsv
        streamer-compatibility.json
        streamer-profiles
        decoder-cache-before-hwdecode.json
        hwencode-enabled
        hwencode-disabled
        hwencode-failed
        hwencode-manifest
        encoder-cache-before-hwencode.json
        dxvk-hwencode.conf
        wol-enabled
    )
}

refresh_restored_update_blocker_manifest() {
    local original_sha app_version

    [[ -r $update_blocker_source &&
        -f $native_upgrade && -f $native_upgrade_original ]] || return 1
    cmp -s "$update_blocker_source" "$native_upgrade" || return 1
    original_sha=$(file_sha256 "$native_upgrade_original") || return 1
    app_version=$(registry_value "$installed_version_key" Version || true)
    [[ -n $app_version ]] || return 1
    write_update_blocker_manifest "$original_sha" "$app_version"
    update_blocker_ready
}

write_version_bridge_state_snapshot() {
    local snapshot=$1
    local name
    local -a names
    local -a paths=()

    version_bridge_state_names names
    for name in "${names[@]}"; do
        [[ -e $data_dir/$name || -L $data_dir/$name ]] && paths+=("$name")
    done
    if ((${#paths[@]} > 0)); then
        tar --format=pax -C "$data_dir" -cf "$snapshot" "${paths[@]}"
    else
        tar --format=pax -cf "$snapshot" --files-from /dev/null
    fi
}

create_version_bridge_state_snapshot() {
    local snapshot="$update_rollback_dir/pre-update-bridge-state.tar"
    local temp

    mkdir -p "$update_rollback_dir"
    temp=$(mktemp "$update_rollback_dir/.bridge-snapshot.XXXXXX")
    if ! write_version_bridge_state_snapshot "$temp"; then
        rm -f -- "$temp"
        die "无法保存版本绑定兼容桥状态；现有客户端未作修改"
    fi
    mv -f "$temp" "$snapshot"
    printf '%s\n' "$snapshot"
}

restore_version_bridge_state_snapshot() {
    local snapshot=$1
    local staging backup name source target
    local commit_failed=0 rollback_failed=0
    local -a names backed_up=() restored=()
    local index

    [[ -f $snapshot ]] || return 1
    mkdir -p "$data_dir"
    staging=$(mktemp -d "$data_dir/.bridge-restore-stage.XXXXXX") || return 1
    backup=$(mktemp -d "$data_dir/.bridge-restore-backup.XXXXXX") || {
        rm -rf -- "$staging"
        return 1
    }
    if ! tar -C "$staging" -xf "$snapshot"; then
        rm -rf -- "$staging" "$backup"
        return 1
    fi

    version_bridge_state_names names
    for name in "${names[@]}"; do
        source="$staging/$name"
        target="$data_dir/$name"
        if [[ -e $target || -L $target ]]; then
            if ! mv -- "$target" "$backup/$name"; then
                commit_failed=1
                break
            fi
            backed_up+=("$name")
        fi
        if [[ -e $source || -L $source ]]; then
            if ! mv -- "$source" "$target"; then
                commit_failed=1
                break
            fi
            restored+=("$name")
        fi
    done
    if ((commit_failed)); then
        for ((index=${#restored[@]} - 1; index >= 0; --index)); do
            rm -rf -- "${data_dir:?}/${restored[index]}" || rollback_failed=1
        done
        for ((index=${#backed_up[@]} - 1; index >= 0; --index)); do
            mv -- "$backup/${backed_up[index]}" \
                "$data_dir/${backed_up[index]}" || rollback_failed=1
        done
        if ((rollback_failed)); then
            printf '兼容桥状态提交失败，恢复备份也未完成：%s\n' \
                "$backup" >&2
            return 1
        fi
        rm -rf -- "$staging" "$backup"
        return 1
    fi
    rm -rf -- "$staging" "$backup"
}

restore_update_snapshot() {
    local snapshot=$1 bridge_state_snapshot=${2:-}
    local relative_install='drive_c/Program Files/Netease/GameViewer'
    local staging backup current_bridge_snapshot="" failed_dir=""
    local source target relative
    local commit_failed=0 rollback_failed=0 bridge_restored=0
    local preserve_backup=0 index
    local -a paths=(
        "$relative_install"
        system.reg
        user.reg
        userdef.reg
        "drive_c/users/$current_user/AppData/Local/GameViewer/setting.ini"
        "drive_c/users/$current_user/AppData/Local/GameViewer/upgrade"
        drive_c/windows/system32/nvcuda.dll
        drive_c/windows/system32/nvcuvid.dll
        drive_c/windows/system32/nvEncodeAPI64.dll
    )
    local -a backed_up=() restored=()

    [[ -f $snapshot ]] || {
        printf '回滚快照不存在：%s\n' "$snapshot" >&2
        return 1
    }
    mkdir -p "$prefix" "$update_rollback_dir"
    staging=$(mktemp -d "$prefix/.uu-remote-restore-stage.XXXXXX") || return 1
    if ! tar -C "$staging" -xf "$snapshot"; then
        printf '更新回滚快照无法完整解压；当前安装保持不变。\n' >&2
        rm -rf -- "$staging"
        return 1
    fi
    for relative in \
        "$relative_install/GameViewer.exe" \
        "$relative_install/bin/GameViewer.exe" \
        "$relative_install/bin/GameViewerServer.exe" \
        "$relative_install/bin/GameViewerHealthd.exe" \
        "$relative_install/bin/wevtapi.dll" \
        "$relative_install/bin/Upgrade.exe"; do
        if [[ ! -f $staging/$relative ]]; then
            printf '更新回滚快照缺少必需文件：%s；当前安装保持不变。\n' \
                "$relative" >&2
            rm -rf -- "$staging"
            return 1
        fi
    done
    if [[ -n $bridge_state_snapshot ]]; then
        if [[ ! -f $bridge_state_snapshot ]] ||
            ! tar -tf "$bridge_state_snapshot" >/dev/null; then
            printf '版本绑定兼容桥快照损坏；当前安装保持不变。\n' >&2
            rm -rf -- "$staging"
            return 1
        fi
        current_bridge_snapshot=$(
            mktemp "$update_rollback_dir/.failed-bridge-state.XXXXXX"
        ) || {
            rm -rf -- "$staging"
            return 1
        }
        if ! write_version_bridge_state_snapshot \
            "$current_bridge_snapshot"; then
            printf '无法保存回滚前的兼容桥状态；当前安装保持不变。\n' >&2
            rm -rf -- "$staging"
            rm -f -- "$current_bridge_snapshot"
            return 1
        fi
    fi

    stop_prefix_for_setup
    backup=$(mktemp -d "$prefix/.uu-remote-restore-backup.XXXXXX") || {
        rm -rf -- "$staging"
        [[ -z $current_bridge_snapshot ]] ||
            rm -f -- "$current_bridge_snapshot"
        return 1
    }
    for relative in "${paths[@]}"; do
        source="$staging/$relative"
        target="$prefix/$relative"
        if [[ -e $target || -L $target ]]; then
            if ! mkdir -p -- "$(dirname -- "$backup/$relative")" ||
                ! mv -- "$target" "$backup/$relative"; then
                commit_failed=1
                break
            fi
            backed_up+=("$relative")
        fi
        if [[ -e $source || -L $source ]]; then
            if ! mkdir -p -- "$(dirname -- "$target")" ||
                ! mv -- "$source" "$target"; then
                commit_failed=1
                break
            fi
            restored+=("$relative")
        fi
    done
    if ((!commit_failed)) && [[ -n $bridge_state_snapshot ]]; then
        if restore_version_bridge_state_snapshot "$bridge_state_snapshot"; then
            bridge_restored=1
        else
            printf '无法恢复更新前的版本绑定兼容桥状态。\n' >&2
            commit_failed=1
        fi
    fi
    # Older snapshots predate update-blocker-manifest being part of the
    # version-bound bridge state.  Rebuild that small manifest from the
    # restored, archived Upgrade.exe before validating the restored client.
    if ((!commit_failed)) &&
        ! refresh_restored_update_blocker_manifest; then
        printf '恢复后的官方更新器保护清单无法重建。\n' >&2
        commit_failed=1
    fi
    if ((!commit_failed)) &&
        ! { app_files_present && shim_ready && update_blocker_ready; }; then
        printf '恢复后的旧版 UU 基础文件核验失败。\n' >&2
        commit_failed=1
    fi
    if ((!commit_failed)) && hwdecode_enabled &&
        ! hwdecode_files_deployed; then
        printf '恢复后的 NVDEC 兼容桥核验失败。\n' >&2
        commit_failed=1
    fi
    # The package can be upgraded independently of the UU client.  In that
    # case the restored probe result is intentionally stale because its
    # signature includes the current capture/input hook hash.  Re-probe the
    # restored client with the current runtime before rejecting the rollback.
    if ((!commit_failed)) && hwencode_enabled &&
        hwencode_files_deployed && ! hwencode_probe_current &&
        ! probe_hwencode_bridge; then
        printf '恢复后的 NVENC 兼容桥重新探测失败。\n' >&2
        commit_failed=1
    fi
    if ((!commit_failed)) && hwencode_enabled &&
        ! { hwencode_files_deployed && hwencode_probe_current; }; then
        printf '恢复后的 NVENC 兼容桥核验失败。\n' >&2
        commit_failed=1
    fi
    if ((!commit_failed)) && wol_enabled &&
        ! wol_runtime_bridge_ready; then
        printf '恢复后的 WOL 兼容桥核验失败。\n' >&2
        commit_failed=1
    fi

    if ((commit_failed)); then
        if ((bridge_restored)) &&
            ! restore_version_bridge_state_snapshot \
                "$current_bridge_snapshot"; then
            printf '无法恢复回滚开始前的兼容桥状态：%s\n' \
                "$current_bridge_snapshot" >&2
            rollback_failed=1
        fi
        for ((index=${#restored[@]} - 1; index >= 0; --index)); do
            rm -rf -- "${prefix:?}/${restored[index]}" || rollback_failed=1
        done
        for ((index=${#backed_up[@]} - 1; index >= 0; --index)); do
            mkdir -p -- "$(dirname -- "$prefix/${backed_up[index]}")" ||
                rollback_failed=1
            mv -- "$backup/${backed_up[index]}" \
                "$prefix/${backed_up[index]}" || rollback_failed=1
        done
        if ((rollback_failed)); then
            printf '回滚提交失败，但事务备份已保留：%s\n' "$backup" >&2
            return 1
        fi
        rm -rf -- "$staging" "$backup"
        [[ -z $current_bridge_snapshot ]] ||
            rm -f -- "$current_bridge_snapshot"
        printf '旧版恢复未能完成，已原样恢复回滚前的安装。\n' >&2
        return 1
    fi

    if [[ -e $backup/$relative_install ]]; then
        failed_dir="$prefix/.uu-remote-failed-install-$(date +%Y%m%d%H%M%S)"
        if ! mv -- "$backup/$relative_install" "$failed_dir"; then
            failed_dir="$backup/$relative_install"
            preserve_backup=1
        fi
    fi
    rm -rf -- "$staging"
    if ((!preserve_backup)); then
        rm -rf -- "$backup"
    fi
    [[ -z $current_bridge_snapshot ]] ||
        rm -f -- "$current_bridge_snapshot"
    if [[ -n $failed_dir ]]; then
        printf '失败版本已保留用于排错：%s\n' "$failed_dir" >&2
    fi
}

restart_client_after_update() {
    local launcher_path

    [[ ${UU_REMOTE_UPDATE_NO_RESTART:-0} != 1 ]] || return 0
    launcher_path=$(resolve_launcher_path) || return 1
    (
        cd "$data_dir"
        nohup env UU_REMOTE_SKIP_STARTUP_UPDATE=1 \
            "$launcher_path" --autostart \
            9>&- </dev/null >>"$update_bridge_log" 2>&1 &
    )
}

update_restart_ready() {
    local installed_version

    app_files_present &&
        shim_ready &&
        input_hook_ready &&
        update_blocker_ready || return 1
    installed_version=$(
        registry_value "$installed_version_key" Version 2>/dev/null || true
    )
    if [[ -n $installed_version ]] &&
        future_adaptive_patch_required "$installed_version"; then
        streamer_compatibility_profile_ready "$installed_version" || return 1
    fi
    if hwdecode_enabled; then
        hwdecode_files_deployed || return 1
    fi
    if hwencode_enabled; then
        hwencode_files_deployed && hwencode_probe_current || return 1
    fi
    if wol_enabled; then
        wol_runtime_bridge_ready || return 1
    fi
}

run_update_transaction() {
    local latest=$1 expected_installer_sha actual_installer_sha
    local snapshot bridge_state_snapshot installed_after
    local profile_supported=false
    local strict_adaptive_patch=false

    if future_adaptive_patch_required "$latest"; then
        strict_adaptive_patch=true
    fi

    if update_version_supported "$latest"; then
        profile_supported=true
        expected_installer_sha=$(update_profile_value "$latest" installer) ||
            die "缺少 UU $latest 的安装包兼容哈希"
    fi

    download_installer
    [[ -r $installer_version_file &&
        $(<"$installer_version_file") == "$latest" ]] ||
        die "官方安装包版本与更新检查结果不一致；现有客户端未作修改"
    actual_installer_sha=$(file_sha256 "$installer") ||
        die "无法计算已下载安装包的哈希"
    if $profile_supported &&
        [[ $actual_installer_sha != "$expected_installer_sha" ]]; then
        write_update_status paused \
            "$(registry_value "$installed_version_key" Version || printf unknown)" \
            "$latest" \
            "安装包 SHA-256 与兼容档案不匹配"
        die "UU $latest 安装包已被重新发布或下载异常；已暂缓更新且未修改客户端"
    fi

    snapshot=$(create_update_snapshot)
    bridge_state_snapshot=$(create_version_bridge_state_snapshot)
    if (
        stop_prefix_for_setup
        if wol_enabled; then
            restore_optional_wol_server_patch ||
                die "更新前无法安全恢复 WOL 服务端补丁"
        fi
        if ! $profile_supported; then
            if hwdecode_enabled || streamer_bridge_ready; then
                remove_hwdecode_bridge
                printf '正在为最新版准备自动 NVDEC 档案，已先安全恢复官方解码文件。\n'
            fi
        fi
        prepare_prefix
        install_or_update_app
        configure_compatibility

        installed_after=$(registry_value "$installed_version_key" Version || true)
        [[ $installed_after == "$latest" ]] ||
            die "更新后版本核验失败：${installed_after:-unknown}"

        ensure_streamer_compatibility_profile "$installed_after" ||
            die "更新后无法自动生成 NVENC/竖屏语义档案"

        ensure_auto_hwencode
        if $strict_adaptive_patch &&
            [[ ${UU_REMOTE_DISABLE_AUTO_HWENCODE:-0} != 1 ]] &&
            ! hwencode_disabled && hwencode_runtime_ready &&
            hwencode_host_libraries_ready && ! hwencode_enabled; then
            die "更新后 NVENC 自动补丁无法通过深层验证"
        fi

        if wol_enabled; then
            if $strict_adaptive_patch; then
                deploy_optional_wol_server_patch required
            else
                deploy_optional_wol_server_patch
            fi ||
                die "更新后 WOL 服务端兼容策略无法部署"
            write_wol_hook_config ||
                die "更新后 WOL 物理网卡映射无法生成"
            deploy_wol_powershell_bridge
            write_wol_enabled_stamp ||
                die "更新后 WOL 自适应档案状态无法刷新"
        fi
        apply_decoder_selection
        if $strict_adaptive_patch && decoder_selection_wants_nvdec &&
            { ! hwdecode_enabled || ! hwdecode_files_deployed; }; then
            die "更新后 NVDEC 自动补丁无法通过官方解码探测"
        fi
        ensure_streamer_compatibility_profile "$installed_after" ||
            die "更新后最终 streamer.dll 无法通过 NVENC/竖屏档案复核"

        shim_ready || die "更新后 Event Log 兼容 DLL 核验失败"
        update_blocker_ready ||
            die "更新后官方更新器保护未恢复"
        if hwdecode_enabled; then
            hwdecode_files_deployed ||
                die "更新后解码兼容 DLL 或 streamer 补丁核验失败"
        fi
        if hwencode_enabled; then
            hwencode_files_deployed && hwencode_probe_current ||
                die "更新后 NVENC/HEVC 编码桥深层核验失败"
        fi
        if wol_enabled; then
            wol_runtime_bridge_ready ||
                die "更新后 WOL 通用兼容桥核验失败"
        fi
    ); then
        rm -f -- "$snapshot" "$bridge_state_snapshot"
        if $profile_supported; then
            write_update_status updated "$latest" "$latest" \
                "客户端与版本绑定兼容桥均已更新并校验"
            notify_status "UU 已更新到 $latest，兼容桥校验通过"
            printf 'UU 已更新到 %s，所有已启用兼容桥均已重新部署并校验。\n' \
                "$latest"
        elif hwdecode_enabled; then
            write_update_status updated "$latest" "$latest" \
                "已安装官方最新版；NVDEC 补丁已自动生成并通过真实解码验证；已启用的 WOL 自适应兼容层已重新生成并部署"
            notify_status "UU 已更新到 $latest，NVDEC 自动补丁验证通过"
            printf 'UU 已更新到官方最新版 %s；NVDEC 补丁已自动验证；已启用的 WOL 自适应兼容层已重新生成并部署。\n' \
                "$latest"
        else
            write_update_status updated "$latest" "$latest" \
                "已安装官方最新版；已启用的 WOL 自适应兼容层已重新生成并部署，版本绑定的 NVDEC 补丁已安全停用"
            notify_status "UU 已更新到 $latest，通用兼容层已重新部署"
            printf 'UU 已更新到官方最新版 %s；已启用的 WOL 自适应兼容层已重新生成并部署，版本绑定的 NVDEC 补丁暂时停用。\n' \
                "$latest"
        fi
        restart_client_after_update || true
        return 0
    fi

    printf '更新事务失败，正在恢复更新前文件……\n' >&2
    if restore_update_snapshot "$snapshot" "$bridge_state_snapshot"; then
        rm -f -- "$bridge_state_snapshot"
        write_update_status rolled-back \
            "$(registry_value "$installed_version_key" Version || printf unknown)" \
            "$latest" \
            "更新后兼容性核验失败，已恢复旧版"
        notify_status "UU 更新未通过兼容性核验，已自动回滚"
        restart_client_after_update || true
        return 1
    fi

    write_update_status error unknown "$latest" \
        "更新失败且自动回滚未完成，请保留现场并运行 --diagnose"
    die "更新失败且回滚未完成；请勿启动远控并查看 $update_bridge_log"
}

automatic_update_retry_blocked() {
    local installed=$1 latest=$2
    local status="" recorded_installed="" recorded_latest=""
    local recorded_package="" key value

    [[ -r $update_status_file ]] || return 1
    while IFS='=' read -r key value; do
        case $key in
            status) status=$value ;;
            installed) recorded_installed=$value ;;
            latest) recorded_latest=$value ;;
            package_version) recorded_package=$value ;;
        esac
    done <"$update_status_file"
    [[ $status == rolled-back &&
        $recorded_installed == "$installed" &&
        $recorded_latest == "$latest" &&
        $recorded_package == "$package_version" ]]
}

perform_update_check() {
    local mode=${1:-manual} installed latest="" check_error=""

    app_files_present ||
        die "UU 客户端尚未安装，无法检查更新"
    installed=$(registry_value "$installed_version_key" Version || true)
    [[ -n $installed ]] || die "无法读取当前 UU 版本"

    notify_status "正在检查 UU 官方更新"
    if ! official_latest_version latest check_error; then
        check_error=${check_error:-官方版本检查失败，未返回具体原因}
        write_update_status error "$installed" unknown "$check_error"
        die "检查网易官方版本失败：$check_error；现有客户端未作修改"
    fi
    if ! version_greater "$latest" "$installed"; then
        write_update_status up-to-date "$installed" "$latest" "无需更新"
        printf 'UU 当前版本 %s，官方版本 %s；无需更新。\n' \
            "$installed" "$latest"
        return
    fi
    if [[ $mode == automatic ]] &&
        automatic_update_retry_blocked "$installed" "$latest"; then
        notify_status "已暂缓再次安装未通过兼容性核验的 UU $latest"
        printf 'UU %s 上次未通过兼容性核验；自动更新已暂缓，保留 %s。\n' \
            "$latest" "$installed"
        return
    fi

    run_update_transaction "$latest"
}

perform_upstream_update_handoff() {
    local check_status=0 restart_status=0
    local exit_grace=${UU_REMOTE_UPSTREAM_UPDATE_EXIT_GRACE:-8}

    notify_status "已接管 UU 内置更新，正在安全检查并恢复主程序"
    printf '已接管 UU 内置更新请求；正在等待旧主程序退出。\n'
    if ! "$tray_proxy" \
        --quiesce-controller \
        --prefix "$prefix" \
        --grace-seconds "$exit_grace"; then
        printf '警告：旧主控未能完整退出；继续执行只读版本检查。\n' >&2
    fi

    # The handoff owns the single restart decision.  Supported update and
    # rollback paths must not launch a competing client from the subshell.
    if (
        UU_REMOTE_UPDATE_NO_RESTART=1 perform_update_check
    ); then
        check_status=0
    else
        check_status=$?
    fi

    if update_restart_ready; then
        restart_client_after_update || restart_status=$?
        if ((restart_status == 0)); then
            notify_status "UU 更新检查完成，正在启动最新可用版本"
            printf '更新检查完成；已请求启动最新可用版本。\n'
        else
            notify_status "UU 更新检查完成，但主程序恢复启动失败"
            printf '错误：无法重新启动最新可用版本。\n' >&2
        fi
    else
        restart_status=1
        notify_status "UU 更新或回滚未通过完整性校验，已阻止启动"
        printf '错误：客户端兼容文件未通过完整性校验，已阻止不安全启动。\n' >&2
    fi

    ((restart_status == 0)) || return "$restart_status"
    return "$check_status"
}

if $recover_update_snapshot; then
    recovery_snapshot="$update_rollback_dir/pre-update.tar"
    recovery_bridge_snapshot="$update_rollback_dir/pre-update-bridge-state.tar"
    restore_update_snapshot \
        "$recovery_snapshot" "$recovery_bridge_snapshot" ||
        die "最近一次更新回滚点无法安全恢复"
    recovery_failed_version=unknown
    if [[ -r $installer_version_file ]]; then
        recovery_failed_version=$(<"$installer_version_file")
    fi
    write_update_status rolled-back \
        "$(registry_value "$installed_version_key" Version || printf unknown)" \
        "$recovery_failed_version" \
        "已从最近一次完整回滚点恢复"
    notify_status "UU 已从最近一次完整回滚点恢复"
    printf 'UU 已从最近一次完整回滚点恢复；继续核验并部署当前兼容桥。\n'
fi

if $update_check_requested; then
    if $upstream_update_handoff; then
        perform_upstream_update_handoff
    elif $automatic_update_check; then
        perform_update_check automatic
    else
        perform_update_check
    fi
    exit
fi

startup_update_requested=false
if [[ ${UU_REMOTE_SKIP_STARTUP_UPDATE:-0} != 1 ]] &&
    app_files_present &&
    ! $setup_only && ! $repair && ! $refresh_installer &&
    ! $stop_requested && ! $diagnose_requested &&
    ! $enable_hwdecode && ! $disable_hwdecode &&
    ! $enable_hwencode && ! $disable_hwencode &&
    ! $enable_wol && ! $disable_wol &&
    ! $select_decoder_requested && ! $select_decoder_restart_requested &&
    ! $restart_selected_decoder && ! $list_decoders_requested &&
    [[ -z $decoder_direct_choice ]]; then
    startup_update_requested=true
fi
if $startup_update_requested; then
    if ! (
        UU_REMOTE_UPDATE_NO_RESTART=1 perform_update_check automatic
    ); then
        notify_status "启动时自动更新未完成，将继续打开当前版本"
        printf '警告：启动时自动更新未完成；继续打开当前已安装版本。\n' >&2
    fi
fi

if $enable_hwdecode; then
    stop_prefix_for_setup
    export UU_REMOTE_CUDA_DEVICE=0
    deploy_hwdecode_bridge
    write_decoder_selection "nvidia:0"
    notify_status "NVIDIA 硬件解码桥已启用"
    printf 'NVIDIA NVDEC→D3D11 硬件解码桥已启用。\n'
    printf '解码设备已保存为 NVIDIA CUDA 设备 0。\n'
    printf '这是 CPU 回拷兼容模式；可随时运行 --disable-hwdecode 回退。\n'
    exit 0
fi

if $disable_hwdecode; then
    stop_prefix_for_setup
    remove_hwdecode_bridge
    write_decoder_selection "cpu"
    notify_status "硬件解码桥已关闭"
    printf '硬件解码桥已关闭，项目管理的注入 DLL 已移除。\n'
    printf '解码设备已切换到 UU CPU 解码路径。\n'
    exit 0
fi

if $enable_hwencode; then
    stop_prefix_for_setup
    deploy_hwencode_bridge ||
        die "NVENC/HEVC 编码桥未通过 D3D11→CUDA 纹理上传验证；已保留 OpenH264"
    notify_status "NVIDIA NVENC/HEVC 编码桥已启用"
    printf 'NVIDIA NVENC/HEVC 被控端编码桥已启用并通过真实纹理上传验证。\n'
    exit 0
fi

if $disable_hwencode; then
    stop_prefix_for_setup
    remove_hwencode_bridge
    printf '%s\n' "$package_version" >"${hwencode_disabled_stamp}.tmp"
    mv -f "${hwencode_disabled_stamp}.tmp" "$hwencode_disabled_stamp"
    rm -f -- "$hwencode_failed_stamp"
    notify_status "自动 NVENC 编码已关闭"
    printf '自动 NVENC 编码已关闭，OpenH264 安全回退能力已恢复。\n'
    exit 0
fi

if $enable_wol; then
    app_files_present ||
        die "UU 远程客户端尚未完整安装，请先运行：uu-remote-for-linux --setup-only"
    stop_prefix_for_setup
    deploy_wol_bridge
    notify_status "远程开机兼容桥已启用"
    printf 'Linux Magic Packet 与 UU WOL 自适应兼容层已启用。\n'
    printf '请重新启动 UU，在“允许通过远程开机启动”中继续配置辅助设备或路由器。\n'
    exit 0
fi

if $disable_wol; then
    stop_prefix_for_setup
    remove_wol_bridge
    notify_status "远程开机兼容桥已关闭"
    printf 'UU WOL 自适应兼容层已关闭；服务端补丁已安全恢复。\n'
    printf 'Linux 网卡的 Magic Packet 设置予以保留，不会影响正常联网。\n'
    exit 0
fi

if $select_decoder_restart_requested; then
    [[ -x $decoder_selector ]] ||
        die "缺少解码设备选择器：$decoder_selector"
    if ! selected_decoder=$(
        UU_REMOTE_DECODER_RESTART_AFTER_SAVE=1 \
            "$decoder_selector" --select "$decoder_selection_file"
    ); then
        die "解码设备选择失败；UU 保持原运行状态"
    fi
    if [[ -z $selected_decoder ]]; then
        printf '已取消解码设备选择；UU 保持运行。\n'
        exit 0
    fi
    printf '已保存解码设备：%s；正在重新启动 UU。\n' "$selected_decoder"
    notify_status "解码设备已切换，正在重新启动 UU"
    stop_prefix_for_setup
    if systemd_user_available; then
        release_operation_lock
        start_systemd_decoder_restart ||
            die "无法创建独立的 UU 重启服务；请运行 uu-remote-for-linux 重试"
        exit 0
    fi
fi

if $repair || $refresh_installer || prefix_needs_configuration; then
    stop_prefix_for_setup
    prepare_prefix
    install_or_update_app
    configure_compatibility
    notify_status "UU 远程 Linux 兼容环境设置完成"
    printf 'UU 远程 Linux 兼容环境设置完成。\n'
fi

if app_files_present && ! input_hook_ready; then
    stop_prefix_for_setup
    deploy_input_hook
fi

if wol_enabled; then
    deploy_optional_wol_server_patch ||
        die "远程开机兼容桥已启用，但 UU 服务端补丁无法安全部署"
    write_wol_hook_config ||
        die "远程开机兼容桥已启用，但无法映射 Linux 物理网卡"
    deploy_wol_powershell_bridge
    write_wol_enabled_stamp ||
        die "远程开机兼容桥已启用，但自适应档案状态无法刷新"
    wol_runtime_bridge_ready ||
        die "远程开机兼容桥已启用，但运行时映射核验失败"
fi

ensure_auto_hwencode

apply_decoder_selection

installed_profile_version=$(
    registry_value "$installed_version_key" Version 2>/dev/null || true
)
if [[ -n $installed_profile_version ]] &&
    ! ensure_streamer_compatibility_profile "$installed_profile_version"; then
    if future_adaptive_patch_required "$installed_profile_version"; then
        die "当前 UU 版本无法自动生成 NVENC/竖屏补丁档案；已阻止不兼容版本启动"
    fi
    printf '警告：当前旧版 UU 无法生成 NVENC/竖屏语义档案；继续使用安全回退。\n' >&2
fi

if ! sync_linux_system_proxy; then
    printf '警告：Linux 系统代理未能同步到 Wine，详见 %s\n' \
        "$system_proxy_bridge_log" >&2
fi

if ! sync_autostart_once; then
    printf '警告：UU 自启动设置未能同步到 Linux，详见 %s\n' \
        "$autostart_log" >&2
fi

$setup_only && exit 0

if hwdecode_enabled; then
    hwdecode_runtime_ready ||
        die "硬件解码桥已启用，但运行库不完整；请重新安装本项目"
    hwdecode_host_libraries_ready ||
        die "硬件解码桥已启用，但 NVIDIA CUDA/NVDEC 主机库不可用"
    hwdecode_files_deployed ||
        die "硬件解码桥注入文件缺失或版本不匹配；请运行：uu-remote-for-linux --enable-hwdecode"
    configure_hwdecode_environment
fi
if hwencode_enabled; then
    hwencode_runtime_ready ||
        die "NVENC 编码桥已启用，但运行库不完整；请重新安装本项目"
    hwencode_host_libraries_ready ||
        die "NVENC 编码桥已启用，但 NVIDIA CUDA/NVENC 主机库不可用"
    hwencode_files_deployed ||
        die "NVENC 编码桥注入文件缺失或版本不匹配；请运行：uu-remote-for-linux --enable-hwencode"
    hwencode_probe_current ||
        die "NVENC 编码桥未通过当前 UU 版本的深层探测"
    configure_hwencode_environment
fi

app_files_present ||
    die "客户端文件不完整，请运行：uu-remote-for-linux --repair"

service_running() {
    local output line

    output=$(env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
        -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
        -u ALL_PROXY -u NO_PROXY \
        "$wine" sc query "$service_name" 9>&- 2>/dev/null) || return 1
    while IFS= read -r line; do
        line=${line%$'\r'}
        if [[ $line =~ ^[[:space:]]*STATE[[:space:]]*:[[:space:]]*4[[:space:]]+RUNNING[[:space:]]*$ ]]; then
            return 0
        fi
    done <<<"$output"
    return 1
}

ensure_service_running() {
    local attempt

    run_logged env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
        -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
        -u ALL_PROXY -u NO_PROXY \
        "$wine" sc start "$service_name" || true
    for ((attempt = 0; attempt < 150; attempt++)); do
        service_running && return
        sleep 0.2
    done
    return 1
}

wine_image_running() {
    local executable=$1 image output

    image=${executable##*/}
    output=$(env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
        -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
        -u ALL_PROXY -u NO_PROXY \
        "$wine" tasklist /NH /FO CSV \
            /FI "IMAGENAME eq $image" 9>&- 2>/dev/null) ||
        return 1
    [[ $output == *"$image"* ]]
}

start_systemd_wine_image() {
    local unit=$1 executable=$2
    local wine_path variable
    local -a command

    shift 2
    wine_path=$(command -v -- "$wine") || return 1
    systemctl --user stop "$unit.service" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$unit.service" >/dev/null 2>&1 || true

    command=(
        systemd-run
        --user
        "--unit=$unit"
        --collect
        --quiet
        --property=Restart=on-failure
        --property=RestartSec=2s
        --property=TimeoutStopSec=15s
        "--property=StandardOutput=append:$runtime_log"
        "--property=StandardError=append:$runtime_log"
        "--working-directory=$install_dir/bin"
        "--setenv=WINEPREFIX=$WINEPREFIX"
        "--setenv=WINEDEBUG=$WINEDEBUG"
    )
    for variable in \
        WINEDLLOVERRIDES WINEDLLPATH DXVK_LOG_LEVEL DXVK_CONFIG_FILE \
        UU_REMOTE_CUDA_DEVICE UU_REMOTE_NVENC_ADAPTER_LUID \
        DISPLAY WAYLAND_DISPLAY XAUTHORITY; do
        if [[ -v $variable ]]; then
            command+=("--setenv=$variable=${!variable}")
        fi
    done
    command+=(
        env
        -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy -u no_proxy
        -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY -u ALL_PROXY -u NO_PROXY
        "$wine_path" "$executable" "$@"
    )
    "${command[@]}" 9>&-
}

ensure_wine_image_running() {
    local unit=$1 executable=$2
    local attempt
    local launched=false

    shift 2
    if ! wine_image_running "$executable"; then
        if systemd_user_available; then
            if runtime_unit_active "$unit"; then
                launched=true
            elif start_systemd_wine_image \
                "$unit" "$executable" "$@"; then
                launched=true
            fi
        fi
        if ! $launched; then
            (
                cd "$install_dir/bin"
                nohup env \
                    -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
                    -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
                    -u ALL_PROXY -u NO_PROXY \
                    "$wine" "$executable" "$@" 9>&- </dev/null \
                    >>"$runtime_log" 2>&1 &
            )
        fi
    fi
    for ((attempt = 0; attempt < 60; attempt++)); do
        wine_image_running "$executable" && return
        sleep 0.2
    done
    return 1
}

start_input_injector() {
    [[ ${UU_REMOTE_DISABLE_INPUT_BRIDGE:-0} != 1 ]] || return 0
    [[ $desktop_backend == x11 || $desktop_backend == wayland-xwayland ]] || return 0
    [[ -n ${DISPLAY:-} ]] || return 0
    input_hook_ready || return 1
    ensure_wine_image_running \
        "$input_injector_runtime_unit" \
        "$input_injector" \
        --watch \
        GameViewerServer.exe \
        "$input_hook_windows"
}

start_focus_injector() {
    local wine_path

    [[ ${UU_REMOTE_DISABLE_FOCUS_STABILIZER:-0} != 1 ]] || return 0
    [[ $desktop_backend == x11 || $desktop_backend == wayland-xwayland ]] || return 0
    [[ -n ${DISPLAY:-} ]] || return 0
    input_hook_ready || return 1
    if systemd_user_available; then
        if runtime_unit_active "$focus_injector_runtime_unit"; then
            return 0
        fi
        rm -f -- "$controller_focus_hook_status" \
            "$controller_restart_request"
        start_systemd_wine_image \
            "$focus_injector_runtime_unit" \
            "$input_injector" \
            --watch-module \
            GameViewer.exe \
            Qt5Core.dll \
            "$input_hook_windows"
        return
    fi
    wine_path=$(command -v -- "$wine") || return 1
    rm -f -- "$controller_focus_hook_status" \
        "$controller_restart_request"
    (
        cd "$install_dir/bin"
        nohup env \
            -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
            -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
            -u ALL_PROXY -u NO_PROXY \
            "$wine_path" "$input_injector" \
            --watch-module GameViewer.exe Qt5Core.dll \
            "$input_hook_windows" 9>&- </dev/null \
            >>"$runtime_log" 2>&1 &
    )
}

wait_input_hook_active() {
    local attempt state

    [[ ${UU_REMOTE_DISABLE_INPUT_BRIDGE:-0} != 1 ]] || return 0
    [[ $desktop_backend == x11 || $desktop_backend == wayland-xwayland ]] || return 0
    [[ -n ${DISPLAY:-} ]] || return 0
    for ((attempt = 0; attempt < 60; attempt++)); do
        state=$("$input_bridge" status "$state_dir" 2>/dev/null || true)
        [[ $state == active ]] && return 0
        sleep 0.1
    done
    return 1
}

if ! start_input_bridge; then
    printf '警告：被控端原生键鼠输入不可用，详见 %s\n' \
        "$input_bridge_log" >&2
fi
ensure_service_running ||
    die "$service_name 未进入 RUNNING 状态，详见 $setup_log"
ensure_wine_image_running "$healthd_runtime_unit" "$healthd" ||
    die "GameViewerHealthd.exe 未能启动"
ensure_wine_image_running "$server_runtime_unit" "$server" ||
    die "GameViewerServer.exe 未能启动"
if ! finalize_hwencode_policy; then
    printf '当前被控会话将使用 UU 的安全软件编码回退。\n' >&2
elif ! start_hwencode_policy_watcher; then
    printf '警告：NVENC 档案监视器未启动，UU 重新探测后可能恢复软件编码。\n' >&2
fi
wait_input_hook_active ||
    printf '警告：GameViewerServer 输入钩子尚未确认连接，详见 %s\n' \
        "$input_bridge_log" >&2
start_input_injector ||
    printf '警告：Win64 输入钩子注入监视器未能启动，详见 %s\n' \
        "$runtime_log" >&2
start_focus_injector ||
    printf '警告：主控焦点稳定器未能启动，切换画质时可能闪烁。\n' >&2

sleep 1
cd "$install_dir"
release_operation_lock
start_autostart_bridge
start_sleep_bridge
start_update_bridge
start_keyboard_bridge ||
    printf '警告：Linux 快捷键可能仍会拦截远控 Win 组合键。\n' >&2
start_tray_proxy ||
    die "Linux 原生托盘代理启动失败，详见 $tray_proxy_log"
if $show_requested; then
    authorize_controller_home_show ||
        die "无法授权 UU 自身恢复主界面"
fi
if $uri_requested; then
    exec env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
        -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
        -u ALL_PROXY -u NO_PROXY \
        "$wine" start "$uri"
fi
if $restart_selected_decoder; then
    exec env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
        -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
        -u ALL_PROXY -u NO_PROXY \
        "$wine" "$client"
fi
if $select_decoder_restart_requested; then
    nohup env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
        -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
        -u ALL_PROXY -u NO_PROXY \
        "$wine" "$client" "${client_args[@]}" 9>&- </dev/null \
        >>"$runtime_log" 2>&1 &
    exit 0
fi
if systemd_user_available; then
    start_systemd_client_launch "${client_args[@]}" ||
        die "无法创建持久的 UU 主界面服务，详见 $runtime_log"
    exit 0
fi
exec env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
    -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
    -u ALL_PROXY -u NO_PROXY \
    "$wine" "$client" "${client_args[@]}"
