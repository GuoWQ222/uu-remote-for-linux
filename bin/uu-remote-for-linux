        --restart-selected-decoder)
            restart_selected_decoder=true
            ;;
        --list-decoders)
            list_decoders_requested=true
            ;;
        --decoder)
            shift
            (($# > 0)) || die "--decoder 缺少设备 ID"
            decoder_direct_choice=$1
            ;;
        --autostart)
            autostart_launch=true
            ;;
        --show)
            show_requested=true
            ;;
        --uri)
            shift
            (($# > 0)) || die "--uri 缺少参数"
            [[ $1 == uuremote:* ]] || die "--uri 只接受 uuremote: URI"
            uri_requested=true
            uri=$1
            ;;
        --version)
            if [[ -r $package_version_file ]]; then
                printf '%s\n' "$(<"$package_version_file")"
            else
                printf 'development\n'
            fi
            exit 0
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            client_args+=("$@")
            break
            ;;
        uuremote:*)
            uri_requested=true
            uri=$1
            ;;
        *)
            client_args+=("$1")
            ;;
    esac
    shift
done

if $enable_hwdecode && $disable_hwdecode; then
    die "--enable-hwdecode 和 --disable-hwdecode 不能同时使用"
fi
if $enable_hwencode && $disable_hwencode; then
    die "--enable-hwencode 和 --disable-hwencode 不能同时使用"
fi
if $enable_wol && $disable_wol; then
    die "--enable-wol 和 --disable-wol 不能同时使用"
fi

if $autostart_launch && {
    $setup_only || $repair || $refresh_installer || $update_check_requested ||
        $stop_requested ||
        $diagnose_requested || $mutter_fix_status_requested ||
        $install_mutter_fix || $rollback_mutter_fix ||
        $enable_hwdecode || $disable_hwdecode ||
        $enable_hwencode || $disable_hwencode ||
        $enable_wol || $disable_wol ||
        $select_decoder_requested || $select_decoder_restart_requested ||
        $restart_selected_decoder ||
        $list_decoders_requested ||
        $accept_eula || [[ -n $decoder_direct_choice ]] ||
        $show_requested || $uri_requested || ((${#client_args[@]} > 0));
}; then
    die "--autostart 不能和其他选项或客户端参数组合"
fi

if $restart_selected_decoder && {
    $setup_only || $repair || $refresh_installer || $update_check_requested ||
        $stop_requested || $diagnose_requested ||
        $mutter_fix_status_requested || $install_mutter_fix ||
        $rollback_mutter_fix ||
        $enable_hwdecode || $disable_hwdecode ||
        $enable_hwencode || $disable_hwencode ||
        $enable_wol || $disable_wol ||
        $select_decoder_requested || $select_decoder_restart_requested ||
        $list_decoders_requested || $accept_eula ||
        [[ -n $decoder_direct_choice ]] ||
        $autostart_launch || $show_requested || $uri_requested ||
        ((${#client_args[@]} > 0));
}; then
    die "内部解码器重启入口不能和其他选项或客户端参数组合"
fi

if $stop_requested || $diagnose_requested || $update_check_requested ||
    $mutter_fix_status_requested || $install_mutter_fix ||
    $rollback_mutter_fix ||
    $enable_hwdecode || $disable_hwdecode ||
    $enable_hwencode || $disable_hwencode ||
    $enable_wol || $disable_wol ||
    $select_decoder_requested || $select_decoder_restart_requested ||
    $list_decoders_requested ||
    [[ -n $decoder_direct_choice ]]; then
    if $setup_only || $repair || $refresh_installer || $accept_eula ||
        $show_requested || $uri_requested || ((${#client_args[@]} > 0)); then
        die "维护选项不能和设置、启动或 URI 选项组合"
    fi
fi

if $show_requested && {
    $setup_only || $repair || $refresh_installer || $accept_eula ||
        $uri_requested || ((${#client_args[@]} > 0));
}; then
    die "--show 不能和设置、维护、URI 或客户端参数组合"
fi

maintenance_action_count=0
$stop_requested && maintenance_action_count=$((maintenance_action_count + 1))
$diagnose_requested && maintenance_action_count=$((maintenance_action_count + 1))
$update_check_requested &&
    maintenance_action_count=$((maintenance_action_count + 1))
$mutter_fix_status_requested &&
    maintenance_action_count=$((maintenance_action_count + 1))
$install_mutter_fix &&
    maintenance_action_count=$((maintenance_action_count + 1))
$rollback_mutter_fix &&
    maintenance_action_count=$((maintenance_action_count + 1))
$enable_hwdecode && maintenance_action_count=$((maintenance_action_count + 1))
$disable_hwdecode && maintenance_action_count=$((maintenance_action_count + 1))
$enable_hwencode && maintenance_action_count=$((maintenance_action_count + 1))
$disable_hwencode && maintenance_action_count=$((maintenance_action_count + 1))
$enable_wol && maintenance_action_count=$((maintenance_action_count + 1))
$disable_wol && maintenance_action_count=$((maintenance_action_count + 1))
if ((maintenance_action_count > 1)); then
    die "--stop、--diagnose、更新检查、Mutter、硬件解码和远程开机维护选项不能组合"
fi

maintenance_selection_count=0
$select_decoder_requested && maintenance_selection_count=$((maintenance_selection_count + 1))
$select_decoder_restart_requested &&
    maintenance_selection_count=$((maintenance_selection_count + 1))
$list_decoders_requested && maintenance_selection_count=$((maintenance_selection_count + 1))
[[ -n $decoder_direct_choice ]] &&
    maintenance_selection_count=$((maintenance_selection_count + 1))
if ((maintenance_selection_count > 1)); then
    die "解码设备选择、列表和直接指定选项不能组合"
fi
if ((maintenance_selection_count > 0)) &&
    { $stop_requested || $diagnose_requested || $enable_hwdecode ||
        $disable_hwdecode || $enable_hwencode || $disable_hwencode ||
        $enable_wol || $disable_wol ||
        $mutter_fix_status_requested || $install_mutter_fix ||
        $rollback_mutter_fix ||
        $update_check_requested; }; then
    die "解码设备选择选项不能和其他维护选项组合"
fi

package_version="development"
if [[ -r $package_version_file ]]; then
    package_version=$(<"$package_version_file")
fi
readonly package_version

if $mutter_fix_status_requested || $install_mutter_fix ||
    $rollback_mutter_fix; then
    [[ -x $mutter_fix_manager ]] ||
        die "Mutter 修复管理器只随系统级 UU Remote .deb 提供：$mutter_fix_manager"
    if $mutter_fix_status_requested; then
        exec "$mutter_fix_manager" status
    elif $install_mutter_fix; then
        exec "$mutter_fix_manager" install
    else
        exec "$mutter_fix_manager" rollback
    fi
fi

if $list_decoders_requested; then
    [[ -x $decoder_selector ]] ||
        die "缺少解码设备选择器：$decoder_selector"
    decoder_table=$({
        printf 'ID\t设备\t类型\t接入后端\t编码能力\t最高画质\t最高帧率\t最高解码率\t状态\t可选择\n'
        "$decoder_selector" --list
    })
    if command -v column >/dev/null 2>&1; then
        printf '%s\n' "$decoder_table" | column -t -s $'\t'
    else
        printf '%s\n' "$decoder_table"
    fi
    exit 0
fi

if $select_decoder_requested; then
    [[ -x $decoder_selector ]] ||
        die "缺少解码设备选择器：$decoder_selector"
    "$decoder_selector" --select "$decoder_selection_file"
    exit
fi

if [[ -n $decoder_direct_choice ]]; then
    [[ -x $decoder_selector ]] ||
        die "缺少解码设备选择器：$decoder_selector"
    "$decoder_selector" --set "$decoder_selection_file" "$decoder_direct_choice"
    printf '已保存解码设备：%s；重新启动 UU 后生效。\n' "$decoder_direct_choice"
    exit 0
fi

version_at_least() {
    local actual=$1
    local required=$2

    if command -v dpkg >/dev/null 2>&1; then
        dpkg --compare-versions "$actual" ge "$required"
        return
    fi

    [[ $(printf '%s\n%s\n' "$required" "$actual" | sort -V | tail -n 1) == "$actual" ]]
}

version_greater() {
    local candidate=$1 installed=$2

    version_at_least "$candidate" "$installed" &&
        [[ $candidate != "$installed" ]]
}

official_update_request_error() {
    local curl_status=$1 source_host=$2 curl_detail=$3
    local http_status=""

    if [[ $curl_detail =~ returned[[:space:]]+error:[[:space:]]+([0-9]{3}) ]]; then
        http_status=${BASH_REMATCH[1]}
    fi

    case $curl_detail in
        *"Could not resolve proxy"*)
            printf '代理解析失败：无法解析当前代理服务器（curl 错误 %s）' \
                "$curl_status"
            return
            ;;
        *"Could not resolve host"*)
            printf 'DNS 解析失败：无法解析网易官方域名 %s（curl 错误 %s）' \
                "$source_host" "$curl_status"
            return
            ;;
        *"Resolving timed out"*)
            printf 'DNS 解析超时：未能解析网易官方域名 %s（curl 错误 %s）' \
                "$source_host" "$curl_status"
            return
            ;;
    esac

    case $curl_status in
        3)
            printf '网易官方接口地址格式无效（curl 错误 3）'
            ;;
        5)
            printf '代理解析失败：无法解析当前代理服务器（curl 错误 5）'
            ;;
        6)
            printf 'DNS 解析失败：无法解析网易官方域名 %s（curl 错误 6）' \
                "$source_host"
            ;;
        7)
            printf '连接失败：无法连接网易官方接口 %s（curl 错误 7）' \
                "$source_host"
            ;;
        22)
            if [[ -n $http_status ]]; then
                printf '网易官方接口返回 HTTP %s（curl 错误 22）' "$http_status"
            else
                printf '网易官方接口返回 HTTP 错误（curl 错误 22）'
            fi
            ;;
        28)
            printf '连接网易官方接口超时（curl 错误 28）'
            ;;
        35)
            printf '与网易官方接口进行 TLS 握手失败（curl 错误 35）'
            ;;
        47)
            printf '网易官方接口重定向次数过多（curl 错误 47）'
            ;;
        52)
            printf '网易官方接口返回空响应（curl 错误 52）'
            ;;
        56)
            printf '接收网易官方接口响应失败或连接被重置（curl 错误 56）'
            ;;
        60)
            printf 'TLS 证书校验失败：系统不信任网易官方接口返回的证书链（curl 错误 60）'
            ;;
        77)
            printf 'TLS CA 证书配置不可用（curl 错误 77）'
            ;;
        *)
            printf '请求网易官方接口失败（curl 错误 %s）' "$curl_status"
            ;;
    esac
}

official_latest_version() {
    local version_variable=$1 error_variable=$2
    local source_url="${UU_REMOTE_OFFICIAL_INSTALLER_URL:-$official_installer_url_default}"
    local source_host effective_url clean_url filename
    local curl_error_file curl_detail="" curl_status=0

    printf -v "$version_variable" '%s' ""
    printf -v "$error_variable" '%s' ""
    source_host=${source_url#*://}
    source_host=${source_host%%/*}
    source_host=${source_host%%:*}

    curl_error_file=$(mktemp "$state_dir/.official-version-curl.XXXXXX") || {
        printf -v "$error_variable" '%s' \
            '无法创建官方版本检查的临时错误文件'
        return 1
    }
    if effective_url=$(network_curl --silent --show-error --fail --head --location \
        --retry 2 --connect-timeout 15 --max-time 45 \
        --output /dev/null --write-out '%{url_effective}' "$source_url" \
        2>"$curl_error_file" 9>&-); then
        curl_status=0
    else
        curl_status=$?
    fi
    curl_detail=$(<"$curl_error_file")
    rm -f -- "$curl_error_file"

    if ((curl_status != 0)); then
        printf -v "$error_variable" '%s' \
            "$(official_update_request_error \
                "$curl_status" "$source_host" "$curl_detail")"
        return 1
    fi
    if [[ -z $effective_url ]]; then
        printf -v "$error_variable" '%s' \
            '网易官方接口已响应，但没有返回最终下载地址'
        return 1
    fi

    clean_url=${effective_url%%\?*}
    filename=${clean_url##*/}
    if [[ $filename =~ UURemote_Setup_([0-9]+([.][0-9]+){2,3})_ ]]; then
        printf -v "$version_variable" '%s' "${BASH_REMATCH[1]}"
        return
    fi
    filename=${filename//$'\n'/ }
    filename=${filename//$'\r'/ }
    printf -v "$error_variable" \
        '网易官方接口已响应，但下载文件名无法识别版本（文件名：%.160s）' \
        "${filename:-空}"
    return 1
}

update_profile_value() {
    local version=$1 field=$2
    local row_version installer_sha streamer_sha wol_sha

    [[ -r $update_compatibility_profiles ]] || return 1
    while IFS=$'\t' read -r \
        row_version installer_sha streamer_sha wol_sha; do
        [[ -n $row_version && $row_version != \#* ]] || continue
        [[ $row_version == "$version" ]] || continue
        case $field in
            installer)
                printf '%s\n' "$installer_sha"
                ;;
            streamer)
                printf '%s\n' "$streamer_sha"
                ;;
            wol)
                printf '%s\n' "$wol_sha"
                ;;
            *)
                return 2
                ;;
        esac
        return
    done <"$update_compatibility_profiles"
    return 1
}

update_version_supported() {
    local version=$1 installer_sha streamer_sha wol_sha

    installer_sha=$(update_profile_value "$version" installer) || return 1
    streamer_sha=$(update_profile_value "$version" streamer) || return 1
    wol_sha=$(update_profile_value "$version" wol) || return 1
    [[ $installer_sha =~ ^[[:xdigit:]]{64}$ &&
        $streamer_sha =~ ^[[:xdigit:]]{64}$ &&
        $wol_sha =~ ^[[:xdigit:]]{64}$ ]]
}

load_hwdecode_profile() {
    local version=${1:-} row_version original_sha patched_sha
    local offset_1 before_1 after_1 offset_2 before_2 after_2
    local override_version="${UU_REMOTE_HWDECODE_STREAMER_VERSION:-4.34.0.8979}"
    local profile_file
    local found=false

    if [[ -z $version ]]; then
        version=$(registry_value "$installed_version_key" Version || true)
    fi
    [[ -n $version ]] || return 1
    if [[ $streamer_profile_version == "$version" ]]; then
        return 0
    fi

    if [[ $version == "$override_version" &&
        -n ${UU_REMOTE_HWDECODE_STREAMER_ORIGINAL_SHA:-} &&
        -n ${UU_REMOTE_HWDECODE_STREAMER_PATCHED_SHA:-} ]]; then
        original_sha=$UU_REMOTE_HWDECODE_STREAMER_ORIGINAL_SHA
        patched_sha=$UU_REMOTE_HWDECODE_STREAMER_PATCHED_SHA
        offset_1=0x94dc03
        before_1=8955d0
        after_1=b22190
        offset_2=0x94e4ee
        before_2=8b45d0
        after_2=6a2158
    else
        for profile_file in \
            "$hwdecode_compatibility_profiles" \
            "$hwdecode_generated_profiles"; do
            [[ -r $profile_file ]] || continue
            while IFS=$'\t' read -r \
                row_version original_sha patched_sha \
                offset_1 before_1 after_1 offset_2 before_2 after_2; do
                [[ -n $row_version && $row_version != \#* ]] || continue
                [[ $row_version == "$version" ]] || continue
                found=true
                break
            done <"$profile_file"
            $found && break
        done
        $found || return 1
    fi

    [[ $original_sha =~ ^[[:xdigit:]]{64}$ &&
        $patched_sha =~ ^[[:xdigit:]]{64}$ &&
        $offset_1 =~ ^0[xX][[:xdigit:]]+$ &&
        $offset_2 =~ ^0[xX][[:xdigit:]]+$ &&
        $before_1 =~ ^[[:xdigit:]]{6}$ &&
        $before_2 =~ ^[[:xdigit:]]{6}$ &&
        $after_1 =~ ^[[:xdigit:]]{6}$ &&
        $after_2 =~ ^[[:xdigit:]]{6}$ ]] || return 1

    streamer_profile_version=$version
    streamer_original_sha=${original_sha,,}
    streamer_patched_sha=${patched_sha,,}
    streamer_patch_offset_1=$((offset_1))
    streamer_patch_offset_2=$((offset_2))
    streamer_patch_before_1=${before_1,,}
    streamer_patch_before_2=${before_2,,}
    streamer_patch_after_1=${after_1,,}
    streamer_patch_after_2=${after_2,,}
}

hwdecode_version_supported() {
    load_hwdecode_profile "$1"
}

hwdecode_profile_generated() {
    local version=$1 row_version

    [[ -r $hwdecode_generated_profiles ]] || return 1
    while IFS=$'\t' read -r row_version _; do
        [[ -n $row_version && $row_version != \#* ]] || continue
        [[ $row_version == "$version" ]] && return 0
    done <"$hwdecode_generated_profiles"
    return 1
}

generate_hwdecode_profile() {
    local version=$1 row row_version original_sha current_sha
    local temp existing_version existing_remainder

    [[ -x $hwdecode_profiler && -f $streamer_dll ]] || return 1
    row=$("$hwdecode_profiler" \
        --derive "$streamer_dll" --version "$version" 2>>"$setup_log") ||
        return 1
    IFS=$'\t' read -r row_version original_sha _ <<<"$row"
    [[ $row_version == "$version" &&
        $original_sha =~ ^[[:xdigit:]]{64}$ ]] || return 1
    current_sha=$(file_sha256 "$streamer_dll") || return 1
    [[ ${original_sha,,} == "$current_sha" ]] || return 1

    temp=$(mktemp "$data_dir/.hwdecode-generated.XXXXXX")
    printf '# Automatically derived, fail-closed NVDEC profiles.\n' >"$temp"
    if [[ -r $hwdecode_generated_profiles ]]; then
        while IFS=$'\t' read -r existing_version existing_remainder; do
            [[ -n $existing_version && $existing_version != \#* ]] || continue
            [[ $existing_version == "$version" ]] && continue
            printf '%s\t%s\n' "$existing_version" "$existing_remainder" >>"$temp"
        done <"$hwdecode_generated_profiles"
    fi
    printf '%s\n' "$row" >>"$temp"
    chmod 0600 "$temp"
    mv -f "$temp" "$hwdecode_generated_profiles"
    streamer_profile_version=""
    load_hwdecode_profile "$version" || return 1
    printf '已为 UU %s 自动生成并校验 NVDEC 二进制档案。\n' "$version"
}

remove_generated_hwdecode_profile() {
    local version=$1 temp existing_version existing_remainder

    [[ -r $hwdecode_generated_profiles ]] || return 0
    temp=$(mktemp "$data_dir/.hwdecode-generated.XXXXXX")
    printf '# Automatically derived, fail-closed NVDEC profiles.\n' >"$temp"
    while IFS=$'\t' read -r existing_version existing_remainder; do
        [[ -n $existing_version && $existing_version != \#* ]] || continue
        [[ $existing_version == "$version" ]] && continue
        printf '%s\t%s\n' "$existing_version" "$existing_remainder" >>"$temp"
    done <"$hwdecode_generated_profiles"
    chmod 0600 "$temp"
    mv -f "$temp" "$hwdecode_generated_profiles"
    if [[ $streamer_profile_version == "$version" ]]; then
        streamer_profile_version=""
    fi
}

ensure_hwdecode_profile() {
    local version=$1

    hwdecode_version_supported "$version" && return 0
    generate_hwdecode_profile "$version"
}

load_hwdecode_profile_from_streamer_files() {
    local original_hash="" patched_hash=""
    local row_version original_sha patched_sha profile_file
    local override_version="${UU_REMOTE_HWDECODE_STREAMER_VERSION:-4.34.0.8979}"

    [[ -f $streamer_original ]] &&
        original_hash=$(file_sha256 "$streamer_original")
    [[ -f $streamer_dll ]] &&
        patched_hash=$(file_sha256 "$streamer_dll")
    [[ -n $original_hash || -n $patched_hash ]] || return 1

    if [[ -n ${UU_REMOTE_HWDECODE_STREAMER_ORIGINAL_SHA:-} &&
        -n ${UU_REMOTE_HWDECODE_STREAMER_PATCHED_SHA:-} ]] &&
        { [[ -n $original_hash &&
            $original_hash == "${UU_REMOTE_HWDECODE_STREAMER_ORIGINAL_SHA,,}" ]] ||
          [[ -n $patched_hash &&
            $patched_hash == "${UU_REMOTE_HWDECODE_STREAMER_PATCHED_SHA,,}" ]]; }; then
        load_hwdecode_profile "$override_version"
        return
    fi

    for profile_file in \
        "$hwdecode_compatibility_profiles" \
        "$hwdecode_generated_profiles"; do
        [[ -r $profile_file ]] || continue
        while IFS=$'\t' read -r \
            row_version original_sha patched_sha _; do
            [[ -n $row_version && $row_version != \#* ]] || continue
            if [[ -n $original_hash && ${original_sha,,} == "$original_hash" ]] ||
                [[ -n $patched_hash && ${patched_sha,,} == "$patched_hash" ]]; then
                load_hwdecode_profile "$row_version"
                return
            fi
        done <"$profile_file"
    done
    return 1
}

write_update_status() {
    local status=$1 installed=$2 latest=$3 message=$4 temp

    temp=$(mktemp "$state_dir/.update-status.XXXXXX")
    {
        printf 'status=%s\n' "$status"
        printf 'installed=%s\n' "$installed"
        printf 'latest=%s\n' "$latest"
        printf 'package_version=%s\n' "$package_version"
        printf 'message=%s\n' "${message//$'\n'/ }"
        printf 'checked_at=%(%FT%T%z)T\n' -1
    } >"$temp"
    chmod 0600 "$temp"
    mv -f "$temp" "$update_status_file"
}

update_status_label() {
    local status="" latest="" message="" key value

    [[ -r $update_status_file ]] || {
        printf '尚未检查'
        return
    }
    while IFS='=' read -r key value; do
        case $key in
            status)
                status=$value
                ;;
            latest)
                latest=$value
                ;;
            message)
                message=$value
                ;;
        esac
    done <"$update_status_file"
    case $status in
        up-to-date)
            printf '已是最新版本（%s）' "$latest"
            ;;
        updated)
            printf '已更新到 %s' "$latest"
            ;;
        paused)
            printf '已暂缓 %s：%s' "$latest" "$message"
            ;;
        rolled-back)
            printf '更新失败并已回滚：%s' "$message"
            ;;
        error)
            printf '检查失败：%s' "$message"
            ;;
        *)
            printf '%s' "${message:-状态未知}"
            ;;
    esac
}

uu_remote_auto_update_enabled() {
    [[ -x $update_bridge ]] &&
        "$update_bridge" setting-enabled "$client_setting_file"
}

wine_version() {
    local output

    output=$("$wine" --version 2>/dev/null) || return 1
    if [[ $output =~ ([0-9]+([.][0-9]+){1,3}) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return
    fi
    return 1
}

check_base_requirements() {
    local command_name
    local detected_version

    [[ $(uname -m) == x86_64 ]] ||
        die "当前仅支持 x86_64/amd64，检测到：$(uname -m)"

    for command_name in curl sha256sum stat od flock readlink tar \
        systemctl systemd-run systemd-inhibit setsid; do
        command -v "$command_name" >/dev/null 2>&1 ||
            die "缺少必需命令：$command_name"
    done

    for command_name in "$wine" "$wineboot" "$wineserver" "$winecfg"; do
        command -v "$command_name" >/dev/null 2>&1 ||
            die "缺少 Wine 命令：$command_name。需要 Wine $min_wine_version 或更高版本"
    done

    detected_version=$(wine_version) ||
        die "无法识别 Wine 版本"
    if ! version_at_least "$detected_version" "$min_wine_version"; then
        if [[ ${UU_REMOTE_ALLOW_UNSUPPORTED_WINE:-0} != 1 ]]; then
            die "Wine $detected_version 过旧；要求 $min_wine_version+。仅排错可设置 UU_REMOTE_ALLOW_UNSUPPORTED_WINE=1"
        fi
        printf '警告：正在使用未经支持的 Wine %s（最低要求 %s）\n' \
            "$detected_version" "$min_wine_version" >&2
    fi
}

registry_value() {
    local key=$1
    local value=$2
    local output line

    output=$("$wine" reg query "$key" /v "$value" 9>&- 2>/dev/null) ||
        return 1
    while IFS= read -r line; do
        if [[ $line =~ ^[[:space:]]*${value}[[:space:]]+REG_[[:alnum:]_]+[[:space:]]+(.+)$ ]]; then
            printf '%s\n' "${BASH_REMATCH[1]%$'\r'}"
            return
        fi
    done <<<"$output"
    return 1
}

controller_xim_disabled() {
    local value

    value=$(registry_value "$controller_xim_key" UseXIM) || return 1
    [[ ${value^^} == N ]]
}

controller_take_focus_enabled() {
    local value

    value=$(registry_value "$controller_xim_key" UseTakeFocus) || return 1
    [[ ${value^^} == Y ]]
}

server_windows_driver_compat_enabled() {
    local value

    value=$(registry_value "$server_compat_key" Version) || return 1
    [[ ${value,,} == win7 ]]
}

webview_ready() {
    local version

    version=$(registry_value "$webview_key" pv) || return 1
    [[ -n $version && $version != 0.0.0.0 &&
        -f "$webview_root/$version/msedgewebview2.exe" ]]
}

app_files_present() {
    [[ -f $client && -f $client_image && -f $server && -f $healthd ]]
}

shim_ready() {
    [[ -r $shim_source && -f $native_wevtapi ]] &&
        cmp -s "$shim_source" "$native_wevtapi"
}

input_hook_files_ready() {
    [[ -r $input_hook_source && -r $input_injector_source &&
        -f $input_hook && -f $input_hook_preload &&
        -f $input_injector ]] &&
        cmp -s "$input_hook_source" "$input_hook" &&
        cmp -s "$input_hook_source" "$input_hook_preload" &&
        cmp -s "$input_injector_source" "$input_injector"
}

input_hook_ready() {
    [[ -f $prefix/system.reg ]] &&
        input_hook_files_ready
}

hwdecode_runtime_ready() {
    [[ -r "$hwdecode_dxvk_dir/d3d11.dll" &&
        -r "$hwdecode_dxvk_dir/dxgi.dll" &&
        -r "$hwdecode_dxgi_probe_source" &&
        -x "$hwdecode_profiler" &&
        -r "$hwdecode_wine_dir/x86_64-unix/nvcuda.dll.so" &&
        -r "$hwdecode_wine_dir/x86_64-unix/nvcuvid.dll.so" &&
        -r "$hwdecode_wine_dir/x86_64-windows/nvcuda.dll" &&
        -r "$hwdecode_wine_dir/x86_64-windows/nvcuvid.dll" ]]
}

hwdecode_host_libraries_ready() {
    local libraries

    if [[ ${UU_REMOTE_HWDECODE_ASSUME_HOST_READY:-0} == 1 ]]; then
        return
    fi
    libraries=$(ldconfig -p 2>/dev/null || true)
    [[ $libraries == *"libcuda.so.1"* && $libraries == *"libnvcuvid.so.1"* ]]
}

hwdecode_enabled() {
    [[ -r $hwdecode_enabled_stamp ]]
}

saved_decoder_selection() {
    [[ -x $decoder_selector ]] || return
    "$decoder_selector" --get "$decoder_selection_file" 2>/dev/null
}

write_decoder_selection() {
    local selection=$1 temp

    [[ $selection == auto || $selection == cpu ||
        $selection =~ ^nvidia:[0-9]+$ ]] ||
        die "拒绝保存无效的解码设备：$selection"
    temp=$(mktemp "$data_dir/.decoder-selection.XXXXXX")
    {
        printf 'version=1\n'
        printf 'selection=%s\n' "$selection"
        printf 'selected_at=%(%FT%T%z)T\n' -1
    } >"$temp"
    chmod 0600 "$temp"
    mv -f "$temp" "$decoder_selection_file"
}

effective_decoder_selection() {
    local selection installed_version

    selection=$(saved_decoder_selection || true)
    if [[ $selection == auto ]]; then
        "$decoder_selector" --best-id 2>/dev/null || printf 'cpu\n'
    elif [[ $selection =~ ^nvidia:[0-9]+$ ]]; then
        installed_version=$(
            registry_value "$installed_version_key" Version || true
        )
        if [[ -n $installed_version ]] &&
            ! hwdecode_version_supported "$installed_version"; then
            printf '%s（UU %s 暂用 CPU）\n' \
                "$selection" "$installed_version"
        else
            printf '%s\n' "$selection"
        fi
    elif [[ -n $selection ]]; then
        printf '%s\n' "$selection"
    elif hwdecode_enabled; then
        printf 'nvidia:0（旧配置）\n'
    else
        printf 'UU 默认/CPU 回退\n'
    fi
}

file_sha256() {
    local output

    output=$(sha256sum "$1") || return
    printf '%s\n' "${output%% *}"
}

streamer_bridge_ready() {
    load_hwdecode_profile ||
        load_hwdecode_profile_from_streamer_files || return 1
    [[ -f $streamer_dll && -f $streamer_original ]] &&
        [[ $(file_sha256 "$streamer_dll") == "$streamer_patched_sha" ]] &&
        [[ $(file_sha256 "$streamer_original") == "$streamer_original_sha" ]]
}

hwdecode_files_deployed() {
    hwdecode_runtime_ready &&
        cmp -s "$hwdecode_dxvk_dir/d3d11.dll" "$hwdecode_d3d11" &&
        cmp -s "$hwdecode_dxvk_dir/dxgi.dll" "$hwdecode_dxgi" &&
        cmp -s "$hwdecode_wine_dir/x86_64-windows/nvcuda.dll" "$hwdecode_nvcuda" &&
        cmp -s "$hwdecode_wine_dir/x86_64-windows/nvcuvid.dll" "$hwdecode_nvcuvid" &&
        cmp -s "$hwdecode_dxgi_probe_source" "$hwdecode_dxgi_probe" &&
        streamer_bridge_ready
}

hwdecode_manifest_hash() {
    local name=$1 key value

    [[ -r $hwdecode_manifest ]] || return 1
    while IFS='=' read -r key value; do
        if [[ $key == "$name" && $value =~ ^[[:xdigit:]]{64}$ ]]; then
            printf '%s\n' "$value"
            return
        fi
    done <"$hwdecode_manifest"
    return 1
}

hwdecode_file_owned() {
    local name=$1 source=$2 target=$3 expected actual

    [[ -f $target ]] || return 1
    if [[ -r $source ]] && cmp -s "$source" "$target"; then
        return
    fi
    expected=$(hwdecode_manifest_hash "$name") || return 1
    actual=$(sha256sum "$target")
    actual=${actual%% *}
    [[ $actual == "$expected" ]]
}

hwencode_runtime_ready() {
    [[ -x $hwencode_policy && -r $hwencode_probe_source &&
        -r "$hwdecode_dxvk_dir/d3d11.dll" &&
        -r "$hwdecode_dxvk_dir/dxgi.dll" &&
        -r "$hwdecode_wine_dir/x86_64-unix/nvencodeapi64.dll.so" &&
        -r "$hwdecode_wine_dir/x86_64-windows/nvencodeapi64.dll" ]]
}

hwencode_host_libraries_ready() {
    local libraries

    if [[ ${UU_REMOTE_HWENCODE_ASSUME_HOST_READY:-0} == 1 ]]; then
        return
    fi
    libraries=$(ldconfig -p 2>/dev/null || true)
    [[ $libraries == *"libcuda.so.1"* &&
        $libraries == *"libnvidia-encode.so.1"* ]]
}

hwencode_enabled() {
    [[ -r $hwencode_enabled_stamp ]]
}

hwencode_disabled() {
    [[ -r $hwencode_disabled_stamp ]]
}

hwencode_manifest_hash() {
    local name=$1 key value

    [[ -r $hwencode_manifest ]] || return 1
    while IFS='=' read -r key value; do
        if [[ $key == "$name" && $value =~ ^[[:xdigit:]]{64}$ ]]; then
            printf '%s\n' "$value"
            return
        fi
    done <"$hwencode_manifest"
    return 1
}

hwencode_file_owned() {
    local name=$1 source=$2 target=$3 expected actual

    [[ -f $target ]] || return 1
    if [[ -r $source ]] && cmp -s "$source" "$target"; then
        return
    fi
    expected=$(hwencode_manifest_hash "$name") || return 1
    actual=$(file_sha256 "$target") || return 1
    [[ $actual == "$expected" ]]
}

hwencode_files_deployed() {
    hwencode_runtime_ready &&
        cmp -s "$hwdecode_dxvk_dir/d3d11.dll" "$hwdecode_d3d11" &&
        cmp -s "$hwdecode_dxvk_dir/dxgi.dll" "$hwdecode_dxgi" &&
        cmp -s "$hwdecode_wine_dir/x86_64-windows/nvencodeapi64.dll" \
            "$hwencode_nvencode" &&
        cmp -s "$hwencode_probe_source" "$hwencode_probe" &&
        [[ -r $hwencode_dxvk_config ]] &&
        grep -qx 'dxgi.hideNvidiaGpu = False' "$hwencode_dxvk_config"
}

configure_hwencode_environment() {
    local ids device_id adapter_id

    export WINEDLLPATH="${hwdecode_wine_dir}${WINEDLLPATH:+:$WINEDLLPATH}"
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+${WINEDLLOVERRIDES};}d3d11=n;dxgi=n;nvencodeapi64=b"
    export DXVK_CONFIG_FILE="$hwencode_dxvk_config"
    export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-none}"
    export UU_REMOTE_CUDA_DEVICE="${UU_REMOTE_CUDA_DEVICE:-0}"
    if ids=$(hwencode_probe_ids 2>/dev/null); then
        IFS=$'\t' read -r device_id adapter_id <<<"$ids"
        export UU_REMOTE_NVENC_ADAPTER_LUID="$adapter_id"
    fi
}

hwencode_signature() {
    local app_version bridge_hash dxvk_hash capture_hook_hash

    app_version=$(registry_value "$installed_version_key" Version || printf unknown)
    bridge_hash=$(file_sha256 \
        "$hwdecode_wine_dir/x86_64-unix/nvencodeapi64.dll.so") || return 1
    dxvk_hash=$(file_sha256 "$hwdecode_dxvk_dir/d3d11.dll") || return 1
    capture_hook_hash=$(file_sha256 "$input_hook_source") || return 1
    printf '%s:%s:%s:%s:%s\n' \
        "$package_version" "$app_version" "$bridge_hash" "$dxvk_hash" \
        "$capture_hook_hash"
}

hwencode_probe_current() {
    local expected recorded

    [[ -r $hwencode_probe_status ]] || return 1
    expected=$(hwencode_signature) || return 1
    recorded=$(sed -n 's/^signature=//p' "$hwencode_probe_status" | head -n1)
    [[ $recorded == "$expected" ]] &&
        grep -q $'^NVENC_D3D11_OK\t.*\th264=1\thevc=1\ttexture_upload=1\tnv12_upload=1$' \
            "$hwencode_probe_status"
}

hwencode_probe_ids() {
    local line field device="" adapter=""

    [[ -r $hwencode_probe_status ]] || return 1
    line=$(grep -m1 $'^NVENC_D3D11_OK\t' "$hwencode_probe_status") || return 1
    while IFS= read -r field; do
        case $field in
            device=*) device=${field#device=} ;;
            luid=*) adapter=${field#luid=} ;;
        esac
    done < <(tr '\t' '\n' <<<"$line")
    [[ $device =~ ^[0-9]+$ && $adapter =~ ^[0-9]+$ ]] || return 1
    printf '%s\t%s\n' "$device" "$adapter"
}

probe_hwencode_bridge() {
    local output line signature temp installed_version

    [[ -f $hwencode_probe ]] || return 1
    installed_version=$(
        registry_value "$installed_version_key" Version 2>/dev/null || true
    )
    [[ -n $installed_version ]] || return 1
    ensure_streamer_compatibility_profile "$installed_version" || return 1
    configure_hwencode_environment
    output=$(mktemp "$cache_dir/.hwencode-probe.XXXXXX")
    if ! (
        cd "$install_dir/bin"
        env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
            -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
            -u ALL_PROXY -u NO_PROXY \
            timeout 60s "$wine" "$hwencode_probe" 9>&-
    ) >"$output" 2>>"$setup_log"; then
        sed -i 's/\r$//' "$output"
        sed -n '1,40p' "$output" >>"$setup_log"
        rm -f -- "$output"
        return 1
    fi
    sed -i 's/\r$//' "$output"
    line=$(grep -m1 $'^NVENC_D3D11_OK\t' "$output") || {
        rm -f -- "$output"
        return 1
    }
    grep -q $'\th264=1\thevc=1\ttexture_upload=1\tnv12_upload=1$' \
        <<<"$line" || {
        rm -f -- "$output"
        return 1
    }
    signature=$(hwencode_signature) || {
        rm -f -- "$output"
        return 1
    }
    temp=$(mktemp "$state_dir/.hwencode-probe-status.XXXXXX")
    {
        printf 'signature=%s\n' "$signature"
        printf 'checked_at=%(%FT%T%z)T\n' -1
        printf '%s\n' "$line"
    } >"$temp"
    mv -f "$temp" "$hwencode_probe_status"
    {
        printf '\n[%(%FT%T%z)T] NVENC D3D11→CUDA 深层探测通过\n' -1
        printf '%s\n' "$line"
    } >>"$setup_log"
    rm -f -- "$output"
}

apply_hwencode_policy() {
    local ids device_id adapter_id

    [[ -f $encoder_cache ]] || return 2
    ids=$(hwencode_probe_ids) || return 1
    IFS=$'\t' read -r device_id adapter_id <<<"$ids"
    "$hwencode_policy" enable \
        "$encoder_cache" "$encoder_cache_backup" \
        "$device_id" "$adapter_id" >>"$setup_log" 2>&1
}

hwencode_policy_ready() {
    local ids device_id adapter_id

    ids=$(hwencode_probe_ids) || return 1
    IFS=$'\t' read -r device_id adapter_id <<<"$ids"
    "$hwencode_policy" verify \
        "$encoder_cache" "$encoder_cache_backup" \
        "$device_id" "$adapter_id" >/dev/null 2>&1
}

start_hwencode_policy_watcher() {
    local ids device_id adapter_id
    local -a watcher_command systemd_command

    hwencode_enabled || return 0
    ids=$(hwencode_probe_ids) || return 1
    IFS=$'\t' read -r device_id adapter_id <<<"$ids"
    watcher_command=(
        "$hwencode_policy"
        watch
        "$encoder_cache"
        "$encoder_cache_backup"
        "$device_id"
        "$adapter_id"
        "$hwencode_enabled_stamp"
        "$hwencode_policy_lock"
    )
    if systemd_user_available; then
        if runtime_unit_active "$hwencode_policy_runtime_unit"; then
            return 0
        fi
        systemctl --user reset-failed \
            "$hwencode_policy_runtime_unit.service" >/dev/null 2>&1 || true
        systemd_command=(
            systemd-run
            --user
            "--unit=$hwencode_policy_runtime_unit"
            --collect
            --quiet
            --property=Restart=on-failure
            --property=RestartSec=1s
            "--property=StandardOutput=append:$hwencode_policy_log"
            "--property=StandardError=append:$hwencode_policy_log"
            "${watcher_command[@]}"
        )
        "${systemd_command[@]}" 9>&- && return 0
        printf '警告：无法创建 NVENC 档案监视服务，改用兼容后台进程。\n' >&2
    fi
    nohup "${watcher_command[@]}" 9>&- </dev/null \
        >>"$hwencode_policy_log" 2>&1 &
}

mark_hwencode_failure() {
    local signature

    signature=$(hwencode_signature 2>/dev/null || printf unknown)
    printf '%s\n' "$signature" >"${hwencode_failed_stamp}.tmp"
    mv -f "${hwencode_failed_stamp}.tmp" "$hwencode_failed_stamp"
}

hwencode_failure_current() {
    local signature

    [[ -r $hwencode_failed_stamp ]] || return 1
    signature=$(hwencode_signature 2>/dev/null || printf unknown)
    [[ $(<"$hwencode_failed_stamp") == "$signature" ]]
}

streamer_profile_requires_portrait() {
    local version=$1

    version_at_least "$version" "$adaptive_patch_baseline_version"
}

future_adaptive_patch_required() {
    local version=$1

    version_greater "$version" "$adaptive_patch_baseline_version"
}

streamer_profile_command() {
    local command=$1 streamer=$2 version=$3 profile=$4
    local -a arguments

    arguments=(
        "$hwencode_policy" "$command" "$streamer" "$version" "$profile"
    )
    if streamer_profile_requires_portrait "$version"; then
        arguments+=(--require-portrait)
    fi
    "${arguments[@]}"
}

ensure_streamer_compatibility_profile() {
    local version=$1 streamer_sha archive temp

    [[ -x $hwencode_policy && -f $streamer_dll ]] || return 1
    [[ $version =~ ^[0-9]+([.][0-9]+){2,3}$ ]] || return 1
    streamer_sha=$(file_sha256 "$streamer_dll") || return 1
    mkdir -p "$streamer_profile_dir"
    archive="$streamer_profile_dir/${version}-${streamer_sha}.json"

    if ! streamer_profile_command match-streamer-profile \
        "$streamer_dll" "$version" "$archive" \
        >>"$setup_log" 2>&1; then
        rm -f -- "$archive"
        streamer_profile_command derive-streamer-profile \
            "$streamer_dll" "$version" "$archive" \
            >>"$setup_log" 2>&1 || return 1
        streamer_profile_command verify-streamer-profile \
            "$streamer_dll" "$version" "$archive" \
            >>"$setup_log" 2>&1 || {
            rm -f -- "$archive"
            return 1
        }
    fi

    temp=$(mktemp "$data_dir/.streamer-compatibility.XXXXXX") || return 1
    install -m0600 "$archive" "$temp" || {
        rm -f -- "$temp"
        return 1
    }
    mv -f "$temp" "$streamer_active_profile" || {
        rm -f -- "$temp"
        return 1
    }
    streamer_profile_command match-streamer-profile \
        "$streamer_dll" "$version" "$streamer_active_profile" \
        >>"$setup_log" 2>&1 || return 1
    printf '已为 UU %s 自动生成并校验 NVENC/竖屏语义档案。\n' "$version"
}

streamer_compatibility_profile_ready() {
    local version=$1

    [[ -f $streamer_dll && -r $streamer_active_profile ]] || return 1
    streamer_profile_command match-streamer-profile \
        "$streamer_dll" "$version" "$streamer_active_profile" \
        >/dev/null 2>&1
}

decoder_selection_wants_nvdec() {
    local requested effective

    requested=$(saved_decoder_selection || true)
    [[ -n $requested ]] || return 1
    effective=$requested
    if [[ $requested == auto ]]; then
        effective=$("$decoder_selector" --best-id 2>/dev/null || printf 'cpu')
    fi
    [[ $effective =~ ^nvidia:[0-9]+$ ]]
}

update_blocker_manifest_hash() {
    local key value

    [[ -r $update_blocker_manifest ]] || return 1
    while IFS='=' read -r key value; do
        if [[ $key == original_sha256 &&
            $value =~ ^[[:xdigit:]]{64}$ ]]; then
            printf '%s\n' "$value"
            return
        fi
    done <"$update_blocker_manifest"
    return 1
}

update_blocker_ready() {
    local expected actual

    [[ -r $update_blocker_source &&
        -f $native_upgrade &&
        -f $native_upgrade_original ]] ||
        return 1
    cmp -s "$update_blocker_source" "$native_upgrade" || return 1
    expected=$(update_blocker_manifest_hash) || return 1
    actual=$(file_sha256 "$native_upgrade_original") || return 1
    [[ $actual == "$expected" ]]
}

write_update_blocker_manifest() {
    local original_sha=$1 app_version=$2 temp

    temp=$(mktemp "$data_dir/.update-blocker-manifest.XXXXXX")
    {
        printf 'version=1\n'
        printf 'package_version=%s\n' "$package_version"
        printf 'uu_version=%s\n' "$app_version"
        printf 'original_sha256=%s\n' "$original_sha"
        printf 'deployed_at=%(%FT%T%z)T\n' -1
    } >"$temp"
    chmod 0600 "$temp"
    mv -f "$temp" "$update_blocker_manifest"
}

archive_native_upgrade_original() {
    local source=$1 hash archive

    [[ -f $source ]] || return
    hash=$(file_sha256 "$source")
    archive="$update_original_archive/Upgrade-$hash.exe"
    if [[ ! -e $archive ]]; then
        install -Dm0600 "$source" "$archive" ||
            die "无法归档旧版 UU Upgrade.exe"
    fi
}

deploy_update_blocker() {
    local original_sha app_version

    [[ -r $update_blocker_source ]] ||
        die "缺少自动更新保护程序：$update_blocker_source"
    [[ -f $native_upgrade || -f $native_upgrade_original ]] ||
        die "UU Upgrade.exe 缺失，无法启用安全更新桥"

    if [[ -f $native_upgrade ]] &&
        cmp -s "$update_blocker_source" "$native_upgrade"; then
        [[ -f $native_upgrade_original ]] ||
            die "UU 原版 Upgrade.exe 备份缺失；拒绝继续以避免破坏更新能力"
    else
        [[ -f $native_upgrade ]] ||
            die "UU Upgrade.exe 缺失，且当前位置不是本项目占位程序"
        if [[ -f $native_upgrade_original ]]; then
            archive_native_upgrade_original "$native_upgrade_original"
        fi
        mv -f "$native_upgrade" "$native_upgrade_original" ||
            die "无法保存 UU 原版 Upgrade.exe"
        install -Dm0644 "$update_blocker_source" "$native_upgrade" ||
            die "无法部署自动更新保护程序"
    fi

    original_sha=$(file_sha256 "$native_upgrade_original") ||
        die "无法计算原版 Upgrade.exe 哈希"
    app_version=$(registry_value "$installed_version_key" Version || true)
    write_update_blocker_manifest "$original_sha" "${app_version:-unknown}"
    update_blocker_ready ||
        die "自动更新保护程序部署后校验失败"
}

resolve_launcher_path() {
    local candidate

    if [[ -n ${UU_REMOTE_AUTOSTART_LAUNCHER:-} ]]; then
        candidate=$UU_REMOTE_AUTOSTART_LAUNCHER
    elif [[ $0 == */* ]]; then
        candidate=$(/usr/bin/readlink -f -- "$0")
    else
        candidate=$(command -v -- "$0" 2>/dev/null || true)
    fi
    [[ -n $candidate && $candidate == /* && -x $candidate ]] || return 1
    printf '%s\n' "$candidate"
}

windows_autostart_enabled() {
    [[ -x $autostart_bridge ]] &&
        "$autostart_bridge" registry-enabled "$prefix/user.reg"
}

native_autostart_enabled() {
    [[ -x $autostart_bridge ]] &&
        "$autostart_bridge" native-enabled "$autostart_desktop"
}

sync_autostart_once() {
    local launcher_path

    launcher_path=$(resolve_launcher_path) || return 1
    "$autostart_bridge" sync \
        "$prefix/user.reg" \
        "$autostart_desktop" \
        "$launcher_path" \
        "$autostart_log" \
        9>&-
}

start_autostart_bridge() {
    local launcher_path

    [[ ${UU_REMOTE_DISABLE_AUTOSTART_WATCHER:-0} != 1 ]] || return 0
    launcher_path=$(resolve_launcher_path) || {
        printf '警告：无法确定启动器绝对路径，自启动兼容桥未运行。\n' >&2
        return
    }
    nohup "$autostart_bridge" watch \
        "$prefix/user.reg" \
        "$autostart_desktop" \
        "$launcher_path" \
        "$autostart_log" \
        "$autostart_lock" \
        "$autostart_interval" \
        9>&- </dev/null >/dev/null 2>&1 &
}

uu_remote_prevent_sleep_state() {
    [[ -x $sleep_bridge ]] || {
        printf 'unknown\n'
        return
    }
    UU_REMOTE_SLEEP_SETTING_FILE="$client_setting_file" \
        "$sleep_bridge" state "$client_log_dir" 2>/dev/null ||
        printf 'unknown\n'
}

uu_remote_prevent_sleep_label() {
    local state

    state=$(uu_remote_prevent_sleep_state)
    case $state in
        enabled)
            printf '开启'
            ;;
        disabled)
            printf '关闭'
            ;;
        *)
            printf '未知（尚无客户端状态）'
            ;;
    esac
}

native_sleep_inhibition_active() {
    [[ -x $sleep_bridge ]] && "$sleep_bridge" inhibitor-active
}

start_sleep_bridge() {
    local launcher_path

    [[ ${UU_REMOTE_DISABLE_SLEEP_WATCHER:-0} != 1 ]] || return 0
    launcher_path=$(resolve_launcher_path) || {
        printf '警告：无法确定启动器绝对路径，防休眠兼容桥未运行。\n' >&2
        return
    }
    UU_REMOTE_SLEEP_SETTING_FILE="$client_setting_file" \
    nohup "$sleep_bridge" watch \
        "$client_log_dir" \
        "$prefix" \
        "$launcher_path" \
        "$sleep_bridge_log" \
        "$sleep_bridge_lock" \
        "$sleep_bridge_interval" \
        9>&- </dev/null >/dev/null 2>&1 &
}

input_bridge_process_active() {
    local pid="" cmdline=""

    [[ -r $input_bridge_status ]] || return 1
    pid=$(sed -n 's/.*"pid": \([0-9][0-9]*\).*/\1/p' \
        "$input_bridge_status" | head -n1)
    [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]] || return 1
    cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    [[ $cmdline == *"$input_bridge"* &&
        $cmdline == *"$input_bridge_endpoint"* ]]
}

input_bridge_status_label() {
    local state="" hook_pid="" hook_version="" backend=""

    if [[ $desktop_backend == wayland-incomplete ]]; then
        printf 'Wayland 会话缺少 XWayland DISPLAY'
    elif [[ $desktop_backend == unsupported ]]; then
        printf '不支持的桌面后端'
    elif [[ ! -x $input_bridge || ! -r $input_hook_source ||
        ! -r $input_injector_source ]]; then
        printf '运行库缺失'
    elif [[ -f $prefix/system.reg ]] && ! input_hook_ready; then
        printf 'Windows 输入钩子未安装/不匹配'
    elif [[ ! -r $input_bridge_status ]]; then
        printf '就绪（待应用启动）'
    else
        state=$(sed -n 's/.*"state": "\([^"]*\)".*/\1/p' \
            "$input_bridge_status" | head -n1)
        hook_pid=$(sed -n 's/.*"hook_pid": \([0-9][0-9]*\).*/\1/p' \
            "$input_bridge_status" | head -n1)
        hook_version=$(sed -n \
            's/.*"hook_version": \([0-9][0-9]*\).*/\1/p' \
            "$input_bridge_status" | head -n1)
        backend=$(sed -n \
            's/.*"backend": "\([^"]*\)".*/\1/p' \
            "$input_bridge_status" | head -n1)
        if [[ $desktop_backend == wayland-xwayland &&
            $backend != wayland && $backend != wayland-portal ]]; then
            printf '就绪（待 Wayland 授权）'
            return
        fi
        if [[ $desktop_backend == x11 &&
            -n $backend && $backend != x11 && $backend != x11-xtest &&
            $backend != fake-x11 ]]; then
            printf '就绪（待应用启动）'
            return
        fi
        case $state in
            active)
                printf '生效中（%s；GameViewerServer PID %s；钩子 v%s）' \
                    "${backend:-$desktop_backend}" \
                    "${hook_pid:-unknown}" "${hook_version:-unknown}"
                ;;
            authorizing)
                printf '等待 Wayland 桌面控制授权'
                ;;
            starting)
                printf '原生输入后端启动中'
                ;;
            waiting-hook)
                printf '原生守护进程已启动，等待 Windows 钩子'
                ;;
            error)
                printf '异常（详见日志）'
                ;;
            stopped)
                printf '已停止'
                ;;
            *)
                printf '启动中'
                ;;
        esac
    fi
}

input_bridge_event_label() {
    local mouse_moves="" mouse_buttons="" keyboard_packets=""

    [[ -r $input_bridge_status ]] || {
        printf '暂无'
        return
    }
    mouse_moves=$(sed -n \
        's/.*"mouse_moves": \([0-9][0-9]*\).*/\1/p' \
        "$input_bridge_status" | head -n1)
    mouse_buttons=$(sed -n \
        's/.*"mouse_buttons": \([0-9][0-9]*\).*/\1/p' \
        "$input_bridge_status" | head -n1)
    keyboard_packets=$(sed -n \
        's/.*"keyboard_packets": \([0-9][0-9]*\).*/\1/p' \
        "$input_bridge_status" | head -n1)
    printf '移动 %s / 鼠标按钮 %s / 键盘 %s' \
        "${mouse_moves:-0}" "${mouse_buttons:-0}" \
        "${keyboard_packets:-0}"
}

input_bridge_target_label() {
    local target="" source="" origin_x="" origin_y="" width="" height=""

    [[ -r $input_bridge_status ]] || {
        printf '默认主显示器（待应用启动）'
        return
    }
    target=$(sed -n \
        's/.*"absolute_target": \[\([^]]*\)\].*/\1/p' \
        "$input_bridge_status" | head -n1)
    source=$(sed -n \
        's/.*"absolute_target_source": "\([^"]*\)".*/\1/p' \
        "$input_bridge_status" | head -n1)
    target=${target//,/ }
    read -r origin_x origin_y width height <<<"$target"
    if [[ $origin_x =~ ^-?[0-9]+$ && $origin_y =~ ^-?[0-9]+$ &&
        $width =~ ^[0-9]+$ && $height =~ ^[0-9]+$ ]]; then
        printf '%sx%s+%s+%s（%s）' \
            "$width" "$height" "$origin_x" "$origin_y" \
            "${source:-unknown}"
    else
        printf '尚未解析'
    fi
}

native_cursor_status_label() {
    local bridge_state="" sequence="" width="" height=""
    local hook_active="" calls="" updates="" fallbacks=""
    local returned_changes=""

    if [[ ! -r $input_bridge_status ]]; then
        printf '就绪（待应用启动）'
        return
    fi
    bridge_state=$(sed -n \
        's/.*"cursor_state": "\([^"]*\)".*/\1/p' \
        "$input_bridge_status" | head -n1)
    sequence=$(sed -n \
        's/.*"cursor_sequence": \([0-9][0-9]*\).*/\1/p' \
        "$input_bridge_status" | head -n1)
    width=$(sed -n \
        's/.*"cursor_width": \([0-9][0-9]*\).*/\1/p' \
        "$input_bridge_status" | head -n1)
    height=$(sed -n \
        's/.*"cursor_height": \([0-9][0-9]*\).*/\1/p' \
        "$input_bridge_status" | head -n1)
    if [[ -r $wayland_frame_hook_status ]]; then
        hook_active=$(ini_section_value \
            "$wayland_frame_hook_status" cursor active)
        calls=$(ini_section_value "$wayland_frame_hook_status" cursor calls)
        updates=$(ini_section_value \
            "$wayland_frame_hook_status" cursor updates)
        fallbacks=$(ini_section_value \
            "$wayland_frame_hook_status" cursor fallbacks)
        returned_changes=$(ini_section_value \
            "$wayland_frame_hook_status" cursor returned_handle_changes)
        if [[ $desktop_backend == wayland-xwayland ]]; then
            sequence=$(ini_section_value \
                "$wayland_frame_hook_status" cursor sequence)
            width=$(ini_section_value \
                "$wayland_frame_hook_status" cursor width)
            height=$(ini_section_value \
                "$wayland_frame_hook_status" cursor height)
        fi
    fi
    if [[ $bridge_state == embedded ]]; then
        printf '生效中（Wayland Portal 嵌入帧；UU 固定指针已抑制）'
    elif [[ $bridge_state != active ]]; then
        printf 'X11 光标图像未建立'
    elif [[ $hook_active == 1 ]]; then
        if [[ $desktop_backend == wayland-xwayland ]]; then
            printf '生效中（Wayland Portal 元数据 → HCURSOR；%sx%s；序列 %s；调用/更新/返回变化/回退 %s/%s/%s/%s）' \
                "${width:-0}" "${height:-0}" "${sequence:-0}" \
                "${calls:-0}" "${updates:-0}" \
                "${returned_changes:-0}" "${fallbacks:-0}"
        else
            printf '生效中（XFixes → HCURSOR；%sx%s；序列 %s；调用/更新/回退 %s/%s/%s）' \
                "${width:-0}" "${height:-0}" "${sequence:-0}" \
                "${calls:-0}" "${updates:-0}" "${fallbacks:-0}"
        fi
    else
        printf 'X11 图像已发布，等待 Win64 光标钩子'
    fi
}

wayland_capture_status_label() {
    local state="" bridge_state="" frames=""

    if [[ $desktop_backend != wayland-xwayland ]]; then
        printf 'X11 直接采集'
    elif [[ ! -r $input_bridge_status ]]; then
        printf '就绪（待应用启动）'
    else
        state=$(sed -n 's/.*"capture_state": "\([^"]*\)".*/\1/p' \
            "$input_bridge_status" | head -n1)
        bridge_state=$(sed -n 's/.*"state": "\([^"]*\)".*/\1/p' \
            "$input_bridge_status" | head -n1)
        frames=$(sed -n \
            's/.*"capture_frames": \([0-9][0-9]*\).*/\1/p' \
            "$input_bridge_status" | head -n1)
        if [[ $bridge_state == error ]]; then
            printf '异常（详见输入桥日志）'
            return
        fi
        case $state in
            active)
                printf '生效中（Portal → Win64 GDI；帧 %s）' \
                    "${frames:-0}"
                ;;
            starting)
                printf '启动中'
                ;;
            stopped)
                printf '已停止'
                ;;
            *)
                printf '未生效'
                ;;
        esac
    fi
}

wayland_frame_hook_status_label() {
    local version="" status_bits="" rendered="" calls=""

    if [[ $desktop_backend != wayland-xwayland ]]; then
        printf 'X11 无需桥接'
        return
    fi
    if [[ ! -r $wayland_frame_hook_status ]]; then
        printf '就绪（待远控采集）'
        return
    fi
    version=$(ini_section_value "$wayland_frame_hook_status" hook version)
    status_bits=$(ini_section_value \
        "$wayland_frame_hook_status" hook status_bits)
    calls=$(ini_section_value "$wayland_frame_hook_status" capture calls)
    rendered=$(ini_section_value \
        "$wayland_frame_hook_status" capture rendered)
    if [[ $version =~ ^[0-9]+$ && $version -ge 7 &&
        $status_bits =~ ^[0-9]+$ ]] && (( (status_bits & 28) == 28 )); then
        printf '完整（v%s；GDI %s/%s）' \
            "$version" "${rendered:-0}" "${calls:-0}"
    else
        printf '未安装/不完整'
    fi
}

portrait_original_quality_status_label() {
    local version="" hooked="" candidates="" patches=""
    local capture_hooked="" capture_candidates="" capture_patches=""
    local update_hooked="" update_candidates="" update_patches=""
    local scaler_hooked="" scaler_candidates="" scaler_patches=""
    local source_width="" source_height=""
    local destination_width="" destination_height=""

    [[ -r $wayland_frame_hook_status ]] || {
        printf '就绪（待被控端启动）'
        return
    }
    version=$(ini_section_value "$wayland_frame_hook_status" hook version)
    hooked=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_scale_limit_hooked)
    candidates=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_scale_limit_candidates)
    patches=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_scale_limit_patches)
    capture_hooked=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_capture_limit_hooked)
    capture_candidates=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_capture_limit_candidates)
    capture_patches=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_capture_limit_patches)
    update_hooked=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_update_limit_hooked)
    update_candidates=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_update_limit_candidates)
    update_patches=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_update_limit_patches)
    scaler_hooked=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_scaler_hooked)
    scaler_candidates=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_scaler_candidates)
    scaler_patches=$(ini_section_value \
        "$wayland_frame_hook_status" encoder portrait_scaler_patches)
    source_width=$(ini_section_value \
        "$wayland_frame_hook_status" capture source_width)
    source_height=$(ini_section_value \
        "$wayland_frame_hook_status" capture source_height)
    destination_width=$(ini_section_value \
        "$wayland_frame_hook_status" capture destination_width)
    destination_height=$(ini_section_value \
        "$wayland_frame_hook_status" capture destination_height)
    if [[ $version =~ ^[0-9]+$ && $version -ge 33 && $hooked == 1 &&
        $candidates == 1 && $capture_hooked == 1 &&
        $capture_candidates == 1 && $update_hooked == 1 &&
        $update_candidates == 1 && $scaler_hooked == 1 &&
        $scaler_candidates == 1 ]]; then
        if [[ $source_width =~ ^[1-9][0-9]*$ &&
            $source_height =~ ^[1-9][0-9]*$ &&
            $destination_width =~ ^[1-9][0-9]*$ &&
            $destination_height =~ ^[1-9][0-9]*$ &&
            $source_height -gt $source_width &&
            $destination_width == "$source_width" &&
            $destination_height == "$source_height" ]]; then
            printf '已验证（补丁 %s/%s/%s/%s；竖屏原生采集 %sx%s）' \
                "${patches:-0}" "${capture_patches:-0}" \
                "${update_patches:-0}" "${scaler_patches:-0}" \
                "$destination_width" "$destination_height"
        elif [[ $source_width =~ ^[1-9][0-9]*$ &&
            $source_height =~ ^[1-9][0-9]*$ &&
            $source_height -gt $source_width ]]; then
            printf '补丁已加载，但竖屏实采仍缩放（%sx%s ← %sx%s）' \
                "${destination_width:-0}" "${destination_height:-0}" \
                "$source_width" "$source_height"
        else
            printf '补丁已加载（等待切换竖屏实采验证）'
        fi
    elif [[ $version =~ ^[0-9]+$ && $version -ge 33 ]]; then
        printf '未生效（配置/建轨/更新/缩放器候选 %s/%s/%s/%s）' \
            "${candidates:-0}" "${capture_candidates:-0}" \
            "${update_candidates:-0}" "${scaler_candidates:-0}"
    elif [[ $version =~ ^[0-9]+$ && $version -ge 32 ]]; then
        printf '旧版试验补丁，最终缩放器尚未修复（采集 %sx%s ← %sx%s）' \
            "${destination_width:-0}" "${destination_height:-0}" \
            "${source_width:-0}" "${source_height:-0}"
    elif [[ $version =~ ^[0-9]+$ && $version -ge 31 ]]; then
        printf '旧版试验补丁，运行期重写尚未修复（采集 %sx%s ← %sx%s）' \
            "${destination_width:-0}" "${destination_height:-0}" \
            "${source_width:-0}" "${source_height:-0}"
    else
        printf '旧版钩子，尚未修复'
    fi
}

controller_focus_hook_status_label() {
    local version="" status_bits="" subclassed="" transitions=""
    local storms="" resolved="" blocked="" modal="" handoffs=""
    local guard_breaks="" health_timeouts="" recoveries="" health_suppressed=""
    local sticky_detected="" sticky_filtered="" hard_stalls=""
    local consecutive_timeouts=""
    local repaint_pulses=""

    if [[ ! -r $controller_focus_hook_status ]]; then
        printf '就绪（待主控窗口启动）'
        return
    fi
    version=$(ini_section_value "$controller_focus_hook_status" hook version)
    status_bits=$(ini_section_value \
        "$controller_focus_hook_status" hook status_bits)
    subclassed=$(ini_section_value \
        "$controller_focus_hook_status" window_state subclassed)
    transitions=$(ini_section_value \
        "$controller_focus_hook_status" window_state transitions)
    storms=$(ini_section_value \
        "$controller_focus_hook_status" window_state storms_detected)
    resolved=$(ini_section_value \
        "$controller_focus_hook_status" window_state storms_resolved)
    blocked=$(ini_section_value \
        "$controller_focus_hook_status" window_state blocked_activations)
    modal=$(ini_section_value \
        "$controller_focus_hook_status" window_state modal_latches)
    handoffs=$(ini_section_value \
        "$controller_focus_hook_status" window_state post_modal_handoffs)
    guard_breaks=$(ini_section_value \
        "$controller_focus_hook_status" event_loop guard_breaks)
    sticky_detected=$(ini_section_value \
        "$controller_focus_hook_status" event_loop sticky_nulls_detected)
    sticky_filtered=$(ini_section_value \
        "$controller_focus_hook_status" event_loop sticky_nulls_filtered)
    health_timeouts=$(ini_section_value \
        "$controller_focus_hook_status" ui_health timeouts)
    recoveries=$(ini_section_value \
        "$controller_focus_hook_status" ui_health recovery_requests)
    health_suppressed=$(ini_section_value \
        "$controller_focus_hook_status" ui_health no_livelock_suppressions)
    hard_stalls=$(ini_section_value \
        "$controller_focus_hook_status" ui_health hard_stalls_detected)
    consecutive_timeouts=$(ini_section_value \
        "$controller_focus_hook_status" ui_health consecutive_timeouts)
    repaint_pulses=$(ini_section_value \
        "$controller_focus_hook_status" home_window repaint_pulses)
    if [[ $version =~ ^[0-9]+$ && $version -ge 19 &&
        $status_bits =~ ^[0-9]+$ ]] && (( (status_bits & 959) == 959 )); then
        printf '生效中（v%s；托盘重绘 %s，空队列/粘滞消息纠正 %s/%s，UI 超时/连续/硬卡死/恢复 %s/%s/%s/%s，顶层窗口 %s）' \
            "$version" "${repaint_pulses:-0}" \
            "${guard_breaks:-0}" "${sticky_detected:-0}" \
            "${health_timeouts:-0}" "${consecutive_timeouts:-0}" \
            "${hard_stalls:-0}" "${recoveries:-0}" \
            "${subclassed:-0}"
    elif [[ $version =~ ^[0-9]+$ && $version -ge 18 &&
        $status_bits =~ ^[0-9]+$ ]] && (( (status_bits & 959) == 959 )); then
        printf '生效中（v%s；空队列/粘滞消息纠正 %s/%s，UI 超时/连续/硬卡死/恢复 %s/%s/%s/%s，顶层窗口 %s）' \
            "$version" "${guard_breaks:-0}" "${sticky_detected:-0}" \
            "${health_timeouts:-0}" "${consecutive_timeouts:-0}" \
            "${hard_stalls:-0}" "${recoveries:-0}" \
            "${subclassed:-0}"
    elif [[ $version =~ ^[0-9]+$ && $version -ge 16 &&
        $status_bits =~ ^[0-9]+$ ]] && (( (status_bits & 959) == 959 )); then
        printf '生效中（v%s；空队列/粘滞消息纠正 %s/%s，粘滞过滤 %s，UI 超时/恢复/安全抑制 %s/%s/%s，顶层窗口 %s）' \
            "$version" "${guard_breaks:-0}" "${sticky_detected:-0}" \
            "${sticky_filtered:-0}" "${health_timeouts:-0}" \
            "${recoveries:-0}" "${health_suppressed:-0}" \
            "${subclassed:-0}"
    elif [[ $version =~ ^[0-9]+$ && $version -ge 15 &&
        $status_bits =~ ^[0-9]+$ ]] && (( (status_bits & 959) == 959 )); then
        printf '生效中（v%s；事件循环纠正 %s，UI 超时/恢复/安全抑制 %s/%s/%s，顶层窗口 %s）' \
            "$version" "${guard_breaks:-0}" "${health_timeouts:-0}" \
            "${recoveries:-0}" "${health_suppressed:-0}" \
            "${subclassed:-0}"
    elif [[ $version =~ ^[0-9]+$ && $version -ge 14 &&
        $status_bits =~ ^[0-9]+$ ]] && (( (status_bits & 959) == 959 )); then
        printf '生效中（v%s；事件循环纠正 %s，UI 超时/恢复 %s/%s，顶层窗口 %s）' \
            "$version" "${guard_breaks:-0}" "${health_timeouts:-0}" \
            "${recoveries:-0}" "${subclassed:-0}"
    elif [[ $version =~ ^[0-9]+$ && $version -ge 9 &&
        $status_bits =~ ^[0-9]+$ ]] && (( (status_bits & 127) == 127 )); then
        if [[ ${storms:-0} =~ ^[0-9]+$ ]] && (( storms > 0 )); then
            printf '生效中（v%s；顶层窗口 %s，争用 %s/%s，阻止抢焦 %s，接管切换 %s/%s）' \
                "$version" "${subclassed:-0}" "${resolved:-0}" \
                "$storms" "${blocked:-0}" "${modal:-0}" \
                "${handoffs:-0}"
        else
            printf '监控中（v%s；顶层窗口 %s，真实消息 %s，接管切换 %s/%s）' \
                "$version" "${subclassed:-0}" "${transitions:-0}" \
                "${modal:-0}" "${handoffs:-0}"
        fi
    elif [[ $version =~ ^[0-9]+$ && $version -ge 9 &&
        $status_bits =~ ^[0-9]+$ ]] && (( (status_bits & 31) == 31 )); then
        if [[ ${subclassed:-0} == 0 ]]; then
            printf '已注入（v%s；等待主控顶层窗口）' "$version"
        else
            printf '部分生效（v%s；顶层窗口/API 未完整接管）' "$version"
        fi
    elif [[ $version == 8 ]]; then
        printf '旧版钩子（仅 IAT，未验证真实顶层窗口）'
    else
        printf '未注入/不完整'
    fi
}

stop_input_bridge_runtime() {
    local pid="" cmdline=""

    if systemd_user_available; then
        systemctl --user stop \
            "$input_runtime_unit.service" \
            "$input_injector_runtime_unit.service" \
            "$focus_injector_runtime_unit.service" >/dev/null 2>&1 || true
        systemctl --user reset-failed \
            "$input_runtime_unit.service" \
            "$input_injector_runtime_unit.service" \
            "$focus_injector_runtime_unit.service" >/dev/null 2>&1 || true
    fi
    if [[ -r $input_bridge_status ]]; then
        pid=$(sed -n 's/.*"pid": \([0-9][0-9]*\).*/\1/p' \
            "$input_bridge_status" | head -n1)
    fi
    if [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]]; then
        cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
        if [[ $cmdline == *"$input_bridge"* &&
            $cmdline == *"$input_bridge_endpoint"* ]]; then
            kill "$pid" >/dev/null 2>&1 || true
            for _ in {1..50}; do
                kill -0 "$pid" >/dev/null 2>&1 || break
                sleep 0.02
            done
        fi
    fi
    if ! input_bridge_process_active; then
        rm -f -- "$input_bridge_endpoint"
    fi
}

start_input_bridge() {
    local variable attempt restart_policy="on-failure"
    local systemd_launched=false
    local -a command

    [[ ${UU_REMOTE_DISABLE_INPUT_BRIDGE:-0} != 1 ]] || return 0
    case $desktop_backend in
        x11)
            [[ -n ${DISPLAY:-} ]] || {
                printf '警告：X11 输入后端缺少 DISPLAY。\n' >&2
                return 1
            }
            ;;
        wayland-xwayland)
            [[ -n ${WAYLAND_DISPLAY:-} && -n ${DISPLAY:-} &&
                -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] || {
                printf '警告：Wayland 输入后端缺少 Wayland、XWayland 或会话 D-Bus 环境。\n' >&2
                return 1
            }
            ;;
        *)
            printf '警告：当前桌面会话无法选择受支持的输入后端。\n' >&2
            return 1
            ;;
    esac
    if ! "$input_bridge" check >>"$input_bridge_log" 2>&1; then
        printf '警告：%s 输入桥依赖检查失败，详见 %s\n' \
            "$desktop_backend" \
            "$input_bridge_log" >&2
        return 1
    fi
    if input_bridge_process_active && [[ -s $input_bridge_endpoint ]]; then
        return 0
    fi
    rm -f -- "$input_bridge_endpoint"

    if systemd_user_available; then
        systemctl --user stop \
            "$input_runtime_unit.service" >/dev/null 2>&1 || true
        systemctl --user reset-failed \
            "$input_runtime_unit.service" >/dev/null 2>&1 || true
        command=(
            systemd-run
            --user
            "--unit=$input_runtime_unit"
            --collect
            --quiet
            "--property=Restart=$restart_policy"
            --property=RestartSec=1s
            --property=TimeoutStopSec=5s
            "--property=StandardOutput=append:$input_bridge_log"
            "--property=StandardError=append:$input_bridge_log"
        )
        for variable in \
            DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
            XDG_CURRENT_DESKTOP XDG_SESSION_TYPE PATH; do
            if [[ -v $variable ]]; then
                command+=("--setenv=$variable=${!variable}")
            fi
        done
        command+=(
            "--setenv=UU_REMOTE_DESKTOP_BACKEND=$desktop_backend"
            "$input_bridge" watch
            "$state_dir"
            "$input_bridge_endpoint"
            "$input_bridge_log"
            "$input_bridge_lock"
            "$input_bridge_release_timeout"
            "$controlled_monitor_file"
        )
        if "${command[@]}" 9>&-; then
            systemd_launched=true
        else
            printf '警告：无法创建输入桥用户服务，改用兼容后台进程。\n' >&2
        fi
    fi
    if ! $systemd_launched && ! runtime_unit_active "$input_runtime_unit"; then
        # shellcheck disable=SC2094
        nohup env UU_REMOTE_DESKTOP_BACKEND="$desktop_backend" \
            "$input_bridge" watch \
            "$state_dir" \
            "$input_bridge_endpoint" \
            "$input_bridge_log" \
            "$input_bridge_lock" \
            "$input_bridge_release_timeout" \
            "$controlled_monitor_file" \
            9>&- </dev/null >>"$input_bridge_log" 2>&1 &
    fi

    for ((attempt = 0; attempt < 100; attempt++)); do
        [[ -s $input_bridge_endpoint ]] && return 0
        if [[ $desktop_backend == wayland-xwayland ]] &&
            runtime_unit_active "$input_runtime_unit"; then
            # Portal authorization can remain open while the controller UI
            # starts; the GDI hook maps frames as soon as sharing is granted.
            return 0
        fi
        sleep 0.02
    done
    return 1
}

keyboard_bridge_status_label() {
    local state=""

    if [[ $desktop_backend != x11 &&
        $desktop_backend != wayland-xwayland ]]; then
        printf '当前会话不支持'
    elif [[ ! -x $keyboard_bridge ]]; then
        printf '缺失'
    elif ! runtime_unit_active "$keyboard_runtime_unit"; then
        printf '就绪（待应用启动）'
    else
        state=$("$keyboard_bridge" status "$state_dir" 2>/dev/null || true)
        case $state in
            active)
                printf '正在接管远控键盘（物理输入源）'
                ;;
            idle)
                printf '监视中（当前远控窗口未聚焦）'
                ;;
            error)
                printf '异常（详见日志）'
                ;;
            *)
                printf '启动中'
                ;;
        esac
    fi
}

start_keyboard_bridge() {
    local variable
    local -a command

    [[ ${UU_REMOTE_DISABLE_KEYBOARD_BRIDGE:-0} != 1 ]] || return 0
    [[ $desktop_backend == x11 || $desktop_backend == wayland-xwayland ]] || return 0
    [[ -n ${DISPLAY:-} ]] || return 0
    if ! "$keyboard_bridge" check >>"$keyboard_bridge_log" 2>&1; then
        printf '警告：X11/XWayland 远控键盘桥依赖检查失败，详见 %s\n' \
            "$keyboard_bridge_log" >&2
        return 1
    fi
    if systemd_user_available; then
        if runtime_unit_active "$keyboard_runtime_unit"; then
            return
        fi
        systemctl --user reset-failed \
            "$keyboard_runtime_unit.service" >/dev/null 2>&1 || true
        command=(
            systemd-run
            --user
            "--unit=$keyboard_runtime_unit"
            --collect
            --quiet
            --property=Restart=on-failure
            --property=RestartSec=1s
            --property=TimeoutStopSec=5s
            "--property=StandardOutput=append:$keyboard_bridge_log"
            "--property=StandardError=append:$keyboard_bridge_log"
        )
        for variable in \
            DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
            XDG_CURRENT_DESKTOP XDG_SESSION_TYPE PATH; do
            if [[ -v $variable ]]; then
                command+=("--setenv=$variable=${!variable}")
            fi
        done
        command+=(
            "$keyboard_bridge" watch
            "$state_dir"
            "$keyboard_bridge_log"
            "$keyboard_bridge_lock"
            "$keyboard_bridge_interval"
        )
        if "${command[@]}" 9>&-; then
            return
        fi
        printf '警告：无法创建键盘桥用户服务，改用兼容后台进程。\n' >&2
    fi
    # The bridge writes structured state to this log while its uncaught
    # stdout/stderr are appended to the same file as a crash fallback.
    # shellcheck disable=SC2094
    nohup "$keyboard_bridge" watch \
        "$state_dir" \
        "$keyboard_bridge_log" \
        "$keyboard_bridge_lock" \
        "$keyboard_bridge_interval" \
        9>&- </dev/null >>"$keyboard_bridge_log" 2>&1 &
}

start_update_bridge() {
    local launcher_path active_version=""

    [[ ${UU_REMOTE_DISABLE_UPDATE_WATCHER:-0} != 1 ]] || return 0
    launcher_path=$(resolve_launcher_path) || {
        printf '警告：无法确定启动器绝对路径，自动更新兼容桥未运行。\n' >&2
        return
    }
    if systemd_user_available; then
        if runtime_unit_active "$update_runtime_unit"; then
            # A bridge started by an older package may not have written the
            # versioned status file yet.  Missing migration state must be
            # treated as an unknown version, not as a fatal launcher error
            # under `set -e -o pipefail`.
            if [[ -r $update_bridge_status ]]; then
                active_version=$(sed -n 's/^package_version=//p' \
                    "$update_bridge_status" | head -n1 || true)
            fi
            if [[ $active_version == "$package_version" ]]; then
                return
            fi
            stop_update_bridge_runtime
        fi
        systemctl --user reset-failed \
            "$update_runtime_unit.service" >/dev/null 2>&1 || true
        if systemd-run \
            --user \
            "--unit=$update_runtime_unit" \
            --collect \
            --quiet \
            --property=Restart=on-failure \
            --property=RestartSec=5s \
            "--property=StandardOutput=append:$update_bridge_log" \
            "--property=StandardError=append:$update_bridge_log" \
            "$update_bridge" watch \
            "$client_setting_file" \
            "$launcher_path" \
            "$update_bridge_log" \
            "$update_bridge_lock" \
            "$update_bridge_interval" \
            "$upstream_update_request" \
            "$update_bridge_status" \
            "$package_version" \
            9>&-; then
            return
        fi
        printf '警告：无法创建自动更新用户服务，改用兼容后台进程。\n' >&2
    fi
    nohup "$update_bridge" watch \
        "$client_setting_file" \
        "$launcher_path" \
        "$update_bridge_log" \
        "$update_bridge_lock" \
        "$update_bridge_interval" \
        "$upstream_update_request" \
        "$update_bridge_status" \
        "$package_version" \
        9>&- </dev/null >/dev/null 2>&1 &
}

tray_proxy_dependencies_ready() {
    [[ -x $tray_proxy ]] &&
        "$tray_proxy" --check >/dev/null 2>&1
}

tray_proxy_status_label() {
    local status="" backend="" detail="" key value

    if [[ ! -x $tray_proxy ]]; then
        printf '缺失'
        return
    fi
    if ! tray_proxy_dependencies_ready; then
        printf '依赖缺失'
        return
    fi
    if runtime_unit_active "$tray_runtime_unit"; then
        printf '生效中（原生 StatusNotifierItem）'
        return
    fi
    if [[ -r $tray_proxy_status ]]; then
        while IFS='=' read -r key value; do
            case $key in
                status)
                    status=$value
                    ;;
                backend)
                    backend=$value
                    ;;
                detail)
                    detail=$value
                    ;;
            esac
        done <"$tray_proxy_status"
    fi
    case $status in
        active)
            printf '生效中（%s）' "${backend:-原生托盘}"
            ;;
        error)
            printf '异常：%s' "${detail:-详见日志}"
            ;;
        *)
            printf '就绪（待应用启动）'
            ;;
    esac
}

start_tray_proxy() {
    local launcher_path wine_path variable
    local -a proxy_command systemd_command

    [[ ${UU_REMOTE_DISABLE_TRAY_PROXY:-0} != 1 ]] || return 0
    [[ ${UU_REMOTE_TRAY_PROXY_CHILD:-0} != 1 ]] || return 0
    tray_proxy_dependencies_ready || {
        printf '警告：原生托盘代理依赖不完整，详见诊断输出。\n' >&2
        return 1
    }
    launcher_path=$(resolve_launcher_path) || {
        printf '警告：无法确定启动器绝对路径，原生托盘代理未运行。\n' >&2
        return 1
    }
    proxy_command=(
        "$tray_proxy"
        --prefix "$prefix"
        --launcher "$launcher_path"
        --state-dir "$state_dir"
        --log-file "$tray_proxy_log"
        --window-layout-file "$window_layout_file"
        --monitor-selection-file "$controlled_monitor_file"
        --icon "$app_id"
    )
    if systemd_user_available; then
        if runtime_unit_active "$tray_runtime_unit"; then
            return
        fi
        systemctl --user stop \
            "$tray_exit_runtime_unit.service" >/dev/null 2>&1 || true
        systemctl --user reset-failed \
            "$tray_runtime_unit.service" \
            "$tray_exit_runtime_unit.service" >/dev/null 2>&1 || true
        wine_path=$(command -v -- "$wine" || true)
        systemd_command=(
            systemd-run
            --user
            "--unit=$tray_runtime_unit"
            --collect
            --quiet
            --property=Restart=on-failure
            --property=RestartSec=2s
            "--property=StandardOutput=append:$tray_proxy_log"
            "--property=StandardError=append:$tray_proxy_log"
            "--setenv=WINEPREFIX=$prefix"
        )
        for variable in \
            DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR \
            DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP PATH; do
            if [[ -v $variable ]]; then
                systemd_command+=("--setenv=$variable=${!variable}")
            fi
        done
        [[ -n $wine_path ]] &&
            systemd_command+=("--setenv=UU_REMOTE_WINE_BIN=$wine_path")
        systemd_command+=("${proxy_command[@]}")
        if "${systemd_command[@]}" 9>&-; then
            return
        fi
        printf '警告：无法创建原生托盘用户服务，改用兼容后台进程。\n' >&2
    fi
    nohup "${proxy_command[@]}" 9>&- </dev/null \
        >>"$tray_proxy_log" 2>&1 &
}

systemd_user_available() {
    [[ ${UU_REMOTE_DISABLE_SYSTEMD_RUNTIME:-0} != 1 ]] &&
        command -v systemctl >/dev/null 2>&1 &&
        command -v systemd-run >/dev/null 2>&1 &&
        timeout 3s systemctl --user show-environment >/dev/null 2>&1
}

runtime_unit_active() {
    local unit=$1

    systemd_user_available &&
        systemctl --user is-active --quiet "$unit.service" >/dev/null 2>&1
}

runtime_supervisor_label() {
    if ! systemd_user_available; then
        printf '不可用（将使用兼容启动）'
    elif runtime_unit_active "$server_runtime_unit" &&
        runtime_unit_active "$healthd_runtime_unit"; then
        printf 'Server/Healthd 生效中'
    elif runtime_unit_active "$server_runtime_unit" ||
        runtime_unit_active "$healthd_runtime_unit"; then
        printf '部分生效'
    else
        printf '待应用启动'
    fi
}

update_runtime_label() {
    if [[ ! -x $update_bridge ]]; then
        printf '缺失'
    elif runtime_unit_active "$update_runtime_unit"; then
        printf '监视中'
    elif systemd_user_available; then
        printf '就绪（待应用启动）'
    else
        printf '就绪（兼容后台模式）'
    fi
}

stop_update_bridge_runtime() {
    systemd_user_available || return 0
    systemctl --user stop \
        "$update_runtime_unit.service" >/dev/null 2>&1 || true
    systemctl --user reset-failed \
        "$update_runtime_unit.service" >/dev/null 2>&1 || true
}

stop_hwencode_policy_runtime() {
    systemd_user_available || return 0
    systemctl --user stop \
        "$hwencode_policy_runtime_unit.service" >/dev/null 2>&1 || true
    systemctl --user reset-failed \
        "$hwencode_policy_runtime_unit.service" >/dev/null 2>&1 || true
}

stop_tray_proxy_runtime() {
    local pid="" key value cmdline=""
    local -a tray_units=("$tray_runtime_unit.service")

    # The native tray launches --stop from the transient tray-exit unit.  A
    # process running inside that unit must never ask systemd to stop its own
    # unit: systemd would terminate the helper before it reaches wineserver -k,
    # leaving UU alive in a half-finished exit state.
    if [[ ${UU_REMOTE_TRAY_EXIT_HELPER:-0} != 1 ]]; then
        tray_units+=("$tray_exit_runtime_unit.service")
    fi

    if systemd_user_available; then
        systemctl --user stop "${tray_units[@]}" >/dev/null 2>&1 || true
        systemctl --user reset-failed \
            "${tray_units[@]}" >/dev/null 2>&1 || true
    fi
    if [[ -r $tray_proxy_status ]]; then
        while IFS='=' read -r key value; do
            [[ $key == pid ]] && pid=$value
        done <"$tray_proxy_status"
    fi
    [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]] || return 0
    cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    if [[ $cmdline == *"$tray_proxy"* && $cmdline == *"$prefix"* ]]; then
        kill "$pid" >/dev/null 2>&1 || true
    fi
}

stop_managed_runtime_services() {
    local pid="" cmdline=""

    stop_input_bridge_runtime
    stop_hwencode_policy_runtime
    if systemd_user_available; then
        systemctl --user stop \
            "$client_runtime_unit.service" \
            "$server_runtime_unit.service" \
            "$healthd_runtime_unit.service" \
            "$keyboard_runtime_unit.service" \
            "$input_runtime_unit.service" \
            "$input_injector_runtime_unit.service" \
            "$focus_injector_runtime_unit.service" >/dev/null 2>&1 || true
        systemctl --user reset-failed \
            "$client_runtime_unit.service" \
            "$server_runtime_unit.service" \
            "$healthd_runtime_unit.service" \
            "$keyboard_runtime_unit.service" \
            "$input_runtime_unit.service" \
            "$input_injector_runtime_unit.service" \
            "$focus_injector_runtime_unit.service" >/dev/null 2>&1 || true
    fi
    if [[ -r $keyboard_bridge_status ]]; then
        pid=$(sed -n 's/.*"pid": \([0-9][0-9]*\).*/\1/p' \
            "$keyboard_bridge_status" | head -n1)
    fi
    if [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]]; then
        cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
        if [[ $cmdline == *"$keyboard_bridge"* ]]; then
            kill "$pid" >/dev/null 2>&1 || true
        fi
    fi
    if [[ -x $keyboard_bridge ]]; then
        "$keyboard_bridge" restore \
            "$state_dir" "$keyboard_bridge_log" >/dev/null 2>&1 || true
    fi
}

start_systemd_decoder_restart() {
    local launcher_path variable attempt load_state
    local -a command

    launcher_path=$(resolve_launcher_path) || return 1
    systemctl --user stop \
        "$client_runtime_unit.service" >/dev/null 2>&1 || true
    systemctl --user reset-failed \
        "$client_runtime_unit.service" >/dev/null 2>&1 || true
    # A stopped transient unit can remain loaded until systemd finishes
    # collecting its Wine cgroup.  TimeoutStopSec is 15 seconds, so wait
    # longer than that before reusing the stable client unit name.
    for ((attempt = 0; attempt < 200; attempt++)); do
        load_state=$(systemctl --user show \
            --property=LoadState \
            --value \
            "$client_runtime_unit.service" 2>/dev/null || true)
        if [[ -z $load_state || $load_state == not-found ]]; then
            break
        fi
        sleep 0.1
    done
    ((attempt < 200)) || return 1

    command=(
        systemd-run
        --user
        "--unit=$client_runtime_unit"
        --collect
        --quiet
        --property=ExitType=cgroup
        --property=TimeoutStopSec=15s
        "--property=StandardOutput=append:$runtime_log"
        "--property=StandardError=append:$runtime_log"
        "--working-directory=$install_dir"
        "--setenv=WINEPREFIX=$WINEPREFIX"
        "--setenv=WINEDEBUG=$WINEDEBUG"
    )
    for variable in \
        DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR \
        DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP PATH \
        http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY; do
        if [[ -v $variable ]]; then
            command+=("--setenv=$variable=${!variable}")
        fi
    done
    command+=("$launcher_path" --restart-selected-decoder)
    "${command[@]}" 9>&-
}

start_systemd_client_launch() {
    local wine_path variable attempt load_state
    local -a command

    wine_path=$(command -v -- "$wine") || return 1

    # The outer GameViewer.exe is only a launcher: it creates
    # bin/GameViewer.exe and exits successfully.  Keep the transient unit
    # alive until the entire Wine cgroup exits, otherwise systemd tears down
    # the real Qt client as soon as the short-lived launcher returns.
    if runtime_unit_active "$client_runtime_unit" &&
        wine_image_running "$client_image"; then
        env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
            -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
            -u ALL_PROXY -u NO_PROXY \
            "$wine_path" "$client" "$@" 9>&-
        return
    fi

    systemctl --user stop \
        "$client_runtime_unit.service" >/dev/null 2>&1 || true
    systemctl --user reset-failed \
        "$client_runtime_unit.service" >/dev/null 2>&1 || true
    for ((attempt = 0; attempt < 200; attempt++)); do
        load_state=$(systemctl --user show \
            --property=LoadState \
            --value \
            "$client_runtime_unit.service" 2>/dev/null || true)
        if [[ -z $load_state || $load_state == not-found ]]; then
            break
        fi
        sleep 0.1
    done
    ((attempt < 200)) || return 1

    command=(
        systemd-run
        --user
        "--unit=$client_runtime_unit"
        --collect
        --quiet
        --property=ExitType=cgroup
        --property=TimeoutStopSec=15s
        "--property=StandardOutput=append:$runtime_log"
        "--property=StandardError=append:$runtime_log"
        "--working-directory=$install_dir"
        "--setenv=WINEPREFIX=$WINEPREFIX"
        "--setenv=WINEDEBUG=$WINEDEBUG"
    )
    for variable in \
        WINEDLLOVERRIDES WINEDLLPATH DXVK_LOG_LEVEL DXVK_CONFIG_FILE \
        UU_REMOTE_CUDA_DEVICE UU_REMOTE_NVENC_ADAPTER_LUID \
        DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR \
        DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP PATH; do
        if [[ -v $variable ]]; then
            command+=("--setenv=$variable=${!variable}")
        fi
    done
    command+=(
        env
        -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy -u no_proxy
        -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY -u ALL_PROXY -u NO_PROXY
        "$wine_path" "$client" "$@"
    )
    "${command[@]}" 9>&-
}

wol_enabled() {
    [[ -r $wol_enabled_stamp ]]
}

wol_server_sha() {
    [[ -f $server ]] || return 1
    file_sha256 "$server"
}

clear_wol_profile() {
    wol_profile_version=""
    wol_profile_source=""
    wol_profile_original_sha=""
    wol_profile_patched_sha=""
    wol_profile_patch_offset=0
    wol_profile_patch_before=""
    wol_profile_patch_after=""
}

load_wol_profile() {
    local requested_version=${1:-} requested_sha=${2:-}
    local row_version original_sha patched_sha offset before after
    local profile_file source override_version found=false

    requested_sha=${requested_sha,,}
    if [[ -n $wol_profile_version &&
        (-z $requested_version || $wol_profile_version == "$requested_version") &&
        (-z $requested_sha || $requested_sha == "$wol_profile_original_sha" ||
            $requested_sha == "$wol_profile_patched_sha") ]]; then
        return 0
    fi
    clear_wol_profile

    override_version=${UU_REMOTE_WOL_SERVER_VERSION:-$requested_version}
    if [[ -n $override_version &&
        -n ${UU_REMOTE_WOL_SERVER_ORIGINAL_SHA:-} &&
        -n ${UU_REMOTE_WOL_SERVER_PATCHED_SHA:-} ]]; then
        row_version=$override_version
        original_sha=$UU_REMOTE_WOL_SERVER_ORIGINAL_SHA
        patched_sha=$UU_REMOTE_WOL_SERVER_PATCHED_SHA
        offset=${UU_REMOTE_WOL_PATCH_OFFSET:-0x40df20}
        before=${UU_REMOTE_WOL_PATCH_BEFORE:-48895c}
        after=${UU_REMOTE_WOL_PATCH_AFTER:-b001c3}
        source=override
        if [[ (-z $requested_version || $row_version == "$requested_version") &&
            (-z $requested_sha || ${original_sha,,} == "$requested_sha" ||
                ${patched_sha,,} == "$requested_sha") ]]; then
            found=true
        fi
    fi

    if ! $found; then
        for profile_file in \
            "$wol_compatibility_profiles" \
            "$wol_generated_profiles"; do
            [[ -r $profile_file ]] || continue
            if [[ $profile_file == "$wol_generated_profiles" ]]; then
                source=generated
            else
                source=builtin
            fi
            while IFS=$'\t' read -r \
                row_version original_sha patched_sha offset before after; do
                [[ -n $row_version && $row_version != \#* ]] || continue
                [[ -z $requested_version || $row_version == "$requested_version" ]] ||
                    continue
                [[ -z $requested_sha || ${original_sha,,} == "$requested_sha" ||
                    ${patched_sha,,} == "$requested_sha" ]] || continue
                found=true
                break
            done <"$profile_file"
            $found && break
        done
    fi
    $found || return 1
    [[ $row_version =~ ^[0-9]+([.][0-9]+){2,3}$ &&
        $original_sha =~ ^[[:xdigit:]]{64}$ &&
        $patched_sha =~ ^[[:xdigit:]]{64}$ &&
        $offset =~ ^0[xX][[:xdigit:]]+$ &&
        $before =~ ^[[:xdigit:]]{6}$ &&
        ${after,,} == b001c3 ]] || return 1

    wol_profile_version=$row_version
    wol_profile_source=$source
    wol_profile_original_sha=${original_sha,,}
    wol_profile_patched_sha=${patched_sha,,}
    wol_profile_patch_offset=$((offset))
    wol_profile_patch_before=${before,,}
    wol_profile_patch_after=${after,,}
}

load_wol_profile_for_server() {
    local current_sha version

    current_sha=$(wol_server_sha) || return 1
    version=$(registry_value "$installed_version_key" Version 2>/dev/null || true)
    load_wol_profile "$version" "$current_sha" ||
        load_wol_profile "" "$current_sha"
}

generate_wol_profile() {
    local version=$1 row row_version original_sha patched_sha offset before after
    local current_sha temp existing_version existing_original existing_patched
    local existing_offset existing_before existing_after

    [[ -x $wol_profiler && -f $server ]] || return 1
    current_sha=$(wol_server_sha) || return 1
    row=$("$wol_profiler" --derive "$server" --version "$version" \
        2>>"$setup_log") || return 1
    IFS=$'\t' read -r \
        row_version original_sha patched_sha offset before after <<<"$row"
    [[ $row_version == "$version" &&
        ${original_sha,,} == "$current_sha" &&
        $patched_sha =~ ^[[:xdigit:]]{64}$ &&
        $offset =~ ^0[xX][[:xdigit:]]+$ &&
        $before =~ ^[[:xdigit:]]{6}$ &&
        ${after,,} == b001c3 ]] || return 1

    mkdir -p "$data_dir"
    temp=$(mktemp "$data_dir/.wol-generated.XXXXXX")
    printf '# Automatically derived, fail-closed WOL profiles.\n' >"$temp"
    if [[ -r $wol_generated_profiles ]]; then
        while IFS=$'\t' read -r \
            existing_version existing_original existing_patched \
            existing_offset existing_before existing_after; do
            [[ -n $existing_version && $existing_version != \#* ]] || continue
            if [[ $existing_version == "$version" &&
                ${existing_original,,} == "$current_sha" ]]; then
                continue
            fi
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$existing_version" "$existing_original" "$existing_patched" \
                "$existing_offset" "$existing_before" "$existing_after" >>"$temp"
        done <"$wol_generated_profiles"
    fi
    printf '%s\n' "$row" >>"$temp"
    chmod 0600 "$temp"
    mv -f "$temp" "$wol_generated_profiles"
    clear_wol_profile
    load_wol_profile "$version" "$current_sha" || return 1
    printf '已为 UU %s 自动生成并校验 WOL 二进制档案。\n' "$version"
}

ensure_wol_profile() {
    local version=${1:-}

    load_wol_profile_for_server && return 0
    if [[ -z $version ]]; then
        version=$(registry_value "$installed_version_key" Version 2>/dev/null || true)
    fi
    [[ -n $version ]] || return 1
    generate_wol_profile "$version"
}

wol_patch_ready() {
    load_wol_profile_for_server || return 1
    [[ -x $wol_bridge ]] &&
        UU_REMOTE_WOL_PATCH_OFFSET="$wol_profile_patch_offset" \
        UU_REMOTE_WOL_PATCH_BEFORE="$wol_profile_patch_before" \
        UU_REMOTE_WOL_PATCH_AFTER="$wol_profile_patch_after" \
        "$wol_bridge" patched \
            "$server" \
            "$wol_server_original" \
            "$wol_profile_original_sha" \
            "$wol_profile_patched_sha"
}

wol_binary_patch_ready_or_unused() {
    local current_sha

    [[ -f $server ]] || return 1
    if load_wol_profile_for_server; then
        current_sha=$(wol_server_sha) || return 1
        [[ $current_sha == "$wol_profile_patched_sha" ]] && wol_patch_ready
    else
        return 0
    fi
}

deploy_optional_wol_server_patch() {
    local mode=${1:-optional} version

    [[ $mode == optional || $mode == required ]] || return 1

    version=$(registry_value "$installed_version_key" Version 2>/dev/null || true)
    if ! ensure_wol_profile "$version"; then
        if [[ $mode == required ]]; then
            printf '未能为 UU %s 唯一识别 WOL 函数；拒绝接受会丢失 WOL 补丁的新版本。\n' \
                "${version:-unknown}" >>"$setup_log"
            return 1
        fi
        printf '未能为 UU %s 唯一识别 WOL 函数；保留通用 Win32 网卡映射。\n' \
            "${version:-unknown}" >>"$setup_log"
        return 0
    fi
    UU_REMOTE_WOL_PATCH_OFFSET="$wol_profile_patch_offset" \
    UU_REMOTE_WOL_PATCH_BEFORE="$wol_profile_patch_before" \
    UU_REMOTE_WOL_PATCH_AFTER="$wol_profile_patch_after" \
        "$wol_bridge" patch \
            "$server" \
            "$wol_server_original" \
            "$wol_profile_original_sha" \
            "$wol_profile_patched_sha" || return 1
    wol_patch_ready
}

restore_optional_wol_server_patch() {
    local current_sha

    current_sha=$(wol_server_sha) || return 0
    load_wol_profile_for_server || return 0
    [[ $current_sha == "$wol_profile_patched_sha" ]] || return 0
    UU_REMOTE_WOL_PATCH_OFFSET="$wol_profile_patch_offset" \
    UU_REMOTE_WOL_PATCH_BEFORE="$wol_profile_patch_before" \
    UU_REMOTE_WOL_PATCH_AFTER="$wol_profile_patch_after" \
        "$wol_bridge" restore \
            "$server" \
            "$wol_server_original" \
            "$wol_profile_original_sha" \
            "$wol_profile_patched_sha"
}

wol_server_compat_label() {
    local current_sha

    if [[ ! -f $server ]]; then
        printf '服务端不存在'
    elif wol_patch_ready; then
        load_wol_profile_for_server || true
        if [[ $wol_profile_source == generated ]]; then
            printf '自适应档案补丁完整（UU %s）' "$wol_profile_version"
        else
            printf '版本档案补丁完整（UU %s）' "$wol_profile_version"
        fi
    elif load_wol_profile_for_server; then
        current_sha=$(wol_server_sha) || true
        if [[ $current_sha == "$wol_profile_original_sha" ]]; then
            printf '已识别 UU %s，WOL 补丁待部署' "$wol_profile_version"
        else
            printf 'UU %s WOL 补丁/备份不匹配' "$wol_profile_version"
        fi
    else
        printf '通用 Win32 网卡映射（自动档案未唯一识别）'
    fi
}

powershell_bridge_ready() {
    [[ -r $powershell_bridge_source &&
        -f $powershell_bridge &&
        -f $powershell_bridge_client ]] &&
        cmp -s "$powershell_bridge_source" "$powershell_bridge" &&
        cmp -s "$powershell_bridge_source" "$powershell_bridge_client"
}

wol_detect_row() {
    if [[ -n ${UU_REMOTE_WOL_DETECT_ROW:-} ]]; then
        printf '%s\n' "$UU_REMOTE_WOL_DETECT_ROW"
        return
    fi
    [[ -x $wol_bridge ]] || return 1
    "$wol_bridge" detect 2>/dev/null
}

wol_native_ipv4() {
    local interface=$1 address

    if [[ -n ${UU_REMOTE_WOL_NATIVE_IP:-} ]]; then
        printf '%s\n' "$UU_REMOTE_WOL_NATIVE_IP"
        return
    fi

    while IFS= read -r address; do
        address=${address%%/*}
        [[ $address =~ ^[0-9]+([.][0-9]+){3}$ ]] || continue
        printf '%s\n' "$address"
        return
    done < <(
        ip -4 -o address show dev "$interface" scope global 2>/dev/null |
            awk '{print $4}'
    )
    return 1
}

wol_reference_ipv4() {
    local route_line

    if [[ -n ${UU_REMOTE_WOL_REFERENCE_IP:-} ]]; then
        printf '%s\n' "$UU_REMOTE_WOL_REFERENCE_IP"
        return
    fi

    route_line=$(ip -4 route get 223.5.5.5 2>/dev/null | head -n1) ||
        return 1
    if [[ $route_line =~ [[:space:]]src[[:space:]]([0-9]+([.][0-9]+){3}) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return
    fi
    return 1
}

write_wol_hook_config() {
    local interface connection mac gateway nm_wol power_wakeup
    local native_ip reference_ip temp

    IFS=$'\t' read -r interface connection mac gateway nm_wol power_wakeup \
        < <(wol_detect_row) || return 1
    native_ip=$(wol_native_ipv4 "$interface") || return 1
    reference_ip=$(wol_reference_ipv4 || true)
    [[ -n $reference_ip ]] || reference_ip=$native_ip
    [[ $gateway =~ ^[0-9]+([.][0-9]+){3}$ ]] || return 1
    [[ $mac =~ ^[[:xdigit:]]{2}(:[[:xdigit:]]{2}){5}$ ]] || return 1

    mkdir -p -- "${wol_hook_config%/*}"
    temp=$(mktemp "${wol_hook_config%/*}/.uu-remote-wol.XXXXXX")
    {
        printf '[wol]\n'
        printf 'enabled=1\n'
        printf 'interface=%s\n' "$interface"
        printf 'reference_ip=%s\n' "$reference_ip"
        printf 'native_ip=%s\n' "$native_ip"
        printf 'gateway=%s\n' "$gateway"
        printf 'mac=%s\n' "$mac"
        if [[ $nm_wol == magic ]]; then
            printf 'native_magic=1\n'
        else
            printf 'native_magic=0\n'
        fi
        if [[ $power_wakeup == enabled ]]; then
            printf 'native_power_wakeup=1\n'
        else
            printf 'native_power_wakeup=0\n'
        fi
    } >"$temp"
    chmod 0600 "$temp"
    mv -f -- "$temp" "$wol_hook_config"
}

wol_hook_config_ready() {
    [[ -r $wol_hook_config ]] &&
        grep -Fqx 'enabled=1' "$wol_hook_config" &&
        grep -Eq '^reference_ip=[0-9]+([.][0-9]+){3}$' "$wol_hook_config" &&
        grep -Eq '^native_ip=[0-9]+([.][0-9]+){3}$' "$wol_hook_config" &&
        grep -Eq '^gateway=[0-9]+([.][0-9]+){3}$' "$wol_hook_config" &&
        grep -Eiq '^mac=[[:xdigit:]]{2}(:[[:xdigit:]]{2}){5}$' \
            "$wol_hook_config" &&
        grep -Fqx 'native_magic=1' "$wol_hook_config" &&
        grep -Fqx 'native_power_wakeup=1' "$wol_hook_config"
}

ini_section_value() {
    local file=$1 section=$2 key=$3

    awk -F= -v wanted_section="$section" -v wanted_key="$key" '
        {
            sub(/\r$/, "")
        }
        /^\[/ {
            active = ($0 == "[" wanted_section "]")
            next
        }
        active && $1 == wanted_key {
            sub(/^[^=]*=/, "")
            print
            exit
        }
    ' "$file" 2>/dev/null
}

controller_focus_hook_live() {
    local version status_bits modified now

    [[ -r $controller_focus_hook_status ]] || return 1
    version=$(ini_section_value \
        "$controller_focus_hook_status" hook version)
    status_bits=$(ini_section_value \
        "$controller_focus_hook_status" hook status_bits)
    [[ $version =~ ^[0-9]+$ && $version -ge 12 ]] || return 1
    [[ $status_bits =~ ^[0-9]+$ ]] || return 1
    # Active tray restore needs a live worker and at least one subclassed Qt
    # window. Some real UU builds do not import every activation API, so the
    # unrelated full activation mask must not disable the fast path.
    if ((version >= 14)); then
        (((status_bits & 947) == 947)) || return 1
    else
        (((status_bits & 48) == 48)) || return 1
    fi
    modified=$(stat -c %Y "$controller_focus_hook_status" 2>/dev/null) || return 1
    printf -v now '%(%s)T' -1
    [[ $modified =~ ^[0-9]+$ && $now =~ ^[0-9]+$ ]] || return 1
    ((modified <= now && now - modified <= 3))
}

controller_focus_ui_state() {
    local version pings_sent pings_acked consecutive hard_stalls ack_age

    controller_focus_hook_live || {
        printf 'unavailable'
        return
    }
    version=$(ini_section_value \
        "$controller_focus_hook_status" hook version)
    pings_sent=$(ini_section_value \
        "$controller_focus_hook_status" ui_health pings_sent)
    pings_acked=$(ini_section_value \
        "$controller_focus_hook_status" ui_health pings_acked)
    consecutive=$(ini_section_value \
        "$controller_focus_hook_status" ui_health consecutive_timeouts)
    hard_stalls=$(ini_section_value \
        "$controller_focus_hook_status" ui_health hard_stalls_detected)
    ack_age=$(ini_section_value \
        "$controller_focus_hook_status" ui_health last_ack_age_ms)
    if [[ $version =~ ^[0-9]+$ && $version -lt 18 ]]; then
        printf 'legacy'
        return
    fi
    if [[ $version =~ ^[0-9]+$ && $version -ge 18 &&
        $pings_sent =~ ^[0-9]+$ && $pings_acked =~ ^[0-9]+$ &&
        $consecutive =~ ^[0-9]+$ && $hard_stalls =~ ^[0-9]+$ ]] &&
        ((consecutive >= 2 && hard_stalls >= 1 &&
            pings_sent > pings_acked)); then
        printf 'hard-stalled'
        return
    fi
    if [[ $version =~ ^[0-9]+$ && $version -ge 18 &&
        $pings_acked =~ ^[0-9]+$ && $pings_acked -ge 1 &&
        $consecutive =~ ^[0-9]+$ && $consecutive -eq 0 &&
        $ack_age =~ ^[0-9]+$ && $ack_age -le 5000 ]]; then
        printf 'healthy'
        return
    fi
    printf 'unknown'
}

wait_controller_focus_ui_state() {
    local attempt state

    for ((attempt = 0; attempt < 30; ++attempt)); do
        state=$(controller_focus_ui_state)
        [[ $state == unknown ]] || {
            printf '%s' "$state"
            return
        }
        sleep 0.1
    done
    printf 'unknown'
}

authorize_controller_home_show() {
    (
        umask 077
        : >"$controller_home_show_request"
    )
}

repaint_controller_home_window() {
    [[ -x $tray_proxy ]] || return 1
    "$tray_proxy" \
        --repaint-home-window \
        --prefix "$prefix" \
        --repaint-delay-ms 2500 \
        </dev/null >>"$tray_proxy_log" 2>&1
}

wol_hook_runtime_label() {
    local version addresses addresses_patched info info_patched
    local if_table2 if_table2_patched

    [[ -r $wol_hook_status ]] || {
        printf '尚无进程实测状态'
        return
    }
    version=$(ini_section_value "$wol_hook_status" hook version)
    addresses=$(ini_section_value "$wol_hook_status" calls addresses)
    addresses_patched=$(ini_section_value "$wol_hook_status" patched addresses)
    info=$(ini_section_value "$wol_hook_status" calls info)
    info_patched=$(ini_section_value "$wol_hook_status" patched info)
    if_table2=$(ini_section_value "$wol_hook_status" calls if_table2)
    if_table2_patched=$(ini_section_value "$wol_hook_status" patched if_table2)
    if [[ -z $version || -z $addresses || -z $addresses_patched ||
        -z $info || -z $info_patched || -z $if_table2 ||
        -z $if_table2_patched ]]; then
        printf '旧版状态（请重启 UU）'
        return
    fi
    printf 'v%s，地址 %s/%s，旧接口 %s/%s，网卡表 %s/%s（修补/调用）' \
        "$version" "$addresses_patched" "$addresses" \
        "$info_patched" "$info" "$if_table2_patched" "$if_table2"
}

powershell_bridge_runtime_label() {
    local version query result

    powershell_bridge_ready || {
        printf '未安装/不匹配'
        return
    }
    [[ -r $powershell_bridge_status ]] || {
        printf '已部署，尚未调用'
        return
    }
    version=$(ini_section_value "$powershell_bridge_status" bridge version)
    query=$(ini_section_value "$powershell_bridge_status" bridge last_query)
    result=$(ini_section_value "$powershell_bridge_status" bridge last_result)
    if [[ -z $version || -z $query || -z $result ]]; then
        printf '状态文件不完整'
        return
    fi
    printf 'v%s，最近 %s=%s' "$version" "$query" "$result"
}

wol_runtime_bridge_ready() {
    wol_binary_patch_ready_or_unused &&
        wol_hook_config_ready &&
        powershell_bridge_ready
}

wol_interface_label() {
    local interface connection mac gateway nm_wol power_wakeup

    IFS=$'\t' read -r interface connection mac gateway nm_wol power_wakeup \
        < <(wol_detect_row) || {
        printf '未检测到可用有线物理网卡'
        return
    }
    printf '%s（%s）' "$interface" "$mac"
}

wol_native_label() {
    local interface connection mac gateway nm_wol power_wakeup

    IFS=$'\t' read -r interface connection mac gateway nm_wol power_wakeup \
        < <(wol_detect_row) || {
        printf '不可用'
        return
    }
    if [[ $nm_wol == magic && $power_wakeup == enabled ]]; then
        printf 'Magic Packet 已配置'
    elif [[ $power_wakeup == enabled ]]; then
        printf '驱动已启用；NetworkManager=%s' "$nm_wol"
    else
        printf '未完成（NetworkManager=%s，PCI=%s）' "$nm_wol" "$power_wakeup"
    fi
}

wol_gateway_label() {
    local interface connection mac gateway nm_wol power_wakeup

    IFS=$'\t' read -r interface connection mac gateway nm_wol power_wakeup \
        < <(wol_detect_row) || {
        printf 'unknown'
        return
    }
    printf '%s' "$gateway"
}

wol_cloud_label() {
    local state

    if [[ ! -x $wol_bridge ]]; then
        printf '未知'
        return
    fi
    state=$("$wol_bridge" cloud-state "$client_log_dir" 2>/dev/null ||
        printf 'unknown')
    case $state in
        enabled)
            printf '已开启'
            ;;
        disabled)
            printf '未开启'
            ;;
        *)
            printf '未知（尚无客户端状态）'
            ;;
    esac
}

configure_native_wol() {
    local interface connection mac gateway nm_wol power_wakeup

    IFS=$'\t' read -r interface connection mac gateway nm_wol power_wakeup \
        < <(wol_detect_row) ||
        die "未检测到使用默认路由的有线物理网卡"
    if [[ $nm_wol == magic && $power_wakeup == enabled ]]; then
        return
    fi
    if ((EUID == 0)); then
        "$wol_configure" enable "$interface" "$connection"
    else
        command -v pkexec >/dev/null 2>&1 ||
            die "缺少 pkexec，无法申请配置网卡所需权限"
        pkexec "$wol_configure" enable "$interface" "$connection" ||
            die "Linux 网卡 WOL 配置未完成"
    fi
}

deploy_wol_powershell_bridge() {
    [[ -r $powershell_bridge_source ]] ||
        die "缺少 Win64 WOL 电源属性兼容桥"
    install -m 0644 "$powershell_bridge_source" "$powershell_bridge" ||
        die "无法部署 UU WOL PowerShell 电源属性兼容桥"
    install -m 0644 \
        "$powershell_bridge_source" "$powershell_bridge_client" ||
        die "无法部署 UU 客户端 WOL PowerShell 电源属性兼容桥"
    powershell_bridge_ready ||
        die "UU WOL PowerShell 电源属性兼容桥部署后核验失败"
}

write_wol_enabled_stamp() {
    local interface connection mac gateway nm_wol power_wakeup

    IFS=$'\t' read -r interface connection mac gateway nm_wol power_wakeup \
        < <(wol_detect_row) || return 1
    {
        printf 'version=2\n'
        printf 'package_version=%s\n' "$package_version"
        if wol_patch_ready; then
            printf 'server_mode=adaptive-binary-patch\n'
            printf 'server_profile=%s\n' "$wol_profile_version"
            printf 'server_profile_source=%s\n' "$wol_profile_source"
        else
            printf 'server_mode=win32-adapter-mapping\n'
        fi
        printf 'interface=%s\n' "$interface"
        printf 'connection=%s\n' "$connection"
        printf 'mac=%s\n' "$mac"
        printf 'configured_at=%(%FT%T%z)T\n' -1
    } >"${wol_enabled_stamp}.tmp"
    chmod 0600 "${wol_enabled_stamp}.tmp"
    mv -f "${wol_enabled_stamp}.tmp" "$wol_enabled_stamp"
}

deploy_wol_bridge() {
    configure_native_wol
    deploy_optional_wol_server_patch ||
        die "UU WOL 自适应服务端补丁部署失败；Linux 网卡设置已保留"
    write_wol_hook_config ||
        die "无法生成 UU WOL 物理网卡映射；Linux 网卡设置已保留"
    deploy_wol_powershell_bridge
    write_wol_enabled_stamp ||
        die "无法记录 UU WOL 自适应档案状态"
}

remove_wol_bridge() {
    restore_optional_wol_server_patch ||
        die "UU WOL 原版文件恢复失败"
    local installed_bridge

    for installed_bridge in \
        "$powershell_bridge" "$powershell_bridge_client"; do
        [[ -f $installed_bridge ]] || continue
        if [[ -r $powershell_bridge_source ]] &&
            cmp -s "$powershell_bridge_source" "$installed_bridge"; then
            rm -f -- "$installed_bridge"
        else
            printf '警告：%s 不是本项目文件，已保留。\n' \
                "$installed_bridge" >&2
        fi
    done
    rm -f -- \
        "$wol_enabled_stamp" \
        "$wol_hook_config" \
        "$powershell_bridge_status"
}

latest_client_log_file() {
    local entry latest=""

    [[ -d $client_log_dir ]] || return 1
    while IFS= read -r entry; do
        latest=${entry#* }
        break
    done < <(
        find "$client_log_dir" -maxdepth 1 -type f -name 'log_*.txt' \
            -printf '%T@ %p\n' 2>/dev/null | sort -nr
    )
    [[ -n $latest ]] || return 1
    printf '%s\n' "$latest"
}

drag_overlay_status_label() {
    local latest

    latest=$(latest_client_log_file) || {
        printf '就绪（尚无远控会话记录）'
        return
    }
    if grep -Eq \
        'RegisterDragDrop failed|DragDropOverlay.*(failed|error)' \
        "$latest" 2>/dev/null; then
        printf '异常（最近一次初始化失败）'
    elif grep -Fq 'DragDropOverlay prepared' "$latest" 2>/dev/null; then
        printf '最近一次远控初始化成功'
    else
        printf '就绪（最近一次会话未触发）'
    fi
}

system_proxy_bridge_label() {
    if [[ ! -x $system_proxy_bridge ]]; then
        printf '缺失'
        return
    fi
    UU_REMOTE_SYSTEM_PROXY_SOURCE="${UU_REMOTE_SYSTEM_PROXY_SOURCE:-none}" \
        "$system_proxy_bridge" describe \
        "$system_proxy_bridge_status" 2>/dev/null ||
        printf '检测失败（详见日志）'
}

sync_linux_system_proxy() {
    [[ ${UU_REMOTE_DISABLE_SYSTEM_PROXY_BRIDGE:-0} != 1 ]] || return 0
    [[ -x $system_proxy_bridge ]] || return 1
    # The bridge intentionally appends its structured result to this log while
    # stderr from the same invocation is captured alongside it.
    # shellcheck disable=SC2094
    UU_REMOTE_SYSTEM_PROXY_SOURCE="${UU_REMOTE_SYSTEM_PROXY_SOURCE:-none}" \
        "$system_proxy_bridge" sync \
        "$prefix" \
        "$wine" \
        "$system_proxy_bridge_status" \
        "$system_proxy_bridge_log" \
        >>"$system_proxy_bridge_log" 2>&1
}

mobile_download_status_label() {
    if path_writable_for_current_user "$mobile_download_dir"; then
        printf '可用（%s）' "$mobile_download_dir"
    elif [[ -e $mobile_download_dir ]]; then
        printf '不可写（%s）' "$mobile_download_dir"
    else
        printf '缺失（%s）' "$mobile_download_dir"
    fi
}

path_writable_for_current_user() {
    local path=$1 mode owner group current_uid current_group

    [[ -d $path ]] || return 1
    [[ -w $path ]] && return 0
    read -r mode owner group < <(stat -Lc '%a %u %g' "$path" 2>/dev/null) ||
        return 1
    current_uid=$(id -u)
    if [[ $owner == "$current_uid" ]] && (( (8#$mode & 0200) != 0 )); then
        return 0
    fi
    if (( (8#$mode & 0020) != 0 )); then
        for current_group in $(id -G); do
            [[ $group == "$current_group" ]] && return 0
        done
    fi
    (( (8#$mode & 0002) != 0 ))
}

hwencode_status_label() {
    if hwencode_disabled; then
        printf '用户已禁用'
    elif hwencode_enabled && hwencode_files_deployed &&
        hwencode_probe_current && hwencode_policy_ready; then
        printf '已启用（NVENC/HEVC 深层验证通过）'
    elif hwencode_failure_current; then
        printf '当前版本验证失败（OpenH264 安全回退）'
    elif hwencode_enabled; then
        printf '已启用但策略待核验'
    else
        printf '等待自动探测'
    fi
}

streamer_compatibility_profile_status_label() {
    local version output

    version=$(registry_value "$installed_version_key" Version 2>/dev/null || true)
    [[ -n $version ]] || {
        printf '未建立（UU 未安装）'
        return
    }
    output=$(streamer_profile_command match-streamer-profile \
        "$streamer_dll" "$version" "$streamer_active_profile" \
        2>/dev/null) || {
        printf '缺失或与当前二进制不匹配'
        return
    }
    if [[ $output == *$'\tportrait=1' ]]; then
        printf '完整（UU %s；NVENC/竖屏）' "$version"
    else
        printf '完整（UU %s；NVENC）' "$version"
    fi
}

hwencode_last_session_label() {
    local latest line

    [[ -d $streamer_log_dir ]] || {
        printf '尚无被控会话日志'
        return
    }
    latest=$(find "$streamer_log_dir" -maxdepth 1 -type f \
        -name 'streamer_log_*.txt' -printf '%T@\t%p\n' 2>/dev/null |
        sort -nr | sed -n '1s/^[^\t]*\t//p')
    [[ -n $latest ]] || {
        printf '尚无被控会话日志'
        return
    }
    line=$(grep '"encoder_impl"' "$latest" 2>/dev/null | tail -n1 || true)
    if [[ $line == *'"encoder_impl":"OpenH264"'* ]]; then
        printf 'OpenH264（需在新会话复验）'
    elif [[ $line == *'"encoder_impl"'* ]]; then
        sed -n 's/.*"encoder_impl":"\([^"]*\)".*/\1/p' <<<"$line"
    else
        printf '日志尚未记录编码器'
    fi
}

mutter_fix_status_label() {
    local status

    if [[ ! -x $mutter_fix_manager ]]; then
        printf '系统级 .deb 未提供'
        return
    fi
    status=$($mutter_fix_manager status --field state 2>/dev/null || true)
    case $status in
        active) printf '已生效' ;;
        installed-pending-logout) printf '已安装，等待注销登录' ;;
        legacy-active|legacy-installed-pending-logout)
            printf '诊断版已生效，可规范化'
            ;;
        rolled-back-pending-logout) printf '已回滚，等待注销登录' ;;
        eligible) printf '可显式安装' ;;
        superseded-or-unknown) printf '检测到更高或未知版本，未修改' ;;
        payload-corrupt) printf '载荷校验失败' ;;
        interrupted-known-partial)
            printf 'Mutter 事务中断，需按文档从 TTY 人工恢复'
            ;;
        partial|recoverable-partial|installed-corrupt|unknown-build)
            printf 'Mutter 状态异常，仅允许显式恢复'
            ;;
        unsupported-*) printf '当前系统不适用' ;;
        *) printf '%s' "${status:-未知}" ;;
    esac
}

print_diagnostics() {
    local os_name="unknown"
    local detected_wine="missing"
    local app_version="not-installed"
    local session_type="${XDG_SESSION_TYPE:-unknown}"
    local display_value="${DISPLAY:-unset}"
    local wayland_value="${WAYLAND_DISPLAY:-unset}"
    local decoder_policy decoder_effective

    decoder_policy=$(saved_decoder_selection || true)
    [[ -n $decoder_policy ]] || decoder_policy="未设置（沿用现有硬解开关）"
    decoder_effective=$(effective_decoder_selection)

    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        os_name="${PRETTY_NAME:-${ID:-unknown}}"
    fi
    if command -v "$wine" >/dev/null 2>&1; then
        detected_wine=$(wine_version 2>/dev/null || printf 'unrecognized')
    fi

    if [[ -f $prefix/system.reg && -x $(command -v "$wine" 2>/dev/null || true) ]]; then
        export WINEPREFIX="$prefix"
        export WINEDEBUG=-all
        app_version=$(registry_value "$installed_version_key" Version || printf 'unknown')
    fi

    printf '%-24s %s\n' \
        "项目版本" "$package_version" \
        "系统" "$os_name" \
        "架构" "$(uname -m)" \
        "会话" "$session_type" \
        "桌面后端" "$desktop_backend" \
        "DISPLAY" "$display_value" \
        "WAYLAND_DISPLAY" "$wayland_value" \
        "Wine" "$detected_wine（要求 $min_wine_version+）" \
        "运行库目录" "$runtime_dir" \
        "Wine 前缀" "$prefix" \
        "前缀状态" "$([[ -f $prefix/system.reg ]] && printf '存在' || printf '未创建')" \
        "UU 版本" "$app_version" \
        "客户端文件" "$(app_files_present && printf '完整' || printf '缺失')" \
        "Wine 服务端兼容" "$(server_windows_driver_compat_enabled && printf '已隔离 Windows 内核驱动' || printf '未启用')" \
        "WebView2" "$(webview_ready && printf '就绪' || printf '未就绪/未安装')" \
        "兼容 DLL" "$(shim_ready && printf '就绪' || printf '未安装/不匹配')" \
        "Linux 系统代理" "$(system_proxy_bridge_label)" \
        "系统代理桥日志" "$system_proxy_bridge_log" \
        "Linux 原生托盘" "$(tray_proxy_status_label)" \
        "原生托盘日志" "$tray_proxy_log" \
        "主控焦点稳定" "$(controller_focus_hook_status_label)" \
        "Wine 主控焦点协议" "$(controller_take_focus_enabled && printf '应用级启用' || printf '未启用')" \
        "远控键盘桥" "$(keyboard_bridge_status_label)" \
        "Wine 本地输入法" "$(controller_xim_disabled && printf '已禁用（远端输入法接管）' || printf '未禁用')" \
        "键盘桥日志" "$keyboard_bridge_log" \
        "被控端原生输入" "$(input_bridge_status_label)" \
        "被控端输入事件" "$(input_bridge_event_label)" \
        "被控端鼠标屏幕" "$(input_bridge_target_label)" \
        "原生光标形状" "$(native_cursor_status_label)" \
        "Wayland 画面桥" "$(wayland_capture_status_label)" \
        "Wayland GDI 画面钩子" "$(wayland_frame_hook_status_label)" \
        "GNOME Wayland 延迟修复" "$(mutter_fix_status_label)" \
        "竖屏原画缩放" "$(portrait_original_quality_status_label)" \
        "自适应语义档案" "$(streamer_compatibility_profile_status_label)" \
        "Wayland 授权恢复" "$([[ -s $state_dir/wayland-portal-restore-token ]] && printf '已保存' || printf '尚未建立')" \
        "Win64 输入钩子" "$(input_hook_ready && printf '完整' || printf '未安装/不匹配')" \
        "输入桥日志" "$input_bridge_log" \
        "NVIDIA 解码库" "$(hwdecode_host_libraries_ready && printf '就绪' || printf '缺失')" \
        "NVIDIA 编码库" "$(hwencode_host_libraries_ready && printf '就绪' || printf '缺失')" \
        "NVENC 编码策略" "$(hwencode_status_label)" \
        "最近被控编码器" "$(hwencode_last_session_label)" \
        "解码设备策略" "$decoder_policy" \
        "实际解码选择" "$decoder_effective" \
        "UU 自启动开关" "$(windows_autostart_enabled && printf '开启' || printf '关闭')" \
        "Linux 自启动项" "$(native_autostart_enabled && printf '已创建' || printf '未创建')" \
        "自启动兼容桥" "$([[ -x $autostart_bridge ]] && printf '就绪' || printf '缺失')" \
        "UU 防休眠开关" "$(uu_remote_prevent_sleep_label)" \
        "Linux 休眠抑制" "$(native_sleep_inhibition_active && printf '生效中' || printf '未生效')" \
        "防休眠兼容桥" "$([[ -x $sleep_bridge ]] && printf '就绪' || printf '缺失')" \
        "UU 内置更新开关" "$(uu_remote_auto_update_enabled && printf '开启' || printf '关闭')" \
        "Linux 自动更新" "每次启动检查，运行期间每 ${update_bridge_interval} 秒检查" \
        "安全更新状态" "$(update_status_label)" \
        "自动更新兼容桥" "$(update_runtime_label)" \
        "官方更新器保护" "$(update_blocker_ready && printf '完整' || printf '未安装/不匹配')" \
        "拖拽发送浮窗" "$(drag_overlay_status_label)" \
        "移动文件接收目录" "$(mobile_download_status_label)" \
        "关闭到托盘接管" "$(tray_proxy_status_label)" \
        "UU 后台进程托管" "$(runtime_supervisor_label)" \
        "WOL 有线网卡" "$(wol_interface_label)" \
        "Linux WOL 状态" "$(wol_native_label)" \
        "WOL 默认网关" "$(wol_gateway_label)" \
        "UU 远程开机开关" "$(wol_cloud_label)" \
        "UU WOL 兼容桥" "$(wol_enabled && printf '已启用' || printf '未启用')" \
        "UU WOL 服务端兼容" "$(wol_server_compat_label)" \
        "WOL Win32 网卡映射" "$(wol_hook_config_ready && printf '完整' || printf '未生成/不匹配')" \
        "WOL 电源属性桥" "$(powershell_bridge_runtime_label)" \
        "WOL 进程实测" "$(wol_hook_runtime_label)" \
        "硬解桥运行库" "$(hwdecode_runtime_ready && printf '完整' || printf '缺失')" \
        "硬解桥开关" "$(hwdecode_enabled && printf '已启用' || printf '未启用')" \
        "硬解桥注入" "$(hwdecode_files_deployed && printf '完整' || printf '未安装/不匹配')" \
        "安装包缓存" "$([[ -f $installer ]] && printf '存在' || printf '不存在')" \
        "设置日志" "$setup_log"

    if [[ $desktop_backend == wayland-incomplete ]]; then
        printf '\n警告：Wayland 会话未检测到 XWayland DISPLAY，Windows 客户端无法显示。\n'
    fi
    if [[ $detected_wine != missing && $detected_wine != unrecognized ]] &&
        ! version_at_least "$detected_wine" "$min_wine_version"; then
        printf '\n警告：Wine 版本过旧。\n'
    fi
}

