        notify_status "检测到 UU 主界面卡死，正在安全恢复主控进程"
        printf '检测到 UU 主界面心跳停止；原生托盘将在确认无被控会话后自动恢复。\n'
        exit 0
    fi
    if $show_requested; then
        if [[ $controller_ui_state != healthy &&
            $controller_ui_state != legacy ]]; then
            notify_status "UU 主界面暂未响应，正在等待安全恢复"
            printf 'UU 主界面未通过真实 UI 心跳检查；已避免向可能卡死的单实例进程继续投递激活请求。\n'
            exit 0
        fi
        authorize_controller_home_show ||
            die "无法授权 UU 自身恢复主界面"
        cd "$install_dir"
        show_result=0
        env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy \
            -u no_proxy -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY \
            -u ALL_PROXY -u NO_PROXY \
            "$wine" "$client" || show_result=$?
        repaint_controller_home_window ||
            printf '警告：无法刷新 UU 主界面的 X11 表面。\n' >&2
        exit "$show_result"
    fi
fi

