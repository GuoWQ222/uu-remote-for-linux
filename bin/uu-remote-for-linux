#!/usr/bin/env bash
set -euo pipefail

readonly app_id="uu-remote-for-linux"
readonly legacy_app_id="uuyc-linux-controller"
readonly app_name="UU 远程（Linux 版本）"
readonly min_wine_version="11.1"
readonly official_installer_url_default="https://api.nrd.nie.163.com/api/v1/release/dl/1?channel=gwqd"
readonly eula_url="https://uuyc.163.com/contact/20240402/40294_1146065.html"

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

resolve_runtime_dir() {
    local candidate

    if [[ -n ${UU_REMOTE_RUNTIME_DIR:-} ]]; then
        printf '%s\n' "$UU_REMOTE_RUNTIME_DIR"
        return
    fi

    for candidate in \
        "$script_dir/../lib/$app_id" \
        "${XDG_DATA_HOME:-$HOME/.local/share}/../lib/$app_id" \
        "$HOME/.local/lib/$app_id" \
        "/usr/local/lib/$app_id" \
        "/usr/lib/$app_id"; do
        if [[ -r "$candidate/wevtapi.dll" && -r "$candidate/package-version" ]]; then
            /usr/bin/readlink -f -- "$candidate"
            return
        fi
    done

    printf '%s\n' "$script_dir/../lib/$app_id"
}

runtime_dir=$(resolve_runtime_dir)
readonly runtime_dir
readonly shim_source="$runtime_dir/wevtapi.dll"
readonly package_version_file="$runtime_dir/package-version"
readonly decoder_selector="$runtime_dir/uu-remote-decoder-selector"
readonly tray_proxy="${UU_REMOTE_TRAY_PROXY_BIN:-$runtime_dir/uu-remote-tray-proxy}"
readonly autostart_bridge="$runtime_dir/uu-remote-autostart-bridge"
readonly sleep_bridge="$runtime_dir/uu-remote-sleep-bridge"
readonly system_proxy_bridge="${UU_REMOTE_SYSTEM_PROXY_BRIDGE_BIN:-$runtime_dir/uu-remote-system-proxy-bridge}"
readonly keyboard_bridge="$runtime_dir/uu-remote-keyboard-bridge"
readonly input_bridge="$runtime_dir/uu-remote-input-bridge"
