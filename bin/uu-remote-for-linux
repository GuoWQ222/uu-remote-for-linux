notify_status() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="$app_name" "$app_name" "$1" >/dev/null 2>&1 || true
    fi
}

die() {
    notify_status "$1"
    printf '错误：%s\n' "$1" >&2
    exit 1
}

network_curl() {
    if [[ ${UU_REMOTE_SYSTEM_PROXY_SOURCE:-none} != none ]]; then
        curl "$@"
        return
    fi

    # UU uses direct networking by default. Bootstrap encrypted DNS with a
    # validated hostname so broken local resolvers cannot prevent access to
    # the official NetEase endpoints.
    env -u http_proxy -u https_proxy -u ftp_proxy -u all_proxy -u no_proxy \
        -u HTTP_PROXY -u HTTPS_PROXY -u FTP_PROXY -u ALL_PROXY -u NO_PROXY \
        curl \
        --doh-url "$direct_doh_url" \
        --resolve "dns.alidns.com:443:$direct_doh_bootstrap" \
        "$@"
}

eula_gui_prompt_allowed() {
    [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] || return 1
    command -v "$zenity_bin" >/dev/null 2>&1 || return 1
    $autostart_launch && return 1
    if $update_check_requested || $stop_requested || $diagnose_requested ||
        $enable_hwdecode || $disable_hwdecode ||
        $enable_hwencode || $disable_hwencode ||
        $enable_wol || $disable_wol ||
        $select_decoder_requested || $select_decoder_restart_requested ||
        $restart_selected_decoder || $list_decoders_requested ||
        [[ -n $decoder_direct_choice ]]; then
        return 1
    fi
    return 0
}

prompt_eula_acceptance() {
    local html_file text_file status=0

    html_file=$(mktemp "$cache_dir/.eula-source.XXXXXX") || return 2
    text_file=$(mktemp "$cache_dir/.eula-text.XXXXXX") || {
        rm -f -- "$html_file"
        return 2
    }
    if ! network_curl --fail --location --silent --show-error --retry 2 \
        --connect-timeout 10 --max-time 30 \
        --output "$html_file" "$eula_url"; then
        rm -f -- "$html_file" "$text_file"
        "$zenity_bin" --error \
            --title='无法加载网易 UU 远程许可协议' \
            --width=560 \
            --text="请检查网络连接后重新启动。也可先在浏览器阅读：\n$eula_url" \
            >/dev/null 2>&1 || true
        return 2
    fi
    if ! /usr/bin/python3 - "$html_file" "$text_file" "$eula_url" <<'PY'
import html
import re
import sys
from html.parser import HTMLParser
from pathlib import Path


class AgreementParser(HTMLParser):
    block_tags = {
        "article", "div", "h1", "h2", "h3", "h4", "li", "p",
        "section", "table", "td", "th", "tr", "ul", "ol",
    }
    void_tags = {
        "area", "base", "br", "col", "embed", "hr", "img", "input",
        "link", "meta", "param", "source", "track", "wbr",
    }

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.depth = 0
        self.parts = []

    def handle_starttag(self, tag, attrs):
        attributes = dict(attrs)
        classes = set(attributes.get("class", "").split())
        if not self.depth and "news-article" in classes:
            self.depth = 1
            return
        if not self.depth:
            return
        if tag == "br":
            self.parts.append("\n")
        elif tag in self.block_tags:
            self.parts.append("\n")
        if tag not in self.void_tags:
            self.depth += 1

    def handle_endtag(self, tag):
        if not self.depth:
            return
        if tag in self.block_tags:
            self.parts.append("\n")
        if tag not in self.void_tags:
            self.depth -= 1

    def handle_data(self, data):
        if self.depth:
            self.parts.append(data)


source_path = Path(sys.argv[1])
output_path = Path(sys.argv[2])
source_url = sys.argv[3]
parser = AgreementParser()
parser.feed(source_path.read_text(encoding="utf-8", errors="replace"))
text = html.unescape("".join(parser.parts)).replace("\xa0", " ")
text = re.sub(r"[ \t\r\f\v]+", " ", text)
text = re.sub(r" *\n *", "\n", text)
text = re.sub(r"\n{3,}", "\n\n", text).strip()
if "网易UU远程软件许可及服务协议" not in text or len(text) < 100:
    raise SystemExit("official agreement body was not found")
output_path.write_text(
    "本协议正文来自网易 UU 远程官方网站。\n"
    f"官方原文：{source_url}\n\n{text}\n",
    encoding="utf-8",
)
PY
    then
        rm -f -- "$html_file" "$text_file"
        "$zenity_bin" --error \
            --title='无法解析网易 UU 远程许可协议' \
            --width=560 \
            --text="官方协议页面格式发生变化，未记录任何接受状态。\n请稍后重试或访问：\n$eula_url" \
            >/dev/null 2>&1 || true
        return 2
    fi

    "$zenity_bin" --text-info \
        --title='网易 UU 远程软件许可及服务协议' \
        --filename="$text_file" \
        --width=900 \
        --height=700 \
        --checkbox='我已阅读并同意上述《网易UU远程软件许可及服务协议》' \
        --ok-label='接受并继续' \
        --cancel-label='拒绝并退出' >/dev/null 2>&1 || status=$?
    rm -f -- "$html_file" "$text_file"
    case $status in
        0) return 0 ;;
        1) return 1 ;;
        *) return 2 ;;
    esac
}

usage() {
    cat <<'EOF'
用法：uu-remote-for-linux [选项] [客户端参数...]

选项：
  --accept-eula        接受网易 UU 远程许可协议后继续
  --setup-only         安装或修复前缀，但不启动客户端
  --repair             强制重新检查和修复前缀
  --refresh-installer  从网易官方接口重新下载最新版安装程序
  --check-update       立即检查并安装网易官方最新版本
  --recover-update-snapshot
                       从最近一次完整回滚点恢复（不联网、不启动）
  --mutter-fix-status  查看 GNOME Wayland 画面延迟修复状态
  --install-mutter-fix 显式安装经过版本锁定的 Mutter 修复
  --rollback-mutter-fix
                       显式恢复随包保存的 Ubuntu 官方 Mutter
  --enable-hwdecode    启用 NVIDIA NVDEC→D3D11 实验兼容桥
  --disable-hwdecode   关闭兼容桥并移除本项目注入的 DLL
  --enable-hwencode    强制启用 NVIDIA NVENC/HEVC 被控端编码桥
  --disable-hwencode   禁用自动 NVENC 并恢复 OpenH264 安全回退
  --enable-wol         配置 Magic Packet 并启用 UU WOL 自适应兼容层
  --disable-wol        关闭 UU WOL 兼容层（保留 Linux 网卡设置）
  --select-decoder     打开 CPU/GPU 解码设备选择窗口
  --select-decoder-and-restart
                       选择解码设备，保存后自动重启 UU
  --list-decoders      在终端列出检测到的解码设备与能力
  --decoder ID         保存指定设备（auto、cpu 或 nvidia:N）
  --show               显示已运行的 UU 主界面
  --autostart          Linux 登录自启动入口（由兼容桥生成）
  --stop               停止此独立 Wine 前缀
  --diagnose           输出只读诊断信息
  --uri URI            打开 uuremote: URI
  --version            输出包装层版本
  -h, --help           显示帮助
EOF
}

