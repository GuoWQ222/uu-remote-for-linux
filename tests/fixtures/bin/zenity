#!/usr/bin/env bash
set -euo pipefail

printf 'ZENITY' >>"${UU_REMOTE_FAKE_TRACE:?}"
printf ' %q' "$@" >>"$UU_REMOTE_FAKE_TRACE"
printf '\n' >>"$UU_REMOTE_FAKE_TRACE"

for argument in "$@"; do
    if [[ $argument == --list ]]; then
        [[ ${UU_REMOTE_FAKE_ZENITY_CANCEL:-0} != 1 ]] || exit 1
        printf '%s\n' "${UU_REMOTE_FAKE_ZENITY_CHOICE:-cpu}"
        exit 0
    fi
done

exit 0
