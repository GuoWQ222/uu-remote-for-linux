#!/usr/bin/env bash
set -euo pipefail

printf 'SYSTEMCTL %s\n' "$*" >>"${UU_REMOTE_FAKE_TRACE:?}"

case "$*" in
    *" show-environment")
        exit 0
        ;;
    *" show --property=LoadState --value uu-remote-for-linux-client.service")
        printf 'not-found\n'
        exit 0
        ;;
    *" is-active "*)
        requested_unit=${!#}
        case " ${UU_REMOTE_FAKE_ACTIVE_UNITS:-} " in
            *" $requested_unit "*)
                exit 0
                ;;
        esac
        exit 1
        ;;
    *)
        exit 0
        ;;
esac
