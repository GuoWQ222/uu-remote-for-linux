#!/usr/bin/env bash
set -euo pipefail

printf 'SYSTEMCTL %s\n' "$*" >>"${UU_REMOTE_FAKE_TRACE:?}"

case "$*" in
    *" show-environment")
        exit 0
        ;;
    *" show --property=LoadState --value uu-remote-for-linux-client.service")
        printf 'not-found\n'
        exit 0
        ;;
    *" is-active "*)
        exit 1
        ;;
    *)
        exit 0
        ;;
esac
