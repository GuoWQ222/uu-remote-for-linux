#!/usr/bin/env bash
set -euo pipefail

printf 'SYSTEMD_RUN %s\n' "$*" >>"${UU_REMOTE_FAKE_TRACE:?}"

if [[ ${UU_REMOTE_FAKE_SYSTEMD_RUN_NOEXEC:-0} == 1 ]]; then
    exit 0
fi

# Real systemd-run returns after dispatching this long-lived watcher.  Running
# it synchronously in the fixture would block the integration test forever.
if [[ $* == *"uu-remote-encoder-policy watch"* ]]; then
    exit 0
fi

workdir=
declare -a environment=()
while (($# > 0)); do
    case $1 in
        --setenv=*)
            environment+=("${1#--setenv=}")
            shift
            ;;
        --working-directory=*)
            workdir=${1#--working-directory=}
            shift
            ;;
        --*)
            shift
            ;;
        *)
            break
            ;;
    esac
done

((${#environment[@]} > 0)) || environment=()
if [[ -n $workdir ]]; then
    cd "$workdir"
fi
env "${environment[@]}" "$@"
