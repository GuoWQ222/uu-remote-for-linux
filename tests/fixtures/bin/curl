#!/usr/bin/env bash
set -euo pipefail

output_file=""
head_only=false
request_url=""
latest_version=${UU_REMOTE_FAKE_LATEST_VERSION:-4.34.0.8979}
effective_url="https://a56.gdl.netease.com/UURemote_Setup_${latest_version}_0723104500_gwqd.exe?test=1"

case ${UU_REMOTE_FAKE_CURL_FAILURE:-} in
    dns)
        printf 'curl: (6) Could not resolve host: api.nrd.nie.163.com\n' >&2
        exit 6
        ;;
    dns-timeout)
        printf 'curl: (28) Resolving timed out after 15000 milliseconds\n' >&2
        exit 28
        ;;
    proxy)
        printf 'curl: (5) Could not resolve proxy: proxy.invalid\n' >&2
        exit 5
        ;;
    connect)
        printf 'curl: (7) Failed to connect to api.nrd.nie.163.com port 443\n' >&2
        exit 7
        ;;
    tls)
        printf '%s\n' \
            'curl: (60) SSL certificate problem: unable to get local issuer certificate' >&2
        exit 60
        ;;
    http)
        printf 'curl: (22) The requested URL returned error: 503\n' >&2
        exit 22
        ;;
    reset)
        printf 'curl: (56) Recv failure: Connection reset by peer\n' >&2
        exit 56
        ;;
    version-format)
        effective_url='https://a56.gdl.netease.com/UURemote_Setup_latest_gwqd.exe?test=1'
        ;;
    '')
        ;;
    *)
        printf '未知的模拟 curl 故障：%s\n' "$UU_REMOTE_FAKE_CURL_FAILURE" >&2
        exit 2
        ;;
esac

if [[ -e /proc/$$/fd/9 ]]; then
    printf 'FD9_LEAK curl %s\n' "$*" >>"${UU_REMOTE_FAKE_TRACE:?}"
fi

while (($# > 0)); do
    case $1 in
        --head)
            head_only=true
            ;;
        --output)
            shift
            output_file=${1:?}
            ;;
        http://*|https://*)
            request_url=$1
            ;;
    esac
    shift
done

if ! $head_only; then
    [[ -n $output_file ]]
    if [[ $request_url == *'/contact/20240402/40294_1146065.html' ]]; then
        printf 'EULA_FETCH\n' >>"${UU_REMOTE_FAKE_TRACE:?}"
        printf '%s\n' \
            '<!doctype html><html><body>' \
            '<div class="news-article">' \
            '<h1>网易UU远程软件许可及服务协议</h1>' \
            '<p>本版更新时间：【2024】年【3】月【29】日</p>' \
            '<p>请用户认真阅读本协议全部条款。用户点击接受并继续，表示已经阅读、理解并同意本协议。</p>' \
            '<p>1、软件许可。用户应依法使用网易UU远程软件及服务。</p>' \
            '<p>2、用户责任。用户应妥善保管账号并遵守适用法律及本协议约定。</p>' \
            '<p>3、其他。完整内容以网易UU远程官方网站公布的协议为准。</p>' \
            '</div></body></html>' >"$output_file"
        exit 0
    fi
    printf 'MZ' >"$output_file"
    truncate -s 11534336 "$output_file"
fi
printf '%s' "$effective_url"
