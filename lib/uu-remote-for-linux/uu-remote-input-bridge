class XTestBackend:
    name = "x11-xtest"

    def __init__(self, monitor_selection_path: Path | None = None) -> None:
        self.monitor_selection_path = monitor_selection_path
        self.x11 = ctypes.CDLL(
            os.environ.get("UU_REMOTE_INPUT_BRIDGE_X11_LIBRARY", "libX11.so.6")
        )
        self.xtst = ctypes.CDLL(
            os.environ.get("UU_REMOTE_INPUT_BRIDGE_XTEST_LIBRARY", "libXtst.so.6")
        )
        try:
            self.xfixes = ctypes.CDLL(
                os.environ.get(
                    "UU_REMOTE_INPUT_BRIDGE_XFIXES_LIBRARY",
                    "libXfixes.so.3",
                )
            )
        except OSError:
            self.xfixes = None
        self._configure_signatures()
        display_name = os.environ.get("DISPLAY")
        encoded = display_name.encode() if display_name else None
        self.display = self.x11.XOpenDisplay(encoded)
        if not self.display:
            raise RuntimeError(
                f"无法连接 X11 DISPLAY：{display_name or 'unset'}"
            )
        self.screen = self.x11.XDefaultScreen(self.display)
        event_base = ctypes.c_int()
        error_base = ctypes.c_int()
        major = ctypes.c_int()
        minor = ctypes.c_int()
        if not self.xtst.XTestQueryExtension(
            self.display,
            ctypes.byref(event_base),
            ctypes.byref(error_base),
            ctypes.byref(major),
            ctypes.byref(minor),
        ):
            self.close()
            raise RuntimeError("当前 X11 服务器不支持 XTEST 扩展")
        if self.xfixes is not None:
            xfixes_event = ctypes.c_int()
            xfixes_error = ctypes.c_int()
            if not self.xfixes.XFixesQueryExtension(
                self.display,
                ctypes.byref(xfixes_event),
                ctypes.byref(xfixes_error),
            ):
                self.xfixes = None
        self.absolute_geometry = self.virtual_desktop_geometry()
        self.virtual_geometry = self.absolute_geometry
        self.absolute_geometry_source = "virtual-desktop-fallback"
        self.cursor_feedback_geometry = self.absolute_geometry
        self.geometry_checked_at = 0.0
        self.refresh_absolute_geometry(force=True)

    def _configure_signatures(self) -> None:
        self.x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        self.x11.XOpenDisplay.restype = ctypes.c_void_p
        self.x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
        self.x11.XFree.argtypes = [ctypes.c_void_p]
        self.x11.XFree.restype = ctypes.c_int
        self.x11.XDefaultScreen.argtypes = [ctypes.c_void_p]
        self.x11.XDefaultScreen.restype = ctypes.c_int
        self.x11.XDisplayWidth.argtypes = [ctypes.c_void_p, ctypes.c_int]
        self.x11.XDisplayWidth.restype = ctypes.c_int
        self.x11.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
        self.x11.XDisplayHeight.restype = ctypes.c_int
        self.x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
        self.x11.XStringToKeysym.restype = ctypes.c_ulong
        self.x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        self.x11.XKeysymToKeycode.restype = ctypes.c_ubyte
        self.x11.XkbGetIndicatorState.argtypes = [
            ctypes.c_void_p,
            ctypes.c_uint,
            ctypes.POINTER(ctypes.c_uint),
        ]
        self.x11.XkbGetIndicatorState.restype = ctypes.c_int
        self.x11.XFlush.argtypes = [ctypes.c_void_p]

        self.xtst.XTestQueryExtension.argtypes = [
            ctypes.c_void_p,
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_int),
        ]
        self.xtst.XTestQueryExtension.restype = ctypes.c_int
        self.xtst.XTestFakeMotionEvent.argtypes = [
            ctypes.c_void_p,
            ctypes.c_int,
            ctypes.c_int,
            ctypes.c_int,
            ctypes.c_ulong,
        ]
        self.xtst.XTestFakeMotionEvent.restype = ctypes.c_int
        self.xtst.XTestFakeRelativeMotionEvent.argtypes = [
            ctypes.c_void_p,
            ctypes.c_int,
            ctypes.c_int,
            ctypes.c_ulong,
        ]
        self.xtst.XTestFakeRelativeMotionEvent.restype = ctypes.c_int
        self.xtst.XTestFakeButtonEvent.argtypes = [
            ctypes.c_void_p,
            ctypes.c_uint,
            ctypes.c_int,
            ctypes.c_ulong,
        ]
        self.xtst.XTestFakeButtonEvent.restype = ctypes.c_int
        self.xtst.XTestFakeKeyEvent.argtypes = [
            ctypes.c_void_p,
            ctypes.c_uint,
            ctypes.c_int,
            ctypes.c_ulong,
        ]
        self.xtst.XTestFakeKeyEvent.restype = ctypes.c_int

        if self.xfixes is not None:
            self.xfixes.XFixesQueryExtension.argtypes = [
                ctypes.c_void_p,
                ctypes.POINTER(ctypes.c_int),
                ctypes.POINTER(ctypes.c_int),
            ]
            self.xfixes.XFixesQueryExtension.restype = ctypes.c_int
            self.xfixes.XFixesGetCursorImage.argtypes = [ctypes.c_void_p]
            self.xfixes.XFixesGetCursorImage.restype = ctypes.POINTER(
                XFixesCursorImage
            )

    def close(self) -> None:
        if getattr(self, "display", None):
            self.x11.XCloseDisplay(self.display)
            self.display = None

    def flush(self) -> None:
        self.x11.XFlush(self.display)

    def virtual_desktop_geometry(self) -> tuple[int, int, int, int]:
        return (
            0,
            0,
            max(self.x11.XDisplayWidth(self.display, self.screen), 1),
            max(self.x11.XDisplayHeight(self.display, self.screen), 1),
        )

    def refresh_absolute_geometry(self, force: bool = False) -> None:
        now = time.monotonic()
        if (
            not force
            and now - self.geometry_checked_at
            < X11_MONITOR_REFRESH_SECONDS
        ):
            return
        self.geometry_checked_at = now
        self.virtual_geometry = self.virtual_desktop_geometry()
        selected = x11_selected_monitor(self.monitor_selection_path)
        if selected is not None:
            monitor_id, geometry, feedback_geometry = selected
            self.absolute_geometry = geometry
            self.absolute_geometry_source = f"monitor:{monitor_id}"
            self.cursor_feedback_geometry = feedback_geometry
        else:
            self.absolute_geometry = self.virtual_geometry
            self.absolute_geometry_source = "virtual-desktop-fallback"
            self.cursor_feedback_geometry = self.absolute_geometry

    def motion(
        self,
        dx: int,
        dy: int,
        absolute: bool,
        virtual_desktop: bool = False,
    ) -> None:
        if absolute:
            self.refresh_absolute_geometry()
            geometry = (
                self.virtual_geometry
                if virtual_desktop
                else self.absolute_geometry
            )
            x, y = map_absolute_point(dx, dy, geometry)
            result = self.xtst.XTestFakeMotionEvent(
                self.display, self.screen, x, y, 0
            )
        else:
            result = self.xtst.XTestFakeRelativeMotionEvent(
                self.display, dx, dy, 0
            )
        if not result:
            raise RuntimeError("XTest 鼠标移动注入失败")

    def button(self, button: int, pressed: bool) -> None:
        if not self.xtst.XTestFakeButtonEvent(
            self.display, button, int(pressed), 0
        ):
            raise RuntimeError(f"XTest 鼠标按钮 {button} 注入失败")

    def keycode(self, keycode: int, pressed: bool) -> None:
        if not 8 <= keycode <= 255:
            raise ValueError(f"无效 X11 键码：{keycode}")
        if not self.xtst.XTestFakeKeyEvent(
            self.display, keycode, int(pressed), 0
        ):
            raise RuntimeError(f"XTest 键盘键码 {keycode} 注入失败")

    def lock_mask(self) -> int | None:
        indicators = ctypes.c_uint()
        if self.x11.XkbGetIndicatorState(
            self.display,
            XKB_USE_CORE_KBD,
            ctypes.byref(indicators),
        ) != 0:
            return None
        # XKB core indicators 0/1/2 are Caps/Num/Scroll Lock.  Restrict the
        # published value to the three Win32 toggle keys mirrored by the hook.
        return int(indicators.value & 0x7)

    def keysym_keycode(self, name: str) -> int:
        keysym = self.x11.XStringToKeysym(name.encode("ascii"))
        if not keysym:
            return 0
        return int(self.x11.XKeysymToKeycode(self.display, keysym))

    def cursor_image(self) -> tuple[int, int, int, int, int, bytes] | None:
        if self.xfixes is None:
            return None
        image_pointer = self.xfixes.XFixesGetCursorImage(self.display)
        if not image_pointer:
            return None
        try:
            image = image_pointer.contents
            width = int(image.width)
            height = int(image.height)
            hot_x = int(image.xhot)
            hot_y = int(image.yhot)
            if (
                not 1 <= width <= CURSOR_MAX_DIMENSION
                or not 1 <= height <= CURSOR_MAX_DIMENSION
                or hot_x >= width
                or hot_y >= height
            ):
                return None
            count = width * height
            pixels = struct.pack(
                f"<{count}I",
                *(int(image.pixels[index]) & 0xFFFFFFFF for index in range(count)),
            )
            return (
                int(image.cursor_serial),
                width,
                height,
                hot_x,
                hot_y,
                pixels,
            )
        finally:
            self.x11.XFree(image_pointer)


class PortalRequestError(RuntimeError):
    """A denied, cancelled, or failed desktop-portal request."""


class WaylandPortalBackend:
    """Wayland keyboard and pointer injection through XDG RemoteDesktop."""

    name = "wayland-portal"

    def __init__(self, state_dir: Path, frame_path: Path) -> None:
        self.state_dir = state_dir
        self.frame_path = frame_path
        self.restore_token_path = state_dir / "wayland-portal-restore-token"
        self.session_handle = ""
        self.stream_node = 0
        self.stream_width = 1
        self.stream_height = 1
        self.capture_state = "inactive"
        self.capture_pipeline = None
        self.capture_pipewire_fd = -1
        self.capture_frames = 0
        self.capture_map = None
        self.capture_frame_size = 0
        self.capture_backing_path = None
        self.fake_trace = os.environ.get(
            "UU_REMOTE_WAYLAND_PORTAL_FAKE_TRACE", ""
        )
        self.fake_video = os.environ.get(
            "UU_REMOTE_WAYLAND_CAPTURE_TEST_VIDEO", ""
        )
        self.connection = None
        self.x11 = None
        self.display = None
        if self.fake_trace:
            self.session_handle = "/org/freedesktop/portal/desktop/session/fake"
            self.stream_node = 77
            self.stream_width = 128 if self.fake_video else 1920
            self.stream_height = 72 if self.fake_video else 1080
            self._fake_write(
                "session authorized devices=3 stream=77 "
                f"{self.stream_width}x{self.stream_height}"
            )
            if self.fake_video:
                self._load_gio()
                self._start_capture_bridge()
            else:
                self.capture_state = "active"
                self.capture_frames = 120
            self._fake_write("capture active transport=shared-frame")
            return

        self._load_gio()
        self.connection = self.Gio.bus_get_sync(
            self.Gio.BusType.SESSION, None
        )
        self._configure_x11_keymap()
        self._authorize()
        try:
            self._start_capture_bridge()
        except Exception:
            self.close()
            raise

    @staticmethod
    def _load_gio_modules():
        try:
            import gi

            gi.require_version("Gst", "1.0")
            from gi.repository import Gio, GLib, Gst
        except (ImportError, ValueError) as error:
            raise RuntimeError(
                "Wayland 输入/画面桥需要 python3-gi 与 GStreamer GI"
            ) from error
        Gst.init(None)
        return Gio, GLib, Gst

    def _load_gio(self) -> None:
        self.Gio, self.GLib, self.Gst = self._load_gio_modules()

    @classmethod
    def check_environment(cls) -> None:
        fake_trace = os.environ.get("UU_REMOTE_WAYLAND_PORTAL_FAKE_TRACE")
        if fake_trace:
            return
        if not os.environ.get("WAYLAND_DISPLAY"):
            raise RuntimeError("WAYLAND_DISPLAY 未设置")
        Gio, GLib, Gst = cls._load_gio_modules()
        missing = [
            name
            for name in (
                "pipewiresrc",
                "queue",
                "videoconvert",
                "videoscale",
                "capsfilter",
                "appsink",
            )
            if Gst.ElementFactory.find(name) is None
        ]
        if missing:
            raise RuntimeError(
                "Wayland 画面桥缺少 GStreamer 元件：" + ", ".join(missing)
            )
        connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        value = connection.call_sync(
            PORTAL_BUS_NAME,
            PORTAL_OBJECT_PATH,
            "org.freedesktop.DBus.Properties",
            "Get",
            GLib.Variant("(ss)", (PORTAL_REMOTE_DESKTOP, "version")),
            GLib.VariantType.new("(v)"),
            Gio.DBusCallFlags.NONE,
            3000,
            None,
        )
        version = int(value.unpack()[0])
        if version < 1:
            raise RuntimeError("RemoteDesktop Portal 版本无效")

    def _fake_write(self, event: str) -> None:
        path = Path(self.fake_trace)
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(event + "\n")

    @staticmethod
    def _token(prefix: str) -> str:
        return f"{prefix}_{os.getpid()}_{secrets.token_hex(8)}"

    def _portal_request(self, interface: str, method: str, signature: str, values):
        responses: dict[str, tuple[int, dict[str, Any]]] = {}
        expected_path = ""
        loop = self.GLib.MainLoop()
        timed_out = False

        def on_response(
            _connection,
            _sender,
            object_path,
            _interface,
            _signal,
            parameters,
            _user_data,
        ) -> None:
            response, results = parameters.unpack()
            responses[object_path] = (int(response), results)
            if object_path == expected_path and loop.is_running():
                loop.quit()

        subscription = self.connection.signal_subscribe(
            PORTAL_BUS_NAME,
            PORTAL_REQUEST,
            "Response",
            None,
            None,
            self.Gio.DBusSignalFlags.NONE,
            on_response,
            None,
        )
        try:
            returned = self.connection.call_sync(
                PORTAL_BUS_NAME,
                PORTAL_OBJECT_PATH,
                interface,
                method,
                self.GLib.Variant(signature, values),
                self.GLib.VariantType.new("(o)"),
                self.Gio.DBusCallFlags.NONE,
                10000,
                None,
            )
            expected_path = returned.unpack()[0]
            if expected_path not in responses:
                def request_timeout() -> bool:
                    nonlocal timed_out
                    timed_out = True
                    loop.quit()
                    return self.GLib.SOURCE_REMOVE

                timeout_id = self.GLib.timeout_add_seconds(
                    PORTAL_REQUEST_TIMEOUT_SECONDS, request_timeout
                )
                loop.run()
                if not timed_out:
                    self.GLib.source_remove(timeout_id)
            if timed_out or expected_path not in responses:
                raise PortalRequestError(
                    f"{method} 等待桌面授权超时"
                )
            response, results = responses[expected_path]
            if response == 1:
                raise PortalRequestError(f"{method} 已被用户取消")
            if response != 0:
                raise PortalRequestError(
                    f"{method} 被桌面门户拒绝（代码 {response}）"
                )
            return results
        finally:
            self.connection.signal_unsubscribe(subscription)

    def _restore_token(self) -> str:
        try:
            return self.restore_token_path.read_text(
                encoding="utf-8"
            ).strip()
        except OSError:
            return ""

    def _save_restore_token(self, token: str) -> None:
        if token:
            atomic_write(self.restore_token_path, token + "\n")

    def _authorize(self) -> None:
        options = {
            "handle_token": self.GLib.Variant("s", self._token("create")),
            "session_handle_token": self.GLib.Variant(
                "s", self._token("session")
            ),
        }
        result = self._portal_request(
            PORTAL_REMOTE_DESKTOP,
            "CreateSession",
            "(a{sv})",
            (options,),
        )
        self.session_handle = str(result.get("session_handle", ""))
        if not self.session_handle:
            raise PortalRequestError("桌面门户未返回会话句柄")

        restore_token = self._restore_token()
        device_options = {
            "handle_token": self.GLib.Variant("s", self._token("devices")),
            "types": self.GLib.Variant(
                "u", PORTAL_DEVICE_KEYBOARD | PORTAL_DEVICE_POINTER
            ),
            "persist_mode": self.GLib.Variant(
                "u", PORTAL_PERSIST_APPLICATION
            ),
        }
        source_options = {
            "handle_token": self.GLib.Variant("s", self._token("sources")),
            "types": self.GLib.Variant("u", PORTAL_SOURCE_MONITOR),
            "multiple": self.GLib.Variant("b", False),
            "cursor_mode": self.GLib.Variant("u", PORTAL_CURSOR_HIDDEN),
        }
        if restore_token:
            device_options["restore_token"] = self.GLib.Variant(
                "s", restore_token
            )

        try:
            self._portal_request(
                PORTAL_REMOTE_DESKTOP,
                "SelectDevices",
                "(oa{sv})",
                (self.session_handle, device_options),
            )
        except Exception as error:
            if "cannot persist" not in str(error).casefold():
                raise
            # GNOME 46 advertises RemoteDesktop v2 but deliberately rejects
            # persistent sessions. Keep the secure interactive session usable.
            device_options.pop("persist_mode", None)
            device_options.pop("restore_token", None)
            self.restore_token_path.unlink(missing_ok=True)
            self._portal_request(
                PORTAL_REMOTE_DESKTOP,
                "SelectDevices",
                "(oa{sv})",
                (self.session_handle, device_options),
            )
        self._portal_request(
            PORTAL_SCREENCAST,
            "SelectSources",
            "(oa{sv})",
            (self.session_handle, source_options),
        )
        start_options = {
            "handle_token": self.GLib.Variant("s", self._token("start")),
        }
        result = self._portal_request(
            PORTAL_REMOTE_DESKTOP,
            "Start",
            "(osa{sv})",
            (
                self.session_handle,
                os.environ.get("UU_REMOTE_PORTAL_PARENT_WINDOW", ""),
                start_options,
            ),
        )
        devices = int(result.get("devices", 0))
        required = PORTAL_DEVICE_KEYBOARD | PORTAL_DEVICE_POINTER
        if devices & required != required:
            raise PortalRequestError(
                "桌面门户未同时授权键盘和鼠标控制"
            )
        streams = result.get("streams", [])
        if not streams:
            raise PortalRequestError("桌面门户未返回屏幕坐标流")
        self.stream_node = int(streams[0][0])
        properties = streams[0][1]
        size = properties.get("size", (1, 1))
        if len(size) == 2:
            self.stream_width = max(int(size[0]), 1)
            self.stream_height = max(int(size[1]), 1)
        self._save_restore_token(str(result.get("restore_token", "")))

    def _open_pipewire_remote(self) -> int:
        result, descriptors = self.connection.call_with_unix_fd_list_sync(
            PORTAL_BUS_NAME,
            PORTAL_OBJECT_PATH,
            PORTAL_SCREENCAST,
            "OpenPipeWireRemote",
            self.GLib.Variant("(oa{sv})", (self.session_handle, {})),
            self.GLib.VariantType.new("(h)"),
            self.Gio.DBusCallFlags.NONE,
            10000,
            None,
            None,
        )
        descriptor_index = int(result.unpack()[0])
        descriptor = descriptors.get(descriptor_index)
        if descriptor < 0:
            raise RuntimeError("桌面门户未返回有效的 PipeWire 描述符")
        return descriptor

    def _start_capture_bridge(self) -> None:
        self.capture_state = "starting"
        stride = self.stream_width * 4
        self.capture_frame_size = stride * self.stream_height
        mapped_size = (
            FRAME_HEADER.size + FRAME_BUFFERS * self.capture_frame_size
        )
        self.frame_path.parent.mkdir(parents=True, exist_ok=True)
        runtime_text = os.environ.get("XDG_RUNTIME_DIR", "")
        runtime_dir = Path(runtime_text) if runtime_text else self.state_dir
        if not runtime_dir.is_dir() or not os.access(runtime_dir, os.W_OK):
            runtime_dir = self.state_dir
        runtime_dir.mkdir(parents=True, exist_ok=True)
        self.capture_backing_path = runtime_dir / (
            f"uu-remote-wayland-frame-{os.getuid()}-{os.getpid()}-"
            f"{secrets.token_hex(8)}.bin"
        )
        self.frame_path.unlink(missing_ok=True)
        descriptor = os.open(
            self.capture_backing_path,
            os.O_RDWR | os.O_CREAT | os.O_EXCL,
            0o600,
        )
        try:
            os.ftruncate(descriptor, mapped_size)
            self.capture_map = mmap.mmap(
                descriptor, mapped_size, access=mmap.ACCESS_WRITE
            )
        finally:
            os.close(descriptor)
        self.frame_path.symlink_to(self.capture_backing_path)
        FRAME_HEADER.pack_into(
            self.capture_map,
            0,
            FRAME_MAGIC,
            FRAME_VERSION,
            FRAME_HEADER.size,
            self.stream_width,
            self.stream_height,
            stride,
            self.capture_frame_size,
            FRAME_BUFFERS,
            0,
            0,
        )
        if self.fake_video:
            source = self.Gst.ElementFactory.make(
                "videotestsrc", "portal-source"
            )
            source.set_property("is-live", True)
            source.set_property("pattern", 0)
        else:
            self.capture_pipewire_fd = self._open_pipewire_remote()
            source = self.Gst.ElementFactory.make(
                "pipewiresrc", "portal-source"
            )
        queue = self.Gst.ElementFactory.make("queue", "frame-queue")
        convert = self.Gst.ElementFactory.make("videoconvert", "frame-convert")
        scale = self.Gst.ElementFactory.make("videoscale", "frame-scale")
        caps_filter = self.Gst.ElementFactory.make("capsfilter", "frame-caps")
        sink = self.Gst.ElementFactory.make("appsink", "capture-sink")
        elements = (source, queue, convert, scale, caps_filter, sink)
        if any(element is None for element in elements):
            raise RuntimeError("无法创建 Wayland 画面桥 GStreamer 管线")
        if not self.fake_video:
            source.set_property("fd", self.capture_pipewire_fd)
            source.set_property("path", str(self.stream_node))
            source.set_property("do-timestamp", True)
        queue.set_property("max-size-buffers", 2)
        queue.set_property("leaky", 2)
        scale.set_property("add-borders", False)
        caps_filter.set_property(
            "caps",
            self.Gst.Caps.from_string(
                "video/x-raw,format=BGRx,"
                f"width={self.stream_width},height={self.stream_height},"
                "pixel-aspect-ratio=1/1"
            ),
        )
        sink.set_property("sync", False)
        sink.set_property("emit-signals", True)
        sink.set_property("max-buffers", 2)
        sink.set_property("drop", True)
        self.capture_pipeline = self.Gst.Pipeline.new("wayland-capture")
        for element in elements:
            self.capture_pipeline.add(element)
        for first, second in zip(elements, elements[1:]):
            if not first.link(second):
                raise RuntimeError(
                    f"无法连接 GStreamer 元件 {first.name} → {second.name}"
                )

        def write_frame(appsink) -> int:
            sample = appsink.emit("pull-sample")
            if sample is None or self.capture_map is None:
                return self.Gst.FlowReturn.ERROR
            buffer = sample.get_buffer()
            mapped, info = buffer.map(self.Gst.MapFlags.READ)
            if not mapped:
                return self.Gst.FlowReturn.ERROR
            try:
                if len(info.data) < self.capture_frame_size:
                    return self.Gst.FlowReturn.ERROR
                sequence = self.capture_frames + 1
                active = sequence % FRAME_BUFFERS
                offset = FRAME_HEADER.size + active * self.capture_frame_size
                self.capture_map[offset : offset + self.capture_frame_size] = \
                    memoryview(info.data)[: self.capture_frame_size]
                struct.pack_into("<I", self.capture_map, 32, active)
                struct.pack_into("<I", self.capture_map, 36, sequence)
                self.capture_frames = sequence
            finally:
                buffer.unmap(info)
            return self.Gst.FlowReturn.OK

        sink.connect("new-sample", write_frame)
        if self.capture_pipeline.set_state(
            self.Gst.State.PLAYING
        ) == self.Gst.StateChangeReturn.FAILURE:
            raise RuntimeError("Wayland 画面桥无法进入 PLAYING 状态")
        bus = self.capture_pipeline.get_bus()
        deadline = time.monotonic() + CAPTURE_START_TIMEOUT_SECONDS
        while self.capture_frames == 0 and time.monotonic() < deadline:
            message = bus.timed_pop_filtered(
                200 * self.Gst.MSECOND,
                self.Gst.MessageType.ERROR | self.Gst.MessageType.EOS,
            )
            if message is not None:
                if message.type == self.Gst.MessageType.ERROR:
                    error, debug = message.parse_error()
                    raise RuntimeError(
                        f"Wayland 画面桥 GStreamer 错误：{error}（{debug}）"
                    )
                raise RuntimeError("Wayland Portal 屏幕流意外结束")
        if self.capture_frames == 0:
            raise RuntimeError("Wayland Portal 在 10 秒内未产生画面帧")
        self.ensure_healthy()
        self.capture_state = "active"

    def ensure_healthy(self) -> None:
        if self.fake_trace:
            return
        if self.capture_pipeline is None:
            raise RuntimeError("Wayland PipeWire 画面转发未启动")
        message = self.capture_pipeline.get_bus().pop_filtered(
            self.Gst.MessageType.ERROR | self.Gst.MessageType.EOS
        )
        if message is not None:
            if message.type == self.Gst.MessageType.ERROR:
                error, debug = message.parse_error()
                raise RuntimeError(
                    f"Wayland 画面桥 GStreamer 错误：{error}（{debug}）"
                )
            raise RuntimeError("Wayland Portal 屏幕流已结束")
        state_result, state, _pending = self.capture_pipeline.get_state(0)
        if state_result == self.Gst.StateChangeReturn.FAILURE or state not in (
            self.Gst.State.PAUSED,
            self.Gst.State.PLAYING,
        ):
            raise RuntimeError("Wayland PipeWire 画面转发已停止")

    def _configure_x11_keymap(self) -> None:
        self.x11 = ctypes.CDLL("libX11.so.6")
        self.x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        self.x11.XOpenDisplay.restype = ctypes.c_void_p
        self.x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
        self.x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
        self.x11.XStringToKeysym.restype = ctypes.c_ulong
        self.x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        self.x11.XKeysymToKeycode.restype = ctypes.c_ubyte
        display_name = os.environ.get("DISPLAY")
        encoded = display_name.encode() if display_name else None
        self.display = self.x11.XOpenDisplay(encoded)
        if not self.display:
            raise RuntimeError(
                "Wayland 分支需要 XWayland DISPLAY 承载 Wine 客户端"
            )

    def _notify(self, method: str, signature: str, values) -> None:
        if self.fake_trace:
            rendered = " ".join(str(value) for value in values[2:])
            self._fake_write(f"{method} {rendered}".rstrip())
            return
        self.connection.call_sync(
            PORTAL_BUS_NAME,
            PORTAL_OBJECT_PATH,
            PORTAL_REMOTE_DESKTOP,
            method,
            self.GLib.Variant(signature, values),
            None,
            self.Gio.DBusCallFlags.NONE,
            2000,
            None,
        )

    def close(self) -> None:
        if self.fake_trace:
            self._fake_write("close")
        self.capture_state = "stopped"
        if self.capture_pipeline is not None:
            self.capture_pipeline.set_state(self.Gst.State.NULL)
            self.capture_pipeline.get_state(5 * self.Gst.SECOND)
            self.capture_pipeline = None
        if self.capture_pipewire_fd >= 0:
            os.close(self.capture_pipewire_fd)
            self.capture_pipewire_fd = -1
        if self.capture_map is not None:
            self.capture_map.close()
            self.capture_map = None
        self.frame_path.unlink(missing_ok=True)
        if self.capture_backing_path is not None:
            self.capture_backing_path.unlink(missing_ok=True)
            self.capture_backing_path = None
        if (
            not self.fake_trace
            and self.session_handle
            and self.connection is not None
        ):
            try:
                self.connection.call_sync(
                    PORTAL_BUS_NAME,
                    self.session_handle,
                    PORTAL_SESSION,
                    "Close",
                    None,
                    None,
                    self.Gio.DBusCallFlags.NONE,
                    2000,
                    None,
                )
            except Exception:
                pass
        if self.display and self.x11:
            self.x11.XCloseDisplay(self.display)
            self.display = None

    def flush(self) -> None:
        return

    def motion(
        self,
        dx: int,
        dy: int,
        absolute: bool,
        virtual_desktop: bool = False,
    ) -> None:
        del virtual_desktop
        options = {}
        if absolute:
            x = max(0, min(dx, 65535)) * (self.stream_width - 1) / 65535
            y = max(0, min(dy, 65535)) * (self.stream_height - 1) / 65535
            self._notify(
                "NotifyPointerMotionAbsolute",
                "(oa{sv}udd)",
                (self.session_handle, options, self.stream_node, x, y),
            )
        else:
            self._notify(
                "NotifyPointerMotion",
                "(oa{sv}dd)",
                (self.session_handle, options, float(dx), float(dy)),
            )

    def button(self, button: int, pressed: bool) -> None:
        if button in (4, 5, 6, 7):
            if not pressed:
                return
            axis = 0 if button in (4, 5) else 1
            steps = -1 if button in (4, 6) else 1
            self._notify(
                "NotifyPointerAxisDiscrete",
                "(oa{sv}ui)",
                (self.session_handle, {}, axis, steps),
            )
            return
        evdev_button = EVDEV_BUTTONS.get(button)
        if evdev_button is None:
            raise ValueError(f"Wayland 不支持鼠标按钮 {button}")
        self._notify(
            "NotifyPointerButton",
            "(oa{sv}iu)",
            (self.session_handle, {}, evdev_button, int(pressed)),
        )

    def keycode(self, keycode: int, pressed: bool) -> None:
        evdev_keycode = keycode - 8
        if not 0 <= evdev_keycode <= 767:
            raise ValueError(f"无效 Wayland/evdev 键码：{evdev_keycode}")
        self._notify(
            "NotifyKeyboardKeycode",
            "(oa{sv}iu)",
            (self.session_handle, {}, evdev_keycode, int(pressed)),
        )

    def keysym_keycode(self, name: str) -> int:
        if not self.display or not self.x11:
            return 0
        keysym = self.x11.XStringToKeysym(name.encode("ascii"))
        if not keysym:
            return 0
        return int(self.x11.XKeysymToKeycode(self.display, keysym))


class FakeBackend:
    name = "fake-x11"

    def __init__(self, trace_path: Path):
        self.trace_path = trace_path
        self.fake_lock_mask = int(
            os.environ.get("UU_REMOTE_INPUT_BRIDGE_FAKE_LOCK_MASK", "0"), 0
        ) & 0x7
        fake_geometry = os.environ.get(
            "UU_REMOTE_INPUT_BRIDGE_FAKE_GEOMETRY", ""
        )
        if fake_geometry:
            values = tuple(int(value) for value in fake_geometry.split(","))
            if len(values) != 4 or values[2] <= 0 or values[3] <= 0:
                raise ValueError("测试显示器坐标必须是 x,y,width,height")
            self.absolute_geometry = values
            fake_virtual_geometry = os.environ.get(
                "UU_REMOTE_INPUT_BRIDGE_FAKE_VIRTUAL_GEOMETRY", ""
            )
            if fake_virtual_geometry:
                virtual_values = tuple(
                    int(value) for value in fake_virtual_geometry.split(",")
                )
                if (
                    len(virtual_values) != 4
                    or virtual_values[2] <= 0
                    or virtual_values[3] <= 0
                ):
                    raise ValueError(
                        "测试虚拟桌面坐标必须是 x,y,width,height"
                    )
                self.virtual_geometry = virtual_values
            else:
                self.virtual_geometry = values
            self.absolute_geometry_source = "test-monitor"
            fake_feedback_geometry = os.environ.get(
                "UU_REMOTE_INPUT_BRIDGE_FAKE_CURSOR_GEOMETRY", ""
            )
            if fake_feedback_geometry:
                feedback_values = tuple(
                    int(value) for value in fake_feedback_geometry.split(",")
                )
                if (
                    len(feedback_values) != 4
                    or feedback_values[2] <= 0
                    or feedback_values[3] <= 0
                ):
                    raise ValueError(
                        "测试光标反馈坐标必须是 x,y,width,height"
                    )
                self.cursor_feedback_geometry = feedback_values
            else:
                self.cursor_feedback_geometry = (0, 0, values[2], values[3])

    def _write(self, event: str) -> None:
        self.trace_path.parent.mkdir(parents=True, exist_ok=True)
        with self.trace_path.open("a", encoding="utf-8") as handle:
            handle.write(event + "\n")

    def close(self) -> None:
        self._write("close")

    def flush(self) -> None:
        self._write("flush")

    def motion(
        self,
        dx: int,
        dy: int,
        absolute: bool,
        virtual_desktop: bool = False,
    ) -> None:
        self._write(
            f"motion {dx} {dy} {int(absolute)} {int(virtual_desktop)}"
        )
        if absolute and hasattr(self, "absolute_geometry"):
            geometry = (
                self.virtual_geometry
                if virtual_desktop
                else self.absolute_geometry
            )
            x, y = map_absolute_point(dx, dy, geometry)
            self._write(f"motion-target {x} {y}")

    def button(self, button: int, pressed: bool) -> None:
        self._write(f"button {button} {int(pressed)}")

    def keycode(self, keycode: int, pressed: bool) -> None:
        self._write(f"keycode {keycode} {int(pressed)}")
        if pressed:
            lock_bit = {66: 0x1, 77: 0x2, 78: 0x4}.get(keycode, 0)
            self.fake_lock_mask ^= lock_bit

    def lock_mask(self) -> int:
        return self.fake_lock_mask

    @staticmethod
    def cursor_image() -> tuple[int, int, int, int, int, bytes]:
        width = 4
        height = 4
        pixels = (
            0x00000000,
            0xFFFFFFFF,
            0x00000000,
            0x00000000,
            0xFFFFFFFF,
            0xFF2050E0,
            0xFFFFFFFF,
            0x00000000,
            0x00000000,
            0xFFFFFFFF,
            0x00000000,
            0x00000000,
            0x00000000,
            0xFFFFFFFF,
            0x00000000,
            0x00000000,
        )
        return 1, width, height, 1, 2, struct.pack("<16I", *pixels)

    @staticmethod
    def keysym_keycode(name: str) -> int:
        if len(name) == 1 and name.isalpha():
            return ord(name.upper()) - ord("A") + 38
        if len(name) == 1 and name.isdigit():
            return ord(name) - ord("0") + 19
        return {
            "Shift_L": 50,
            "Control_L": 37,
            "Caps_Lock": 66,
            "Num_Lock": 77,
            "Scroll_Lock": 78,
            "Return": 36,
            "space": 65,
            "Left": 113,
        }.get(name, 90)


def selected_backend() -> str:
    configured = os.environ.get("UU_REMOTE_DESKTOP_BACKEND", "").casefold()
    if configured in ("x11", "x11-xtest"):
        return "x11"
    if configured in ("wayland", "wayland-xwayland", "wayland-portal"):
        return "wayland"
    session_type = os.environ.get("XDG_SESSION_TYPE", "").casefold()
    return "wayland" if session_type == "wayland" else "x11"


def make_backend(
    state_dir: Path | None = None,
    frame_path: Path | None = None,
    monitor_selection_path: Path | None = None,
):
    fake_trace = os.environ.get("UU_REMOTE_INPUT_BRIDGE_FAKE_TRACE")
    if fake_trace:
        return FakeBackend(Path(fake_trace))
    if selected_backend() == "wayland":
        if state_dir is None:
            raise RuntimeError("Wayland 输入桥缺少状态目录")
        if frame_path is None:
            raise RuntimeError("Wayland 画面桥缺少共享帧路径")
        return WaylandPortalBackend(state_dir, frame_path)
    return XTestBackend(monitor_selection_path)


class InputController:
    def __init__(self, backend, logger: Logger):
        self.backend = backend
        self.logger = logger
        self.pressed_keys: set[int] = set()
        self.pressed_buttons: set[int] = set()
        self.last_absolute_space = ""

    def emit_keycode(self, keycode: int, pressed: bool) -> None:
        if not keycode:
            raise ValueError("无法把 Windows 键映射到当前 Linux 键盘布局")
        self.backend.keycode(keycode, pressed)
        if pressed:
            self.pressed_keys.add(keycode)
        else:
            self.pressed_keys.discard(keycode)

    def keysym_keycode(self, name: str) -> int:
        return self.backend.keysym_keycode(name)

    def keycode_from_windows(
        self,
        virtual_key: int,
        scan_code: int,
        flags: int,
    ) -> int:
        scan_code &= 0xFF
        if flags & KEY_SCANCODE and scan_code:
            if flags & KEY_EXTENDED:
                return EXTENDED_SCAN_KEYCODES.get(scan_code, 0)
            return scan_code + 8
        if 0x30 <= virtual_key <= 0x39:
            return self.keysym_keycode(chr(virtual_key))
        if 0x41 <= virtual_key <= 0x5A:
            return self.keysym_keycode(chr(virtual_key))
        if 0x70 <= virtual_key <= 0x7B:
            return self.keysym_keycode(f"F{virtual_key - 0x6F}")
        name = VK_KEYSYMS.get(virtual_key)
        return self.keysym_keycode(name) if name else 0

    def type_unicode(self, codepoint: int) -> None:
        try:
            character = chr(codepoint)
        except ValueError as error:
            raise ValueError(f"无效 Unicode 码点：{codepoint}") from error

        if character.isascii():
            if character.isalpha():
                name = character.lower()
                shifted = character.isupper()
            elif character.isdigit():
                name = character
                shifted = False
            else:
                name, shifted = ASCII_KEYSYMS.get(character, ("", False))
            keycode = self.keysym_keycode(name) if name else 0
            if keycode:
                shift = self.keysym_keycode("Shift_L")
                if shifted:
                    self.backend.keycode(shift, True)
                self.backend.keycode(keycode, True)
                self.backend.keycode(keycode, False)
                if shifted:
                    self.backend.keycode(shift, False)
                return

        # GNOME/GTK Unicode input fallback: Ctrl+Shift+U, hex codepoint, Enter.
        control = self.keysym_keycode("Control_L")
        shift = self.keysym_keycode("Shift_L")
        u_key = self.keysym_keycode("u")
        self.backend.keycode(control, True)
        self.backend.keycode(shift, True)
        self.backend.keycode(u_key, True)
        self.backend.keycode(u_key, False)
        self.backend.keycode(shift, False)
        self.backend.keycode(control, False)
        for digit in f"{codepoint:x}":
            keycode = self.keysym_keycode(digit)
            self.backend.keycode(keycode, True)
            self.backend.keycode(keycode, False)
        enter = self.keysym_keycode("Return")
        self.backend.keycode(enter, True)
        self.backend.keycode(enter, False)

    def keyboard(
        self,
        virtual_key: int,
        scan_code: int,
        flags: int,
    ) -> None:
        pressed = not bool(flags & KEY_UP)
        if flags & KEY_UNICODE:
            if pressed:
                self.type_unicode(scan_code)
            self.backend.flush()
            return
        keycode = self.keycode_from_windows(virtual_key, scan_code, flags)
        self.emit_keycode(keycode, pressed)
        self.backend.flush()

    def set_button(self, button: int, pressed: bool) -> None:
        self.backend.button(button, pressed)
        if pressed:
            self.pressed_buttons.add(button)
        else:
            self.pressed_buttons.discard(button)

    def wheel(self, button: int, count: int) -> None:
        for _ in range(min(abs(count), 100)):
            self.backend.button(button, True)
            self.backend.button(button, False)

    def mouse(
        self,
        dx: int,
        dy: int,
        data: int,
        flags: int,
    ) -> None:
        if flags & MOUSE_MOVE:
            absolute = bool(flags & MOUSE_ABSOLUTE)
            virtual_desktop = bool(flags & MOUSE_VIRTUAL_DESKTOP)
            if absolute:
                space = (
                    "virtual-desktop"
                    if virtual_desktop
                    else "selected-monitor"
                )
                if space != self.last_absolute_space:
                    self.logger.write(
                        "绝对鼠标坐标域："
                        f"{space}（flags=0x{flags:04x}）"
                    )
                    self.last_absolute_space = space
            self.backend.motion(dx, dy, absolute, virtual_desktop)
        for mask, button, pressed in (
            (MOUSE_LEFTDOWN, 1, True),
            (MOUSE_LEFTUP, 1, False),
            (MOUSE_RIGHTDOWN, 3, True),
            (MOUSE_RIGHTUP, 3, False),
            (MOUSE_MIDDLEDOWN, 2, True),
            (MOUSE_MIDDLEUP, 2, False),
        ):
            if flags & mask:
                self.set_button(button, pressed)
        if flags & (MOUSE_XDOWN | MOUSE_XUP):
            pressed = bool(flags & MOUSE_XDOWN)
            if data & 0x0001:
                self.set_button(8, pressed)
            if data & 0x0002:
                self.set_button(9, pressed)
        signed_data = ctypes.c_int32(data).value
        if flags & MOUSE_WHEEL and signed_data:
            self.wheel(4 if signed_data > 0 else 5, signed_data // 120)
        if flags & MOUSE_HWHEEL and signed_data:
            self.wheel(7 if signed_data > 0 else 6, signed_data // 120)
        self.backend.flush()

    def release_all(self, reason: str) -> None:
        if not self.pressed_keys and not self.pressed_buttons:
            return
        for keycode in sorted(self.pressed_keys):
            self.backend.keycode(keycode, False)
        for button in sorted(self.pressed_buttons):
            self.backend.button(button, False)
        self.backend.flush()
        self.logger.write(
            f"安全释放 {len(self.pressed_keys)} 个按键和 "
            f"{len(self.pressed_buttons)} 个鼠标按钮（{reason}）"
        )
        self.pressed_keys.clear()
        self.pressed_buttons.clear()


def cursor_feedback_geometry(
    backend,
) -> tuple[int, int, int, int] | None:
    geometry = getattr(backend, "cursor_feedback_geometry", None)
    if geometry is None:
        absolute_geometry = getattr(backend, "absolute_geometry", None)
        if absolute_geometry is not None and len(absolute_geometry) == 4:
            geometry = (0, 0, absolute_geometry[2], absolute_geometry[3])
    if geometry is not None and len(geometry) == 4:
        origin_x = int(geometry[0])
        origin_y = int(geometry[1])
        width = int(geometry[2])
        height = int(geometry[3])
    elif hasattr(backend, "stream_width") and hasattr(
        backend, "stream_height"
    ):
        origin_x = 0
        origin_y = 0
        width = int(backend.stream_width)
        height = int(backend.stream_height)
    else:
        return None
    if (
        not -(2**31) <= origin_x < 2**31
        or not -(2**31) <= origin_y < 2**31
        or not 1 <= width <= 65535
        or not 1 <= height <= 65535
    ):
        return None
    return origin_x, origin_y, width, height


def endpoint_content(
    port: int,
    token: bytes,
    cursor_geometry: tuple[int, int, int, int] | None = None,
    native_lock_keys: bool = False,
    lock_mask: int | None = None,
) -> str:
    content = (
        "[bridge]\n"
        f"version={PROTOCOL_VERSION}\n"
        f"port={port}\n"
        f"token={token.hex()}\n"
        "force_cursor=1\n"
        "cursor_image=uu-remote-native-cursor.bin\n"
        f"cursor_image_version={CURSOR_VERSION}\n"
        f"native_lock_keys={int(native_lock_keys)}\n"
    )
    if lock_mask is not None:
        content += (
            "lock_state_valid=1\n"
            f"lock_mask={lock_mask & 0x7}\n"
        )
    if cursor_geometry is not None:
        origin_x, origin_y, width, height = cursor_geometry
        content += (
            "cursor_space=screen-local\n"
            f"cursor_origin_x={origin_x}\n"
            f"cursor_origin_y={origin_y}\n"
            f"cursor_width={width}\n"
            f"cursor_height={height}\n"
        )
    return content + f"pid={os.getpid()}\n"


def status_paths(state_dir: Path) -> dict[str, Path]:
    return {"status": state_dir / "input-bridge-status.json"}


