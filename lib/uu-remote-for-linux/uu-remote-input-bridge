            "cursor_hotspot_y": cursor_hotspot_y,
            "detail": detail,
            "updated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        },
    )


def parse_packet(data: bytes, token: bytes):
    if len(data) < HEADER.size:
        raise ValueError("数据包短于协议头")
    magic, version, kind, size, sequence, received_token = HEADER.unpack_from(
        data
    )
    if magic != PROTOCOL_MAGIC or version != PROTOCOL_VERSION:
        raise ValueError("协议标识或版本无效")
    if size != len(data):
        raise ValueError("数据包长度字段无效")
    if not hmac.compare_digest(received_token, token):
        raise PermissionError("认证令牌无效")
    payload = data[HEADER.size :]
    if kind == PACKET_HELLO and len(payload) == HELLO.size:
        return kind, sequence, HELLO.unpack(payload)
    if kind == PACKET_MOUSE and len(payload) == MOUSE.size:
        return kind, sequence, MOUSE.unpack(payload)
    if kind == PACKET_KEYBOARD and len(payload) == KEYBOARD.size:
        return kind, sequence, KEYBOARD.unpack(payload)
    raise ValueError("数据包类型或载荷长度无效")


def remove_owned_endpoint(endpoint: Path, token: bytes) -> None:
    try:
        content = endpoint.read_text(encoding="ascii")
    except OSError:
        return
    if f"token={token.hex()}\n" in content:
        endpoint.unlink(missing_ok=True)


def watch(
    state_dir: Path,
    endpoint: Path,
    log_path: Path,
    lock_path: Path,
    release_timeout: float,
    monitor_selection_path: Path | None = None,
) -> int:
    logger = Logger(log_path)
    status_path = status_paths(state_dir)["status"]
    cursor_path = endpoint.parent / "uu-remote-native-cursor.bin"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_handle = lock_path.open("a+")
    try:
        fcntl.flock(lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0

    backend = None
    listener = None
    controller = None
    token = secrets.token_bytes(16)
    running = True
    port = 0
    packets = 0
    rejected = 0
    hook_pid = 0
    hook_version = 0
    mouse_packets = 0
    mouse_moves = 0
    mouse_buttons = 0
    keyboard_packets = 0
    last_mouse_dx = 0
    last_mouse_dy = 0
    last_mouse_flags = 0
    backend_name = selected_backend()
    portal_stream = 0
    capture_state = "inactive"
    last_event = 0.0
    last_status = 0.0
    endpoint_cursor_geometry: tuple[int, int, int, int] | None = None
    endpoint_lock_mask: int | None = None
    cursor_snapshot: tuple[int, int, int, int, int, bytes] | None = None
    cursor_sequence = 0
    cursor_checked_at = 0.0
    cursor_logged_at = 0.0

    def publish_status(state: str, detail: str = "") -> None:
        current_capture_frames = int(
            getattr(backend, "capture_frames", 0) if backend is not None else 0
        )
        write_status(
            status_path,
            state,
            port=port,
            hook_pid=hook_pid,
            hook_version=hook_version,
            packets=packets,
            rejected=rejected,
            mouse_packets=mouse_packets,
            mouse_moves=mouse_moves,
            mouse_buttons=mouse_buttons,
            keyboard_packets=keyboard_packets,
            last_mouse_dx=last_mouse_dx,
            last_mouse_dy=last_mouse_dy,
            last_mouse_flags=last_mouse_flags,
            backend=backend_name,
            portal_stream=portal_stream,
            capture_state=capture_state,
            capture_frames=current_capture_frames,
            absolute_target=getattr(backend, "absolute_geometry", None),
            absolute_target_source=str(
                getattr(backend, "absolute_geometry_source", "")
            ),
            cursor_state="active" if cursor_snapshot is not None else "inactive",
            cursor_sequence=cursor_sequence,
            cursor_width=cursor_snapshot[1] if cursor_snapshot else 0,
            cursor_height=cursor_snapshot[2] if cursor_snapshot else 0,
            cursor_hotspot_x=cursor_snapshot[3] if cursor_snapshot else 0,
            cursor_hotspot_y=cursor_snapshot[4] if cursor_snapshot else 0,
            detail=detail,
        )

    def request_stop(_signum, _frame) -> None:
        nonlocal running
        running = False

    def sync_endpoint(force: bool = False) -> None:
        nonlocal endpoint_cursor_geometry, endpoint_lock_mask
        if backend is None or port == 0:
            return
        if hasattr(backend, "refresh_absolute_geometry"):
            backend.refresh_absolute_geometry()
        current_geometry = cursor_feedback_geometry(backend)
        current_lock_mask = (
            backend.lock_mask() if hasattr(backend, "lock_mask") else None
        )
        if (
            not force
            and current_geometry == endpoint_cursor_geometry
            and current_lock_mask == endpoint_lock_mask
        ):
            return
        atomic_write(
            endpoint,
            endpoint_content(
                port,
                token,
                current_geometry,
                selected_backend() == "x11",
                current_lock_mask,
            ),
        )
        endpoint_cursor_geometry = current_geometry
        endpoint_lock_mask = current_lock_mask
        if current_geometry is not None:
            logger.write(
                "UU 光标反馈坐标已同步为所选屏幕局部范围："
                f"origin=({current_geometry[0]},{current_geometry[1]}) "
                f"size={current_geometry[2]}x{current_geometry[3]}"
            )

    def sync_cursor(force: bool = False) -> None:
        nonlocal cursor_snapshot, cursor_sequence, cursor_checked_at
        nonlocal cursor_logged_at
        if backend is None or not hasattr(backend, "cursor_image"):
            return
        now = time.monotonic()
        if not force and now - cursor_checked_at < CURSOR_POLL_SECONDS:
            return
        cursor_checked_at = now
        current = backend.cursor_image()
        if current is None or (
            cursor_snapshot is not None and current[1:] == cursor_snapshot[1:]
        ):
            return
        _serial, width, height, hot_x, hot_y, pixels = current
        if len(pixels) != width * height * 4:
            return
        cursor_sequence = (cursor_sequence + 1) & 0xFFFFFFFF
        if cursor_sequence == 0:
            cursor_sequence = 1
        header = CURSOR_HEADER.pack(
            CURSOR_MAGIC,
            CURSOR_VERSION,
            CURSOR_HEADER.size,
            cursor_sequence,
            width,
            height,
            hot_x,
            hot_y,
            len(pixels),
        )
        atomic_write_bytes(cursor_path, header + pixels)
        cursor_snapshot = current
        if force or now - cursor_logged_at >= 1.0:
            logger.write(
                "原生光标图像已同步："
                f"sequence={cursor_sequence} size={width}x{height} "
                f"hotspot=({hot_x},{hot_y})"
            )
            cursor_logged_at = now

    signal.signal(signal.SIGINT, request_stop)
    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGHUP, request_stop)

    try:
        publish_status(
            "authorizing" if selected_backend() == "wayland" else "starting",
            "等待 Wayland 桌面控制授权"
            if selected_backend() == "wayland"
            else "",
        )
        backend = make_backend(
            state_dir,
            endpoint.parent / "uu-remote-wayland-frame.bin",
            monitor_selection_path,
        )
        backend_name = getattr(backend, "name", selected_backend())
        portal_stream = int(getattr(backend, "stream_node", 0))
        capture_state = str(getattr(backend, "capture_state", "inactive"))
        absolute_target = getattr(backend, "absolute_geometry", None)
        if absolute_target is not None:
            origin_x, origin_y, width, height = absolute_target
            logger.write(
                "X11 绝对鼠标坐标目标："
                f"{getattr(backend, 'absolute_geometry_source', 'unknown')} "
                f"{width}x{height}+{origin_x}+{origin_y}"
            )
        controller = InputController(backend, logger)
        listener = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        listener.bind(("127.0.0.1", 0))
        listener.settimeout(
            CURSOR_POLL_SECONDS
            if hasattr(backend, "cursor_image")
            else 0.25
        )
        port = int(listener.getsockname()[1])
        sync_cursor(force=True)
        sync_endpoint(force=True)
        publish_status("waiting-hook")
        logger.write(
            f"{backend_name} 原生输入桥已启动，监听回环端口 {port}；"
            "等待 GameViewerServer 输入钩子"
        )

        while running:
            sync_endpoint()
            sync_cursor()
            try:
                data, address = listener.recvfrom(512)
            except socket.timeout:
                data = b""
                address = ("", 0)
            if data:
                if address[0] != "127.0.0.1":
                    rejected += 1
                    continue
                try:
                    kind, _sequence, payload = parse_packet(data, token)
                    if kind == PACKET_HELLO:
                        hook_pid, hook_version = payload
                        if hook_version < MINIMUM_HOOK_VERSION:
                            logger.write(
                                "GameViewerServer 输入钩子版本过旧"
                                f"（PID {hook_pid}，v{hook_version}，"
                                f"要求 v{MINIMUM_HOOK_VERSION}+）"
                            )
                        else:
                            logger.write(
                                "GameViewerServer 输入钩子已连接"
                                f"（PID {hook_pid}，v{hook_version}）"
                            )
                    elif kind == PACKET_MOUSE:
                        if hook_version < MINIMUM_HOOK_VERSION:
                            raise ValueError("输入钩子版本过旧或尚未握手")
                        dx, dy, mouse_data, flags, _timestamp, _extra = payload
                        controller.mouse(dx, dy, mouse_data, flags)
                        mouse_packets += 1
                        if flags & MOUSE_MOVE:
                            mouse_moves += 1
                        if flags & MOUSE_BUTTON_FLAGS:
                            mouse_buttons += 1
                        last_mouse_dx = dx
                        last_mouse_dy = dy
                        last_mouse_flags = flags
                        last_event = time.monotonic()
                    elif kind == PACKET_KEYBOARD:
                        if hook_version < MINIMUM_HOOK_VERSION:
                            raise ValueError("输入钩子版本过旧或尚未握手")
                        vk, scan, flags, _timestamp, _extra = payload
                        controller.keyboard(vk, scan, flags)
                        keyboard_packets += 1
                        last_event = time.monotonic()
                    packets += 1
                except (PermissionError, ValueError):
                    rejected += 1
                except Exception as error:
                    rejected += 1
                    logger.write(f"输入事件注入失败：{error}")

            now = time.monotonic()
            if hasattr(backend, "ensure_healthy"):
                backend.ensure_healthy()
            if (
                last_event
                and now - last_event >= release_timeout
                and (controller.pressed_keys or controller.pressed_buttons)
            ):
                controller.release_all("输入超时")
                last_event = 0.0
            if now - last_status >= 2.0:
                compatible_hook = (
                    hook_pid and hook_version >= MINIMUM_HOOK_VERSION
                )
                publish_status(
                    "active" if compatible_hook else "waiting-hook",
                    "" if compatible_hook else (
                        f"等待 v{MINIMUM_HOOK_VERSION}+ 输入钩子"
                    ),
                )
                last_status = now
        return 0
    except Exception as error:
        logger.write(f"原生输入桥异常：{error}")
        publish_status("error", str(error))
        return 1
    finally:
        if controller is not None:
            try:
                controller.release_all("输入桥退出")
            except Exception as error:
                logger.write(f"退出时释放输入失败：{error}")
        if listener is not None:
            listener.close()
        if backend is not None:
            backend.close()
        remove_owned_endpoint(endpoint, token)
        cursor_path.unlink(missing_ok=True)
        cursor_snapshot = None
        if not running:
            publish_status("stopped")
            logger.write(f"{backend_name} 原生输入桥已停止")
        lock_handle.close()


def check_environment() -> int:
    if selected_backend() == "wayland":
        WaylandPortalBackend.check_environment()
        print("wayland-portal")
        return 0
    session_type = os.environ.get("XDG_SESSION_TYPE", "").casefold()
    if session_type and session_type not in ("x11", "wayland"):
        print(f"不支持的桌面会话：{session_type}", file=sys.stderr)
        return 1
    backend = make_backend()
    backend.close()
    print("x11-xtest")
    return 0


def print_status(state_dir: Path) -> int:
    status_path = status_paths(state_dir)["status"]
    if not status_path.is_file():
        print("not-running")
        return 1
    try:
        payload = json.loads(status_path.read_text(encoding="utf-8"))
        print(payload.get("state", "unknown"))
    except (OSError, ValueError, TypeError):
        print("invalid")
        return 1
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="mode", required=True)
    subparsers.add_parser("check")

    watch_parser = subparsers.add_parser("watch")
    watch_parser.add_argument("state_dir", type=Path)
    watch_parser.add_argument("endpoint", type=Path)
    watch_parser.add_argument("log", type=Path)
    watch_parser.add_argument("lock", type=Path)
    watch_parser.add_argument(
        "release_timeout",
        nargs="?",
        type=float,
        default=DEFAULT_RELEASE_TIMEOUT,
    )
    watch_parser.add_argument(
        "monitor_selection_file",
        nargs="?",
        type=Path,
        default=None,
    )

    status_parser = subparsers.add_parser("status")
    status_parser.add_argument("state_dir", type=Path)

    arguments = parser.parse_args()
    if arguments.mode == "check":
        return check_environment()
    if arguments.mode == "watch":
        if arguments.release_timeout <= 0:
            parser.error("release_timeout 必须大于 0")
        return watch(
            arguments.state_dir,
            arguments.endpoint,
            arguments.log,
            arguments.lock,
            arguments.release_timeout,
            arguments.monitor_selection_file,
        )
    if arguments.mode == "status":
        return print_status(arguments.state_dir)
    return 2


if __name__ == "__main__":
    sys.exit(main())
