def atomic_write_json(path: Path, payload: dict[str, Any]) -> None:
    atomic_write(
        path,
        json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n",
    )


class Logger:
    def __init__(self, path: Path):
        self.path = path

    def write(self, message: str) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        timestamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        with self.path.open("a", encoding="utf-8") as handle:
            handle.write(f"[{timestamp}] {message}\n")


def map_absolute_point(
    dx: int,
    dy: int,
    geometry: tuple[int, int, int, int],
) -> tuple[int, int]:
    """Map Win32 0..65535 absolute input into one X11 monitor rectangle."""
    origin_x, origin_y, width, height = geometry
    if width <= 0 or height <= 0:
        raise ValueError("显示器坐标范围无效")
    normalized_x = max(0, min(int(dx), 65535))
    normalized_y = max(0, min(int(dy), 65535))
    x = origin_x + round(normalized_x * (width - 1) / 65535)
    y = origin_y + round(normalized_y * (height - 1) / 65535)
    return x, y


def x11_monitor_descriptors() -> list[dict[str, Any]]:
    """Return every X11 monitor with a stable connector-derived identity."""
    try:
        import gi

        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk
    except (ImportError, ValueError):
        return []

    display = Gdk.Display.get_default()
    if display is None:
        return []
    primary = display.get_primary_monitor()
    descriptors: list[dict[str, Any]] = []
    duplicate_counts: dict[str, int] = {}
    for index in range(display.get_n_monitors()):
        monitor = display.get_monitor(index)
        if monitor is None:
            continue
        rectangle = monitor.get_geometry()
        geometry = (
            int(rectangle.x),
            int(rectangle.y),
            int(rectangle.width),
            int(rectangle.height),
        )
        if geometry[2] <= 0 or geometry[3] <= 0:
            continue
        manufacturer = (monitor.get_manufacturer() or "").strip()
        model = (monitor.get_model() or "").strip()
        base_id = f"{manufacturer}|{model}" if manufacturer or model else (
            f"monitor-{index + 1}"
        )
        duplicate_counts[base_id] = duplicate_counts.get(base_id, 0) + 1
        occurrence = duplicate_counts[base_id]
        monitor_id = base_id if occurrence == 1 else f"{base_id}#{occurrence}"
        descriptors.append(
            {
                "id": monitor_id,
                "index": index,
                "manufacturer": manufacturer,
                "model": model,
                "geometry": geometry,
                "primary": monitor == primary,
            }
        )
    return descriptors


def read_monitor_selection(path: Path | None) -> str:
    if path is None:
        return "primary"
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return "primary"
    if not isinstance(payload, dict) or payload.get("version") != 1:
        return "primary"
    monitor_id = payload.get("monitor_id")
    if not isinstance(monitor_id, str) or not monitor_id.strip():
        return "primary"
    return monitor_id.strip()


def x11_selected_monitor(
    selection_path: Path | None,
) -> tuple[
    str,
    tuple[int, int, int, int],
    tuple[int, int, int, int],
] | None:
    descriptors = x11_monitor_descriptors()
    if not descriptors:
        return None
    selected_id = read_monitor_selection(selection_path)
    selected = None
    if selected_id != "primary":
        for descriptor in descriptors:
            if descriptor["id"] == selected_id:
                selected = descriptor
                break
    primary = next(
        (descriptor for descriptor in descriptors if descriptor["primary"]),
        descriptors[0],
    )
    if selected is None:
        selected_id = "primary"
        selected = primary
    geometry = selected["geometry"]
    primary_geometry = primary["geometry"]
    # Wine exposes the X11 primary monitor at (0, 0), even when that monitor
    # has a non-zero XRandR origin.  GetCursorPos/GetCursorInfo therefore use
    # coordinates relative to the primary monitor rather than X11 root
    # coordinates.  Publish the selected monitor in that exact coordinate
    # system so the hook can transform the final native cursor position back
    # to screen-local coordinates without guessing from an input packet.
    feedback_geometry = (
        geometry[0] - primary_geometry[0],
        geometry[1] - primary_geometry[1],
        geometry[2],
        geometry[3],
    )
    return selected_id, geometry, feedback_geometry


