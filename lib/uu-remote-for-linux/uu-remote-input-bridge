            "last_mouse_coordinate_space": (
                "virtual-desktop"
                if last_mouse_flags & MOUSE_VIRTUAL_DESKTOP
                else "selected-monitor"
                if last_mouse_flags & MOUSE_ABSOLUTE
                else "relative"
            ),
            "backend": backend,
            "portal_stream": portal_stream,
            "capture_state": capture_state,
            "capture_frames": capture_frames,
