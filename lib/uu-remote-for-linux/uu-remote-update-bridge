#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
用法：
  uu-remote-update-bridge setting-enabled SETTING_INI
  uu-remote-update-bridge watch SETTING_INI LAUNCHER LOG LOCK [INTERVAL [REQUEST [STATUS [PACKAGE_VERSION]]]]
EOF
}

auto_update_enabled() {
    local setting_file=$1 line key value
    local in_settings=false

    [[ -r $setting_file ]] || return 1
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        if [[ $line == \[*\] ]]; then
            if [[ ${line,,} == "[settingcenter]" ||
                ${line,,} == "[global]" ]]; then
                in_settings=true
            else
                in_settings=false
            fi
            continue
        fi
        $in_settings || continue
        [[ $line == *=* ]] || continue
        key=${line%%=*}
        value=${line#*=}
        key=${key//[[:space:]]/}
        value=${value//[[:space:]]/}
        if [[ ${key,,} == autoupdate ]]; then
            [[ $value == 1 || ${value,,} == true ]]
            return
        fi
    done <"$setting_file"
    return 1
}

log_message() {
    local log_file=$1
    shift

    mkdir -p -- "${log_file%/*}"
    printf '[%(%FT%T%z)T] %s\n' -1 "$*" >>"$log_file"
}

write_bridge_status() {
    local status_file=$1 package_version=$2 state=$3 temp

    [[ -n $status_file ]] || return 0
    mkdir -p -- "${status_file%/*}"
    temp="${status_file}.tmp.$$"
    {
        printf 'version=1\n'
        printf 'status=%s\n' "$state"
        printf 'package_version=%s\n' "$package_version"
        printf 'pid=%s\n' "$$"
        printf 'updated_at=%(%FT%T%z)T\n' -1
    } >"$temp"
    chmod 0600 "$temp"
    mv -f -- "$temp" "$status_file"
}

consume_upstream_update_request() {
    local request_file=$1 launcher=$2 log_file=$3
    local processing_file owner modified now age result=0

    [[ -e $request_file || -L $request_file ]] || return 1
    processing_file=${request_file%.request}.processing
    if [[ -L $request_file || ! -f $request_file ]]; then
        log_message "$log_file" \
            "拒绝非普通文件的 UU 更新接管请求"
        rm -f -- "$request_file"
        return 0
    fi
    owner=$(stat -c '%u' -- "$request_file" 2>/dev/null || printf invalid)
    modified=$(stat -c '%Y' -- "$request_file" 2>/dev/null || printf 0)
    now=$(date +%s)
    if [[ $owner != "$(id -u)" || ! $modified =~ ^[0-9]+$ ]]; then
        log_message "$log_file" \
            "拒绝所有者或时间戳无效的 UU 更新接管请求"
        rm -f -- "$request_file"
        return 0
    fi
    age=$((now - modified))
    if ((age < -5 || age > 300)); then
        log_message "$log_file" \
            "丢弃过期的 UU 更新接管请求（age=${age}s）"
        rm -f -- "$request_file"
        return 0
    fi
    if ! mv -f -- "$request_file" "$processing_file"; then
        log_message "$log_file" "无法原子接管 UU 更新请求"
        return 0
    fi

    log_message "$log_file" \
        "已接管 UU 内置更新请求，等待主控退出并执行兼容性检查"
    "$launcher" --upstream-update-handoff >>"$log_file" 2>&1 || result=$?
    rm -f -- "$processing_file"
    if ((result == 0)); then
        log_message "$log_file" "UU 内置更新接管完成，主程序恢复已请求"
    else
        log_message "$log_file" \
            "UU 内置更新接管返回 ${result}；已保留诊断状态并尝试恢复兼容客户端"
    fi
    return 0
}

watch_auto_update() {
    local setting_file=$1 launcher=$2 log_file=$3 lock_file=$4
    local interval=${5:-21600}
    local request_file=${6:-}
    local status_file=${7:-}
    local package_version=${8:-unknown}
    local state=disabled previous_state=""
    local manual_consumed=false

    [[ $interval =~ ^[1-9][0-9]*$ ]] || {
        printf '无效的更新检查间隔：%s\n' "$interval" >&2
        return 2
    }
    [[ $launcher == /* && -x $launcher ]] || {
        printf '启动器必须是可执行的绝对路径：%s\n' "$launcher" >&2
        return 2
    }
    if [[ -n $request_file && $request_file != /* ]]; then
        printf '更新接管请求必须是绝对路径：%s\n' "$request_file" >&2
        return 2
    fi
    if [[ -n $status_file && $status_file != /* ]]; then
        printf '更新桥状态必须是绝对路径：%s\n' "$status_file" >&2
        return 2
    fi

    mkdir -p -- "${lock_file%/*}" "${log_file%/*}"
    exec 8>"$lock_file"
    flock -n 8 || return 0
    # The launcher starts this watcher through nohup.  Keep nohup's inherited
    # SIGHUP ignore disposition so a short-lived terminal/launcher cannot tear
    # down automatic checks; still honor explicit INT/TERM shutdown.
    trap 'exit 0' INT TERM

    write_bridge_status "$status_file" "$package_version" active
    log_message "$log_file" "自动更新兼容桥开始监视 UU 设置"
    while [[ -x $launcher ]]; do
        manual_consumed=false
        if [[ -n $request_file ]] &&
            consume_upstream_update_request \
                "$request_file" "$launcher" "$log_file"; then
            manual_consumed=true
        fi
        if auto_update_enabled "$setting_file"; then
            state=enabled
        else
            state=disabled
        fi
        if [[ $state != "$previous_state" ]]; then
            log_message "$log_file" "UU 内置自动更新开关：$state"
            previous_state=$state
        fi
        # Linux owns the safe update policy.  UU's in-app switch is still
        # observed for diagnostics, but disabling it must not suppress the
        # launcher's periodic official-version check.
        if ! $manual_consumed; then
            if ! "$launcher" --auto-update-check \
                >>"$log_file" 2>&1; then
                log_message "$log_file" \
                    "本次自动更新检查未完成；现有客户端与兼容桥保持不变"
            fi
        fi

        # React to a switch change quickly without hitting the release endpoint
        # every few seconds.  One second slices also make TERM responsive.
        for ((remaining = interval; remaining > 0; remaining--)); do
            [[ -x $launcher ]] || break 2
            sleep 1
            if [[ -n $request_file &&
                ( -e $request_file || -L $request_file ) ]]; then
                break
            fi
            if auto_update_enabled "$setting_file"; then
                [[ $state == enabled ]] || break
            else
                [[ $state == disabled ]] || break
            fi
        done
    done
    write_bridge_status "$status_file" "$package_version" stopped
    log_message "$log_file" "启动器已移除，自动更新兼容桥退出"
}

mode=${1:-}
case $mode in
    setting-enabled)
        (($# == 2)) || {
            usage >&2
            exit 2
        }
        auto_update_enabled "$2"
        ;;
    watch)
        (($# >= 5 && $# <= 9)) || {
            usage >&2
            exit 2
        }
        watch_auto_update \
            "$2" "$3" "$4" "$5" "${6:-21600}" "${7:-}" \
            "${8:-}" "${9:-unknown}"
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
