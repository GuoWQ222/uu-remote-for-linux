#!/usr/bin/env python3
"""Derive a fail-closed NVDEC patch profile from an official streamer.dll."""

from __future__ import annotations

import argparse
import bisect
import hashlib
import re
import struct
import sys
from dataclasses import dataclass
from pathlib import Path


PATCH_1_AFTER = bytes.fromhex("b2 21 90")
PATCH_2_AFTER = bytes.fromhex("6a 21 58")
PROBE_MARKERS = (
    b"failed to get StreamerCodecDetector.exe path",
    b"failed to create pipe for batch probe: {}",
    b"batch probe: encoder {} adapter {} device {}",
    b"BATCH_DONE",
    b"RESULT,%d,%d,%d,%d,%d,%d",
    b"batch probe: adapter {} returned {} results",
    b"batch probe: adapter {} output missing BATCH_DONE, discarding",
)
RESULT_MARKER = b"RESULT,%d,%d,%d,%d,%d,%d"
FALLBACK_MARKER = b"decoder probe produced only software fallback"


class ProfileError(RuntimeError):
    pass


@dataclass(frozen=True)
class Section:
    name: bytes
    virtual_size: int
    rva: int
    raw_size: int
    raw_offset: int
    characteristics: int


@dataclass(frozen=True)
class RuntimeFunction:
    begin: int
    end: int


@dataclass(frozen=True)
class PeImage:
    data: bytes
    sections: tuple[Section, ...]
    text: Section
    rdata: Section
    pdata: Section

    def file_offset(self, rva: int) -> int:
        for section in self.sections:
            span = max(section.virtual_size, section.raw_size)
            if section.rva <= rva < section.rva + span:
                offset = section.raw_offset + rva - section.rva
                if offset < len(self.data):
                    return offset
        raise ProfileError(f"RVA 不属于文件节：{rva:#x}")


def parse_pe(data: bytes) -> PeImage:
    if len(data) < 0x100 or data[:2] != b"MZ":
        raise ProfileError("streamer.dll 不是有效的 PE 文件")
    pe_offset = struct.unpack_from("<I", data, 0x3C)[0]
    if pe_offset + 24 > len(data) or data[pe_offset : pe_offset + 4] != b"PE\0\0":
        raise ProfileError("streamer.dll 缺少有效的 PE 签名")
    machine, section_count = struct.unpack_from("<HH", data, pe_offset + 4)
    optional_size = struct.unpack_from("<H", data, pe_offset + 20)[0]
    optional = pe_offset + 24
    if machine != 0x8664:
        raise ProfileError("仅支持官方 Win64 streamer.dll")
    if optional + optional_size > len(data) or struct.unpack_from("<H", data, optional)[0] != 0x20B:
        raise ProfileError("streamer.dll 的 PE32+ 可选头无效")

    table = optional + optional_size
    sections: list[Section] = []
    for index in range(section_count):
        header = table + index * 40
        if header + 40 > len(data):
            raise ProfileError("PE 节表越界")
        name = data[header : header + 8].rstrip(b"\0")
        virtual_size, rva, raw_size, raw_offset = struct.unpack_from(
            "<IIII", data, header + 8
        )
        characteristics = struct.unpack_from("<I", data, header + 36)[0]
        if raw_offset + raw_size > len(data):
            raise ProfileError(f"PE 节范围越界：{name.decode(errors='replace')}")
        sections.append(
            Section(name, virtual_size, rva, raw_size, raw_offset, characteristics)
        )

    def required(name: bytes) -> Section:
        matches = [section for section in sections if section.name == name]
        if len(matches) != 1:
            raise ProfileError(f"PE 缺少唯一的 {name.decode()} 节")
        return matches[0]

    text = required(b".text")
    rdata = required(b".rdata")
    pdata = required(b".pdata")
    if not text.characteristics & 0x20000000:
        raise ProfileError("PE .text 节不可执行")
    return PeImage(data, tuple(sections), text, rdata, pdata)


def printable_strings(image: PeImage) -> dict[bytes, list[int]]:
    section = image.rdata
    raw = image.data[section.raw_offset : section.raw_offset + section.raw_size]
    strings: dict[bytes, list[int]] = {}
    for match in re.finditer(rb"[ -~]{3,}\0", raw):
        value = match.group()[:-1]
        strings.setdefault(value, []).append(section.rva + match.start())
    return strings


def runtime_functions(image: PeImage) -> list[RuntimeFunction]:
    functions: list[RuntimeFunction] = []
    start = image.pdata.raw_offset
    end = start + image.pdata.raw_size
    text_end = image.text.rva + max(image.text.virtual_size, image.text.raw_size)
    for offset in range(start, end - 11, 12):
        begin, finish, _ = struct.unpack_from("<III", image.data, offset)
        if image.text.rva <= begin < finish <= text_end:
            functions.append(RuntimeFunction(begin, finish))
    functions.sort(key=lambda item: item.begin)
    if not functions:
        raise ProfileError("PE .pdata 中没有有效的 x64 函数边界")
    return functions


def rip_relative_lea_xrefs(image: PeImage) -> list[tuple[int, int]]:
    refs: list[tuple[int, int]] = []
    start = image.text.raw_offset
    end = start + image.text.raw_size
    for offset in range(start, end - 6):
        if not 0x40 <= image.data[offset] <= 0x4F:
            continue
        if image.data[offset + 1] != 0x8D or image.data[offset + 2] & 0xC7 != 0x05:
            continue
        instruction_rva = image.text.rva + offset - start
        displacement = struct.unpack_from("<i", image.data, offset + 3)[0]
        refs.append((instruction_rva, instruction_rva + 7 + displacement))
    return refs


def locate_probe_function(
    image: PeImage,
) -> tuple[RuntimeFunction, dict[bytes, list[int]]]:
    strings = printable_strings(image)
    fallback_rvas = [
        rva
        for value, rvas in strings.items()
        if FALLBACK_MARKER in value
        for rva in rvas
    ]
    if len(fallback_rvas) != 1:
        raise ProfileError("缺少或重复的 NVDEC 软件回退语义标记")
    marker_rvas: dict[int, bytes] = {}
    for marker in PROBE_MARKERS:
        rvas = strings.get(marker, ())
        if len(rvas) != 1:
            raise ProfileError(
                f"缺少或重复的 NVDEC 探测语义标记：{marker.decode()}"
            )
        marker_rvas[rvas[0]] = marker

    functions = runtime_functions(image)
    begins = [item.begin for item in functions]
    references: dict[RuntimeFunction, dict[bytes, list[int]]] = {}
    for instruction, target in rip_relative_lea_xrefs(image):
        marker = marker_rvas.get(target)
        if marker is None:
            continue
        index = bisect.bisect_right(begins, instruction) - 1
        if index < 0:
            continue
        function = functions[index]
        if function.begin <= instruction < function.end:
            references.setdefault(function, {}).setdefault(marker, []).append(instruction)

    candidates = [
        (function, refs)
        for function, refs in references.items()
        if set(refs) == set(PROBE_MARKERS)
        and all(len(refs[marker]) == 1 for marker in PROBE_MARKERS)
        and 0x800 <= function.end - function.begin <= 0x1800
    ]
    if len(candidates) != 1:
        details = ", ".join(
            f"{function.begin:#x}-{function.end:#x}"
            for function, _ in candidates
        )
        raise ProfileError(
            "NVDEC 批量探测函数不是唯一匹配："
            f"候选数={len(candidates)}{('，' + details) if details else ''}"
        )
    return candidates[0]


def derive_patch_offsets(image: PeImage) -> tuple[int, int]:
    function, refs = locate_probe_function(image)
    start = image.file_offset(function.begin)
    finish = image.file_offset(function.end - 1) + 1
    code = image.data[start:finish]

    # Both 4.34-4.37 and the recompiled 4.38 function first preserve r8 in rbx,
    # save the incoming probe selector (edx) in an rbp local, then preserve rcx.
    # Register allocation and the frame displacement may change, so bind the
    # two patch sites through that local rather than a full compiler byte blob.
    selector_matches = list(
        re.finditer(rb"\x49\x8b\xd8\x89\x55(.)\x4c\x8b[\xe1\xf1]", code)
    )
    if len(selector_matches) != 1:
        raise ProfileError(
            "NVDEC 选择参数保存点不是唯一匹配："
            f"候选数={len(selector_matches)}"
        )
    selector_match = selector_matches[0]
    first_relative = selector_match.start() + 3
    frame_displacement = selector_match.group(1)
    first = start + first_relative

    result_reference = refs[RESULT_MARKER][0] - function.begin
    result_pattern = b"\x8b\x45" + frame_displacement
    result_matches: list[int] = []
    cursor = 0
    while True:
        position = code.find(result_pattern, cursor)
        if position < 0:
            break
        # The selected implementation is copied into the 0x28-byte capability
        # record, immediately followed by the two parsed boolean fields.
        if (
            code[position + 3 : position + 5] == b"\x89\x85"
            and code[position + 9 : position + 11] == b"\x0f\xb6"
            and 0x40 <= position - result_reference <= 0xC0
        ):
            result_matches.append(position)
        cursor = position + 1
    if len(result_matches) != 1:
        raise ProfileError(
            "NVDEC 能力实现字段不是唯一匹配："
            f"候选数={len(result_matches)}"
        )
    second = start + result_matches[0]
    if not 0x800 <= second - first <= 0xD00:
        raise ProfileError(
            f"NVDEC 两个语义点不属于同一已知数据流：间距={second - first:#x}"
        )
    return first, second


def derive_profile(data: bytes, version: str) -> tuple[str, bytes]:
    if not re.fullmatch(r"[0-9]+(?:\.[0-9]+){2,3}", version):
        raise ProfileError("UU 版本号格式无效")
    image = parse_pe(data)
    first, second = derive_patch_offsets(image)
    first_before = data[first : first + 3]
    second_before = data[second : second + 3]
    if first_before[:2] != b"\x89\x55" or second_before[:2] != b"\x8b\x45":
        raise ProfileError("NVDEC 补丁位置原始指令边界无效")
    if first_before[2] != second_before[2]:
        raise ProfileError("NVDEC 选择参数与能力字段没有引用同一栈变量")

    patched = bytearray(data)
    patched[first : first + 3] = PATCH_1_AFTER
    patched[second : second + 3] = PATCH_2_AFTER
    patched_bytes = bytes(patched)
    row = "\t".join(
        (
            version,
            hashlib.sha256(data).hexdigest(),
            hashlib.sha256(patched_bytes).hexdigest(),
            hex(first),
            first_before.hex(),
            PATCH_1_AFTER.hex(),
            hex(second),
            second_before.hex(),
            PATCH_2_AFTER.hex(),
        )
    )
    return row, patched_bytes


def add_lea(
    data: bytearray,
    file_offset: int,
    instruction_rva: int,
    target_rva: int,
) -> None:
    data[file_offset : file_offset + 3] = b"\x48\x8d\x15"
    struct.pack_into("<i", data, file_offset + 3, target_rva - instruction_rva - 7)


def synthetic_pe(
    duplicate: bool = False,
    frame_displacement: int = 0xD0,
    second_relative: int = 0x850,
) -> bytes:
    data = bytearray(0x4000)
    data[:2] = b"MZ"
    struct.pack_into("<I", data, 0x3C, 0x80)
    data[0x80:0x84] = b"PE\0\0"
    struct.pack_into("<HH", data, 0x84, 0x8664, 3)
    struct.pack_into("<H", data, 0x94, 0xF0)
    struct.pack_into("<H", data, 0x98, 0x20B)
    table = 0x80 + 24 + 0xF0
    sections = (
        (b".text", 0x3000, 0x1000, 0x3000, 0x400, 0x60000020),
        (b".rdata", 0x800, 0x5000, 0x800, 0x3400, 0x40000040),
        (b".pdata", 0x200, 0x6000, 0x200, 0x3C00, 0x40000040),
    )
    for index, (name, virtual_size, rva, raw_size, raw_offset, flags) in enumerate(sections):
        header = table + index * 40
        data[header : header + len(name)] = name
        struct.pack_into(
            "<IIII",
            data,
            header + 8,
            virtual_size,
            rva,
            raw_size,
            raw_offset,
        )
        struct.pack_into("<I", data, header + 36, flags)

    marker_rvas: dict[bytes, int] = {}
    cursor = 0x3500
    for marker in PROBE_MARKERS + (FALLBACK_MARKER,):
        value = marker + b"\0"
        data[cursor : cursor + len(value)] = value
        marker_rvas[marker] = 0x5000 + cursor - 0x3400
        cursor += len(value) + 8

    def add_function(raw: int, rva: int) -> None:
        data[raw : raw + 16] = bytes.fromhex(
            "48 89 5c 24 20 55 56 57 41 54 41 55 41 56 41 57"
        )
        data[raw + 0x30 : raw + 0x39] = (
            bytes.fromhex("49 8b d8 89 55")
            + bytes((frame_displacement,))
            + bytes.fromhex("4c 8b f1")
        )
        offsets = (
            0x100,
            0x120,
            0x140,
            0x160,
            second_relative - 0x51,
            0x180,
            0x1A0,
        )
        for marker, relative in zip(PROBE_MARKERS, offsets):
            add_lea(data, raw + relative, rva + relative, marker_rvas[marker])
        data[raw + second_relative : raw + second_relative + 14] = (
            bytes.fromhex("8b 45")
            + bytes((frame_displacement,))
            + bytes.fromhex("89 85 00 02 00 00 0f b6 45 a8 c3")
        )

    add_function(0x500, 0x1100)
    struct.pack_into("<III", data, 0x3C00, 0x1100, 0x1E00, 0x7000)
    if duplicate:
        add_function(0x1800, 0x2400)
        struct.pack_into("<III", data, 0x3C0C, 0x2400, 0x3100, 0x7010)
    return bytes(data)


def self_test() -> None:
    fixture = synthetic_pe()
    row, patched = derive_profile(fixture, "9.9.9.9")
    columns = row.split("\t")
    if len(columns) != 9 or columns[3] != "0x533" or columns[6] != "0xd50":
        raise ProfileError("自检生成的偏移或字段数错误")
    if patched[0x533:0x536] != PATCH_1_AFTER:
        raise ProfileError("自检选择补丁未写入")
    if patched[0xD50:0xD53] != PATCH_2_AFTER:
        raise ProfileError("自检能力补丁未写入")
    current_fixture = synthetic_pe(
        frame_displacement=0x30,
        second_relative=0xC00,
    )
    current_row, current_patched = derive_profile(current_fixture, "9.9.9.10")
    current_columns = current_row.split("\t")
    if (
        current_columns[3] != "0x533"
        or current_columns[4] != "895530"
        or current_columns[6] != "0x1100"
        or current_columns[7] != "8b4530"
    ):
        raise ProfileError("自检未识别扩展栈帧的 NVDEC 数据流")
    if current_patched[0x1100:0x1103] != PATCH_2_AFTER:
        raise ProfileError("自检扩展布局能力补丁未写入")
    try:
        derive_profile(synthetic_pe(duplicate=True), "9.9.9.9")
    except ProfileError:
        pass
    else:
        raise ProfileError("自检未拒绝重复的 NVDEC 语义候选")
    print("NVDEC 自动档案生成器自检通过")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--derive", type=Path)
    parser.add_argument("--version")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    try:
        if args.self_test:
            self_test()
            return 0
        if args.derive is None or not args.version:
            parser.error("--derive 和 --version 必须同时提供")
        row, _ = derive_profile(args.derive.read_bytes(), args.version)
        print(row)
        return 0
    except (OSError, ProfileError) as error:
        print(f"错误：{error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
