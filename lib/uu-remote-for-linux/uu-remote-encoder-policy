#!/usr/bin/env python3
"""Atomically prefer UU's NVENC capabilities while retaining a safe backup."""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import shutil
import struct
import sys
import tempfile
import time
from pathlib import Path


NVENC_V8_IMPL = 0
NVENC_V11_IMPL = 1
SOFTWARE_IMPLS = {5, 6}
PATCHED_NVDEC_IMPL = 33


def read_u16(data: bytes, offset: int) -> int:
    return struct.unpack_from("<H", data, offset)[0]


def read_u32(data: bytes, offset: int) -> int:
    return struct.unpack_from("<I", data, offset)[0]


def read_u64(data: bytes, offset: int) -> int:
    return struct.unpack_from("<Q", data, offset)[0]


def fail(message: str) -> "NoReturn":
    print(f"错误：{message}", file=sys.stderr)
    raise SystemExit(1)


def load_cache(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"编码器能力缓存尚未生成：{path}")
    except (OSError, json.JSONDecodeError) as error:
        fail(f"无法读取编码器能力缓存：{error}")
    if not isinstance(data, dict) or not isinstance(
        data.get("encoder_capabilities"), list
    ):
        fail("编码器能力缓存结构无效")
    return data


def atomic_write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(data, stream, ensure_ascii=False, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def capability_is_nvenc(row: object) -> bool:
    return isinstance(row, dict) and row.get("codec_impl") == NVENC_V8_IMPL


def capability_is_nvenc_source(row: object) -> bool:
    return isinstance(row, dict) and row.get("codec_impl") in {
        NVENC_V8_IMPL,
        NVENC_V11_IMPL,
        PATCHED_NVDEC_IMPL,
    }


def capability_is_openh264(row: object) -> bool:
    return (
        isinstance(row, dict)
        and row.get("video_codec") == 1
        and row.get("adapter_id") == 0
        and row.get("device_id") == 0
        and row.get("codec_impl") in SOFTWARE_IMPLS
    )


def nvenc_codecs_for_extent(
    rows: list,
    device_id: int,
    adapter_id: int,
    minimum_width: int,
    minimum_height: int,
) -> set:
    return {
        row.get("video_codec")
        for row in rows
        if capability_is_nvenc(row)
        and row.get("device_id") == device_id
        and row.get("adapter_id") == adapter_id
        and row.get("bit_depth") == 8
        and row.get("width", 0) >= minimum_width
        and row.get("height", 0) >= minimum_height
    }


def validate_nvenc_rows(rows: list, device_id: int, adapter_id: int) -> None:
    landscape_codecs = nvenc_codecs_for_extent(
        rows, device_id, adapter_id, 1920, 1080
    )
    portrait_codecs = nvenc_codecs_for_extent(
        rows, device_id, adapter_id, 1080, 1920
    )
    orientation_neutral_codecs = {
        row.get("video_codec")
        for row in rows
        if capability_is_nvenc(row)
        and row.get("device_id") == device_id
        and row.get("adapter_id") == adapter_id
        and row.get("bit_depth") == 8
        and row.get("width", 0) >= 1920
        and row.get("width") == row.get("height")
    }
    if not {1, 2}.issubset(landscape_codecs):
        fail("能力缓存没有同时包含可用的 H.264 与 HEVC NVENC 档案")
    if not {1, 2}.issubset(portrait_codecs):
        fail("能力缓存没有同时包含可用的 H.264 与 HEVC 竖屏 NVENC 档案")
    if not {1, 2}.issubset(orientation_neutral_codecs):
        fail("能力缓存的 H.264 与 HEVC NVENC 档案仍受固定屏幕方向限制")


def normalize_orientation_capabilities(rows: list, hardware_rows: list) -> int:
    expanded = 0
    for row in hardware_rows:
        width = row.get("width", 0)
        height = row.get("height", 0)
        if not isinstance(width, int) or not isinstance(height, int):
            continue
        if width <= 0 or height <= 0 or width == height:
            continue
        maximum = max(width, height)
        row["width"] = maximum
        row["height"] = maximum
        expanded += 1

    unique_rows = []
    seen = set()
    for row in rows:
        key = json.dumps(row, sort_keys=True, separators=(",", ":"))
        if key in seen:
            continue
        seen.add(key)
        unique_rows.append(row)
    rows[:] = unique_rows
    hardware_rows[:] = [row for row in rows if capability_is_nvenc_source(row)]
    return expanded


def enable(cache: Path, backup: Path, device_id: int, adapter_id: int) -> None:
    data = load_cache(cache)
    rows = data["encoder_capabilities"]
    hardware_rows = [row for row in rows if capability_is_nvenc_source(row)]
    if not hardware_rows:
        fail("UU 尚未探测到 NVIDIA 硬件编码器，拒绝移除 OpenH264 回退项")

    migrated = 0
    for row in hardware_rows:
        if row.get("codec_impl") != NVENC_V8_IMPL:
            migrated += 1
        row["codec_impl"] = NVENC_V8_IMPL
        row["device_id"] = device_id
        row["adapter_id"] = adapter_id
    orientation_expanded = normalize_orientation_capabilities(
        rows, hardware_rows
    )
    validate_nvenc_rows(hardware_rows, device_id, adapter_id)

    if not backup.is_file() and (
        any(capability_is_openh264(row) for row in rows) or migrated
    ):
        backup.parent.mkdir(parents=True, exist_ok=True)
        temporary = backup.with_name(f".{backup.name}.new")
        shutil.copy2(cache, temporary)
        os.replace(temporary, backup)

    data["encoder_capabilities"] = [
        row for row in rows if not capability_is_openh264(row)
    ]
    atomic_write_json(cache, data)
    verify(cache, device_id, adapter_id)
    print(
        f"NVENC_POLICY_OK\tdevice={device_id}\tadapter={adapter_id}"
        f"\timpl={NVENC_V8_IMPL}\tmigrated={migrated}"
        f"\torientation_expanded={orientation_expanded}"
        f"\tentries={len(data['encoder_capabilities'])}"
    )


def verify(cache: Path, device_id: int, adapter_id: int) -> None:
    rows = load_cache(cache)["encoder_capabilities"]
    if any(capability_is_openh264(row) for row in rows):
        fail("OpenH264 仍位于活动能力缓存中")
    if any(
        capability_is_nvenc_source(row) and not capability_is_nvenc(row)
        for row in rows
    ):
        fail("活动能力缓存仍包含未迁移的 NVENC V11/NVDEC 实现编号")
    validate_nvenc_rows(rows, device_id, adapter_id)


def watch(
    cache: Path,
    backup: Path,
    device_id: int,
    adapter_id: int,
    enabled_stamp: Path,
    lock_path: Path,
) -> None:
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        while enabled_stamp.is_file():
            try:
                verify(cache, device_id, adapter_id)
            except SystemExit:
                try:
                    enable(cache, backup, device_id, adapter_id)
                except SystemExit:
                    pass
            time.sleep(0.5)


def disable(cache: Path, backup: Path) -> None:
    if not backup.is_file():
        print("没有 NVENC 策略备份，无需恢复。")
        return
    cache.parent.mkdir(parents=True, exist_ok=True)
    temporary = cache.with_name(f".{cache.name}.restore")
    shutil.copy2(backup, temporary)
    os.replace(temporary, cache)
    backup.unlink()
    print("已恢复包含 OpenH264 安全回退项的原始编码器能力缓存。")


def parse_id(value: str, label: str) -> int:
    try:
        result = int(value, 10)
    except ValueError:
        fail(f"{label} 不是十进制整数：{value}")
    if result < 0 or result > 0xFFFFFFFF:
        fail(f"{label} 超出有效范围：{value}")
    return result


def probe_streamer(path: Path, *, emit: bool = True) -> dict[str, object]:
    """Find the GDI RawVideoFrame adapter-id vtable slot without fixed RVAs."""
    try:
        data = path.read_bytes()
    except OSError as error:
        fail(f"无法读取 streamer.dll：{error}")
    try:
        if data[:2] != b"MZ":
            raise ValueError("缺少 MZ 文件头")
        pe_offset = read_u32(data, 0x3C)
        if data[pe_offset : pe_offset + 4] != b"PE\0\0":
            raise ValueError("缺少 PE 文件头")
        section_count = read_u16(data, pe_offset + 6)
        optional_size = read_u16(data, pe_offset + 20)
        optional_offset = pe_offset + 24
        if read_u16(data, optional_offset) != 0x20B:
            raise ValueError("不是 Win64 PE32+ 文件")
        image_base = read_u64(data, optional_offset + 24)
        section_offset = optional_offset + optional_size
        sections: dict[str, tuple[int, int, int, int]] = {}
        for index in range(section_count):
            offset = section_offset + index * 40
            name = data[offset : offset + 8].split(b"\0", 1)[0].decode(
                "ascii", errors="strict"
            )
            virtual_size = read_u32(data, offset + 8)
            virtual_address = read_u32(data, offset + 12)
            raw_size = read_u32(data, offset + 16)
            raw_offset = read_u32(data, offset + 20)
            sections[name] = (
                virtual_address,
                virtual_size,
                raw_offset,
                raw_size,
            )
        text = sections[".text"]
        rdata = sections[".rdata"]
    except (IndexError, KeyError, UnicodeDecodeError, struct.error, ValueError) as error:
        fail(f"streamer.dll 的 PE 结构无效：{error}")

    def rva_to_offset(rva: int, size: int) -> int:
        for virtual_address, virtual_size, raw_offset, raw_size in sections.values():
            span = max(virtual_size, raw_size)
            if (
                virtual_address <= rva
                and size <= span
                and rva - virtual_address <= span - size
            ):
                result = raw_offset + rva - virtual_address
                if result < 0 or result + size > len(data):
                    break
                return result
        raise ValueError(f"RVA 0x{rva:x} 不在有效节内")

    def offset_to_rva(offset: int, size: int) -> int:
        for virtual_address, virtual_size, raw_offset, raw_size in sections.values():
            if (
                raw_offset <= offset
                and size <= raw_size
                and offset - raw_offset <= raw_size - size
            ):
                return virtual_address + offset - raw_offset
        raise ValueError(f"文件偏移 0x{offset:x} 不在有效节内")

    text_rva, text_virtual_size, text_offset, text_raw_size = text
    rdata_rva, rdata_virtual_size, _, rdata_raw_size = rdata
    text_size = min(text_virtual_size, text_raw_size)
    text_end = text_offset + text_size
    candidates: list[tuple[int, int]] = []
    prefix = bytes.fromhex("e80000000090488d05")
    suffix = bytes.fromhex("4989074989b7a8000000")

    for offset in range(text_offset, max(text_offset, text_end - 22)):
        instruction = data[offset : offset + 23]
        if (
            len(instruction) != 23
            or instruction[0] != prefix[0]
            or instruction[5:9] != prefix[5:9]
            or instruction[13:23] != suffix
        ):
            continue
        instruction_rva = text_rva + offset - text_offset
        displacement = struct.unpack_from("<i", instruction, 9)[0]
        vtable_rva = instruction_rva + 13 + displacement
        if not (
            rdata_rva <= vtable_rva
            and vtable_rva + 7 * 8
            <= rdata_rva + max(rdata_virtual_size, rdata_raw_size)
        ):
            continue
        try:
            vtable_offset = rva_to_offset(vtable_rva, 7 * 8)
            entries = struct.unpack_from("<7Q", data, vtable_offset)

            def function_bytes(address: int, size: int) -> bytes:
                return data[rva_to_offset(address - image_base, size) :][
                    :size
                ]

            valid = (
                entries[4] == entries[5]
                and function_bytes(entries[1], 6) == bytes.fromhex("b801000000c3")
                and function_bytes(entries[2], 3) == bytes.fromhex("b001c3")
                and function_bytes(entries[3], 12)
                == bytes.fromhex("4883b9a8000000000f95c0c3")
                and function_bytes(entries[5], 3) == bytes.fromhex("33c0c3")
            )
        except (ValueError, struct.error):
            continue
        if valid:
            candidates.append((vtable_rva, vtable_rva + 5 * 8))

    if len(candidates) != 1:
        fail(
            "无法唯一定位 GDI 捕获帧的适配器 LUID 虚函数；"
            f"候选数={len(candidates)}"
        )
    vtable_rva, slot_rva = candidates[0]

    adapter_getter_pattern = bytes.fromhex("8b4144c3")
    adapter_getter_offsets: list[int] = []
    search_offset = text_offset
    while True:
        search_offset = data.find(
            adapter_getter_pattern, search_offset, text_end
        )
        if search_offset < 0:
            break
        adapter_getter_offsets.append(search_offset)
        search_offset += 1
    if len(adapter_getter_offsets) != 1:
        fail(
            "无法唯一定位 RawVideoFrame 的适配器 LUID 基类函数；"
            f"候选数={len(adapter_getter_offsets)}"
        )
    adapter_getter_rva = (
        text_rva + adapter_getter_offsets[0] - text_offset
    )
    encoder_accessor_prefix = bytes.fromhex(
        "48895c2410574883ec20488bf9488b5928"
    )
    encoder_adapter_call = bytes.fromhex("488b00ff5030")
    encoder_accessor_offsets: list[int] = []
    search_offset = text_offset
    while True:
        search_offset = data.find(
            encoder_accessor_prefix, search_offset, text_end
        )
        if search_offset < 0:
            break
        window_end = min(search_offset + 96, text_end)
        if data.find(
            encoder_adapter_call,
            search_offset + len(encoder_accessor_prefix),
            window_end,
        ) >= 0:
            encoder_accessor_offsets.append(search_offset)
        search_offset += 1
    if len(encoder_accessor_offsets) != 1:
        fail(
            "无法唯一定位编码器实际读取的队列包装帧适配器方法；"
            f"候选数={len(encoder_accessor_offsets)}"
        )
    encoder_accessor_rva = (
        text_rva + encoder_accessor_offsets[0] - text_offset
    )

    def unique_ascii_rva(value: bytes) -> int:
        needle = value + b"\0"
        offsets: list[int] = []
        offset = 0
        while True:
            offset = data.find(needle, offset)
            if offset < 0:
                break
            offsets.append(offset)
            offset += 1
        if len(offsets) != 1:
            raise ValueError(
                f"字符串 {value!r} 的候选数={len(offsets)}"
            )
        return offset_to_rva(offsets[0], len(needle))

    def has_rip_lea(
        start: int, end: int, opcode: bytes, target_rva: int
    ) -> bool:
        matches = 0
        offset = start
        while True:
            offset = data.find(opcode, offset, end)
            if offset < 0 or offset + 7 > end:
                break
            instruction_rva = text_rva + offset - text_offset
            displacement = struct.unpack_from("<i", data, offset + 3)[0]
            if instruction_rva + 7 + displacement == target_rva:
                matches += 1
            offset += 1
        return matches == 1

    impl_switch_candidates: list[int] = []
    if (
        data.count(b"Nvenc V8\0") == 1
        and data.count(b"Nvenc V11\0") == 1
        and data.count(b"SoftWare\0") == 1
    ):
        implementation_profile = "nvenc-v8-v11"
        software_impl = 6
        try:
            nvenc_v8_name_rva = unique_ascii_rva(b"Nvenc V8")
            nvenc_v11_name_rva = unique_ascii_rva(b"Nvenc V11")
            software_name_rva = unique_ascii_rva(b"SoftWare")
        except ValueError as error:
            fail(f"无法验证编码器实现编号字符串：{error}")
        switch_prefix = bytes.fromhex("0fb6432083f806")
        offset = text_offset
        while True:
            offset = data.find(switch_prefix, offset, text_end)
            if offset < 0:
                break
            if (
                offset + 22 > text_end
                or data[offset + 7] != 0x77
                or data[offset + 9 : offset + 13]
                != bytes.fromhex("418b8c87")
                or data[offset + 17 : offset + 22]
                != bytes.fromhex("4903cfffe1")
            ):
                offset += 1
                continue
            switch_rva = text_rva + offset - text_offset
            default_rva = switch_rva + 9 + struct.unpack_from(
                "<b", data, offset + 8
            )[0]
            table_rva = read_u32(data, offset + 13)
            try:
                table_offset = rva_to_offset(table_rva, 7 * 4)
                targets = struct.unpack_from("<7I", data, table_offset)
                target_offsets = [rva_to_offset(target, 7) for target in targets]
            except (ValueError, struct.error):
                offset += 1
                continue
            expected_cases = (
                bytes.fromhex("488955c7"),
                bytes.fromhex("4c8945c7"),
                bytes.fromhex("4c894dc7"),
                bytes.fromhex("4c8955c7"),
                bytes.fromhex("4c895dc7"),
                bytes.fromhex("488d05"),
                bytes.fromhex("4c8965c7"),
            )
            if any(
                data[target_offset : target_offset + len(pattern)] != pattern
                for target_offset, pattern in zip(target_offsets, expected_cases)
            ):
                offset += 1
                continue
            load_start = max(text_offset, offset - 512)
            if (
                default_rva == targets[6]
                and has_rip_lea(
                    load_start,
                    offset,
                    bytes.fromhex("488d15"),
                    nvenc_v8_name_rva,
                )
                and has_rip_lea(
                    load_start,
                    offset,
                    bytes.fromhex("4c8d05"),
                    nvenc_v11_name_rva,
                )
                and has_rip_lea(
                    load_start,
                    offset,
                    bytes.fromhex("4c8d25"),
                    software_name_rva,
                )
            ):
                impl_switch_candidates.append(switch_rva)
            offset += 1
    elif (
        data.count(b"Nvenc\0") == 1
        and data.count(b"SoftWare\0") == 1
    ):
        implementation_profile = "unified-nvenc"
        software_impl = 5
        try:
            nvenc_name_rva = unique_ascii_rva(b"Nvenc")
            software_name_rva = unique_ascii_rva(b"SoftWare")
        except ValueError as error:
            fail(f"无法验证编码器实现编号字符串：{error}")
        switch_prefix = bytes.fromhex("0fb6472083f805")
        offset = text_offset
        while True:
            offset = data.find(switch_prefix, offset, text_end)
            if offset < 0:
                break
            if (
                offset + 22 > text_end
                or data[offset + 7] != 0x77
                or data[offset + 9 : offset + 13]
                != bytes.fromhex("418b8c84")
                or data[offset + 17 : offset + 22]
                != bytes.fromhex("4903ccffe1")
            ):
                offset += 1
                continue
            switch_rva = text_rva + offset - text_offset
            default_rva = switch_rva + 9 + struct.unpack_from(
                "<b", data, offset + 8
            )[0]
            table_rva = read_u32(data, offset + 13)
            try:
                table_offset = rva_to_offset(table_rva, 6 * 4)
                targets = struct.unpack_from("<6I", data, table_offset)
                target_offsets = [rva_to_offset(target, 7) for target in targets]
            except (ValueError, struct.error):
                offset += 1
                continue
            expected_cases = (
                bytes.fromhex("4c894597"),
                bytes.fromhex("4c894d97"),
                bytes.fromhex("4c895597"),
                bytes.fromhex("4c895d97"),
                bytes.fromhex("488d05"),
                bytes.fromhex("48895597"),
            )
            if any(
                data[target_offset : target_offset + len(pattern)] != pattern
                for target_offset, pattern in zip(target_offsets, expected_cases)
            ):
                offset += 1
                continue
            load_start = max(text_offset, offset - 512)
            if (
                default_rva == targets[5]
                and has_rip_lea(
                    load_start,
                    offset,
                    bytes.fromhex("4c8d05"),
                    nvenc_name_rva,
                )
                and has_rip_lea(
                    load_start,
                    offset,
                    bytes.fromhex("488d15"),
                    software_name_rva,
                )
            ):
                impl_switch_candidates.append(switch_rva)
            offset += 1
    else:
        fail("无法识别当前 streamer.dll 的编码器实现编号档案")
    if len(impl_switch_candidates) != 1:
        fail(
            "无法唯一验证编码器实现编号分发表；"
            f"候选数={len(impl_switch_candidates)}"
        )

    adapter_getter_address = image_base + adapter_getter_rva
    _, _, rdata_offset, _ = rdata
    rdata_size = min(rdata_virtual_size, rdata_raw_size)
    pointer = struct.pack("<Q", adapter_getter_address)
    getter_slots = 0
    base_slots = 0
    long_slots = 0
    rtti_named_slots = 0
    wrapper_candidates: list[tuple[int, int, int, str | None]] = []
    text_address_start = image_base + text_rva
    text_address_end = text_address_start + max(
        text_virtual_size, text_raw_size
    )

    def points_into_text(address: int) -> bool:
        return text_address_start <= address < text_address_end

    def vtable_start_offset(slot_offset: int) -> int:
        start = slot_offset
        methods = 0
        while (
            start >= rdata_offset + 8
            and methods < 128
            and points_into_text(read_u64(data, start - 8))
        ):
            start -= 8
            methods += 1
        return start

    def rtti_class_name(vtable_offset: int) -> str | None:
        if vtable_offset < rdata_offset + 8:
            return None
        locator_address = read_u64(data, vtable_offset - 8)
        locator_rva = locator_address - image_base
        try:
            locator_offset = rva_to_offset(locator_rva, 24)
            (
                signature,
                _object_offset,
                _constructor_displacement,
                type_descriptor_rva,
                _class_descriptor_rva,
                self_rva,
            ) = struct.unpack_from("<IIIIII", data, locator_offset)
            if signature != 1 or self_rva != locator_rva:
                return None
            type_offset = rva_to_offset(type_descriptor_rva, 17)
            name_offset = type_offset + 16
            name_end = data.find(b"\0", name_offset, name_offset + 256)
            if name_end < 0:
                return None
            name = data[name_offset:name_end].decode("ascii", errors="strict")
        except (UnicodeDecodeError, ValueError, struct.error):
            return None
        return name if name.startswith(".?A") else None

    def adapter_constructor_references(vtable_rva: int) -> int:
        references = 0
        offset = text_offset
        pattern = bytes.fromhex("488d05")
        while True:
            offset = data.find(pattern, offset, text_end)
            if offset < 0:
                break
            if offset + 104 > text_end:
                break
            instruction_rva = text_rva + offset - text_offset
            displacement = struct.unpack_from("<i", data, offset + 3)[0]
            target_rva = instruction_rva + 7 + displacement
            if (
                target_rva == vtable_rva
                and data[offset + 7 : offset + 10]
                == bytes.fromhex("488906")
            ):
                for store_offset in range(offset + 10, offset + 102):
                    if (
                        data[store_offset] == 0x89
                        and data[store_offset + 1] & 0xC7 == 0x46
                        and data[store_offset + 2] == 0x44
                    ):
                        references += 1
                        break
            offset += 1
        return references

    for offset in range(
        rdata_offset,
        rdata_offset + rdata_size - 8,
        8,
    ):
        if data[offset : offset + 8] != pointer:
            continue
        getter_slots += 1
        following = read_u64(data, offset + 8)
        if points_into_text(following):
            long_slots += 1
            vtable_offset = vtable_start_offset(offset)
            long_vtable_rva = rdata_rva + vtable_offset - rdata_offset
            name = rtti_class_name(vtable_offset)
            if name is not None:
                rtti_named_slots += 1
            constructor_references = adapter_constructor_references(
                long_vtable_rva
            )
            rtti_is_frame = name is None or (
                "Frame" in name
                and "@streamer@@" in name
                and "@webrtc@@" not in name
            )
            if constructor_references and rtti_is_frame:
                wrapper_candidates.append(
                    (
                        rdata_rva + offset - rdata_offset,
                        long_vtable_rva,
                        constructor_references,
                        name,
                    )
                )
            continue
        if offset < rdata_offset + 5 * 8:
            continue
        preceding = struct.unpack_from("<5Q", data, offset - 5 * 8)
        if all(points_into_text(address) for address in preceding):
            base_slots += 1
    if base_slots < 1 or long_slots < 1:
        fail("没有找到以适配器函数结尾的 RawVideoFrame 六槽虚表")
    if getter_slots != base_slots + long_slots:
        fail(
            "RawVideoFrame 适配器函数还存在无法分类的引用；"
            f"总数={getter_slots}，短虚表={base_slots}，长虚表={long_slots}"
        )
    if len(wrapper_candidates) != 1:
        fail(
            "无法用构造器与 adapter_id 字段布局唯一识别编码包装帧；"
            f"候选数={len(wrapper_candidates)}"
        )
    wrapper_slot_rva, wrapper_vtable_rva, wrapper_ctor_refs, wrapper_rtti = (
        wrapper_candidates[0]
    )
    portrait_scale_pattern = bytes.fromhex(
        "41 8b 56 04 85 d2 75 10 41 8b 46 30 "
        "89 83 c0 00 00 00 41 8b 46 34 eb 08 "
        "89 bb c0 00 00 00 8b c7 "
        "4c 8d ab c4 00 00 00 41 89 45 00 "
        "89 93 c8 00 00 00"
    )
    portrait_height_source_offset = 21
    portrait_scale_offsets = []
    for offset in range(
        text_offset,
        text_end - len(portrait_scale_pattern) + 1,
    ):
        if (
            data[offset : offset + portrait_height_source_offset]
            == portrait_scale_pattern[:portrait_height_source_offset]
            and data[
                offset + portrait_height_source_offset + 1 :
                offset + len(portrait_scale_pattern)
            ]
            == portrait_scale_pattern[portrait_height_source_offset + 1 :]
            and data[offset + portrait_height_source_offset] == 0x34
        ):
            portrait_scale_offsets.append(offset)
    if implementation_profile == "unified-nvenc" and len(
        portrait_scale_offsets
    ) != 1:
        fail(
            "无法唯一验证原画画质的竖屏缩放上限复制点；"
            f"候选数={len(portrait_scale_offsets)}"
        )
    portrait_scale_rva = (
        offset_to_rva(portrait_scale_offsets[0], len(portrait_scale_pattern))
        if portrait_scale_offsets
        else 0
    )
    portrait_capture_pattern = bytes.fromhex(
        "41 8b 85 c0 00 00 00 89 86 24 01 00 00 "
        "41 8b 85 c4 00 00 00 89 86 28 01 00 00"
    )
    portrait_capture_height_source_offset = 16
    portrait_capture_offsets = []
    for offset in range(
        text_offset,
        text_end - len(portrait_capture_pattern) + 1,
    ):
        if (
            data[offset : offset + portrait_capture_height_source_offset]
            == portrait_capture_pattern[
                :portrait_capture_height_source_offset
            ]
            and data[
                offset + portrait_capture_height_source_offset + 1 :
                offset + len(portrait_capture_pattern)
            ]
            == portrait_capture_pattern[
                portrait_capture_height_source_offset + 1 :
            ]
            and data[offset + portrait_capture_height_source_offset] == 0xC4
        ):
            portrait_capture_offsets.append(offset)
    if implementation_profile == "unified-nvenc" and len(
        portrait_capture_offsets
    ) != 1:
        fail(
            "无法唯一验证竖屏采集器的最大高度复制点；"
            f"候选数={len(portrait_capture_offsets)}"
        )
    portrait_capture_rva = (
        offset_to_rva(
            portrait_capture_offsets[0], len(portrait_capture_pattern)
        )
        if portrait_capture_offsets
        else 0
    )
    portrait_update_pattern = bytes.fromhex(
        "8b 86 28 01 00 00 41 3b 86 c4 00 00 00 75 12 "
        "45 8b 86 c0 00 00 00 44 39 86 24 01 00 00 75 09 eb 32 "
        "45 8b 86 c0 00 00 00 44 89 86 24 01 00 00 "
        "41 8b 96 c4 00 00 00 89 96 28 01 00 00"
    )
    portrait_update_compare_offset = 9
    portrait_update_apply_offset = 50
    portrait_update_offsets = []
    for offset in range(
        text_offset,
        text_end - len(portrait_update_pattern) + 1,
    ):
        if (
            data[offset : offset + portrait_update_compare_offset]
            == portrait_update_pattern[:portrait_update_compare_offset]
            and data[
                offset + portrait_update_compare_offset + 1 :
                offset + portrait_update_apply_offset
            ]
            == portrait_update_pattern[
                portrait_update_compare_offset + 1 :
                portrait_update_apply_offset
            ]
            and data[
                offset + portrait_update_apply_offset + 1 :
                offset + len(portrait_update_pattern)
            ]
            == portrait_update_pattern[portrait_update_apply_offset + 1 :]
            and data[offset + portrait_update_compare_offset]
            in (0xC4, 0xC0)
            and data[offset + portrait_update_apply_offset]
            in (0xC4, 0xC0)
        ):
            portrait_update_offsets.append(offset)
    if implementation_profile == "unified-nvenc" and len(
        portrait_update_offsets
    ) != 1:
        fail(
            "无法唯一验证竖屏采集器的运行期尺寸重写点；"
            f"候选数={len(portrait_update_offsets)}"
        )
    portrait_update_rva = (
        offset_to_rva(
            portrait_update_offsets[0], len(portrait_update_pattern)
        )
        if portrait_update_offsets
        else 0
    )
    portrait_scaler_pattern = bytes.fromhex(
        "8b 97 90 00 00 00 2b 97 88 00 00 00 "
        "44 8b 45 88 44 2b 45 80 44 8b 4d 8c 44 8b 55 84 "
        "44 3b c2 7f 50 8b 8f 94 00 00 00 2b 8f 8c 00 00 00 "
        "41 8b c1 41 2b c2 3b c1 7f 3a "
        "0f 28 75 80 66 0f 6f c6 66 0f 73 d8 0c 66 0f 7e c3 "
        "66 0f 6f ce 66 0f 73 d9 08 66 0f 7e ce 89 74 24 40 "
        "66 0f 6f c6 66 0f 73 d8 04 66 41 0f 7e c7 "
        "66 41 0f 7e f6 e9 8c 00 00 00 "
        "66 41 0f 6e c0 0f 5b c0 66 0f 6e ca 0f 5b c9 "
        "f3 0f 5e c8 45 2b ca 66 45 0f 6e c1 45 0f 5b c0 "
        "8b 87 94 00 00 00 2b 87 8c 00 00 00 "
        "66 0f 6e f8 0f 5b ff f3"
    )
    portrait_scaler_field_offsets = (35, 41, 146, 152)
    portrait_scaler_original_fields = (0x94, 0x8C, 0x94, 0x8C)
    portrait_scaler_patched_fields = (0x90, 0x88, 0x90, 0x88)
    portrait_scaler_offsets = []
    for offset in range(
        text_offset,
        text_end - len(portrait_scaler_pattern) + 1,
    ):
        segment_start = 0
        matches = True
        for index, field_offset in enumerate(portrait_scaler_field_offsets):
            if (
                data[offset + segment_start : offset + field_offset]
                != portrait_scaler_pattern[segment_start:field_offset]
                or data[offset + field_offset]
                not in (
                    portrait_scaler_original_fields[index],
                    portrait_scaler_patched_fields[index],
                )
            ):
                matches = False
                break
            segment_start = field_offset + 1
        if (
            matches
            and data[offset + segment_start : offset + len(
                portrait_scaler_pattern
            )]
            == portrait_scaler_pattern[segment_start:]
        ):
            portrait_scaler_offsets.append(offset)
    if implementation_profile == "unified-nvenc" and len(
        portrait_scaler_offsets
    ) != 1:
        fail(
            "无法唯一验证竖屏采集的最终缩放器；"
            f"候选数={len(portrait_scaler_offsets)}"
        )
    portrait_scaler_rva = (
        offset_to_rva(
            portrait_scaler_offsets[0], len(portrait_scaler_pattern)
        )
        if portrait_scaler_offsets
        else 0
    )
    profile: dict[str, object] = {
        "vtable_rva": vtable_rva,
        "slot_rva": slot_rva,
        "base_getter_rva": adapter_getter_rva,
        "base_slots": base_slots,
        "long_slots": long_slots,
        "wrapper_vtable_rva": wrapper_vtable_rva,
        "wrapper_slot_rva": wrapper_slot_rva,
        "wrapper_ctor_refs": wrapper_ctor_refs,
        "wrapper_rtti": wrapper_rtti or "none",
        "rtti_named_slots": rtti_named_slots,
        "encoder_accessor_rva": encoder_accessor_rva,
        "encoder_path_candidates": len(encoder_accessor_offsets),
        "implementation_profile": implementation_profile,
        "nvenc_v8_impl": NVENC_V8_IMPL,
        "nvenc_v11_impl": NVENC_V11_IMPL,
        "software_impl": software_impl,
        "impl_33": "software",
        "impl_switch_candidates": len(impl_switch_candidates),
        "portrait_scale_rva": portrait_scale_rva,
        "portrait_scale_candidates": len(portrait_scale_offsets),
        "portrait_capture_rva": portrait_capture_rva,
        "portrait_capture_candidates": len(portrait_capture_offsets),
        "portrait_update_rva": portrait_update_rva,
        "portrait_update_candidates": len(portrait_update_offsets),
        "portrait_scaler_rva": portrait_scaler_rva,
        "portrait_scaler_candidates": len(portrait_scaler_offsets),
    }
    line = (
        f"STREAMER_GDI_ADAPTER_OK\tvtable_rva=0x{vtable_rva:x}"
        f"\tslot_rva=0x{slot_rva:x}"
        f"\tbase_getter_rva=0x{adapter_getter_rva:x}"
        f"\tbase_slots={base_slots}"
        f"\tlong_slots={long_slots}"
        f"\twrapper_vtable_rva=0x{wrapper_vtable_rva:x}"
        f"\twrapper_slot_rva=0x{wrapper_slot_rva:x}"
        f"\twrapper_ctor_refs={wrapper_ctor_refs}"
        f"\twrapper_rtti={wrapper_rtti or 'none'}"
        f"\trtti_named_slots={rtti_named_slots}"
        f"\tencoder_accessor_rva=0x{encoder_accessor_rva:x}"
        f"\tencoder_path_candidates={len(encoder_accessor_offsets)}"
        f"\timplementation_profile={implementation_profile}"
        f"\tnvenc_v8_impl={NVENC_V8_IMPL}"
        f"\tnvenc_v11_impl={NVENC_V11_IMPL}"
        f"\tsoftware_impl={software_impl}"
        f"\timpl_33=software"
        f"\timpl_switch_candidates={len(impl_switch_candidates)}"
        f"\tportrait_scale_rva=0x{portrait_scale_rva:x}"
        f"\tportrait_scale_candidates={len(portrait_scale_offsets)}"
        f"\tportrait_capture_rva=0x{portrait_capture_rva:x}"
        f"\tportrait_capture_candidates={len(portrait_capture_offsets)}"
        f"\tportrait_update_rva=0x{portrait_update_rva:x}"
        f"\tportrait_update_candidates={len(portrait_update_offsets)}"
        f"\tportrait_scaler_rva=0x{portrait_scaler_rva:x}"
        f"\tportrait_scaler_candidates={len(portrait_scaler_offsets)}"
    )
    if emit:
        print(line)
    return profile


def portrait_profile_ready(profile: dict[str, object]) -> bool:
    return all(
        profile.get(f"portrait_{name}_candidates") == 1
        and isinstance(profile.get(f"portrait_{name}_rva"), int)
        and profile[f"portrait_{name}_rva"] > 0
        for name in ("scale", "capture", "update", "scaler")
    )


def encoder_profile_ready(profile: dict[str, object]) -> bool:
    positive_rvas = (
        "vtable_rva",
        "slot_rva",
        "base_getter_rva",
        "wrapper_vtable_rva",
        "wrapper_slot_rva",
        "encoder_accessor_rva",
    )
    return (
        all(
            isinstance(profile.get(name), int) and profile[name] > 0
            for name in positive_rvas
        )
        and isinstance(profile.get("base_slots"), int)
        and profile["base_slots"] >= 1
        and isinstance(profile.get("long_slots"), int)
        and profile["long_slots"] >= 1
        and isinstance(profile.get("wrapper_ctor_refs"), int)
        and profile["wrapper_ctor_refs"] >= 1
        and profile.get("encoder_path_candidates") == 1
        and profile.get("impl_switch_candidates") == 1
        and profile.get("implementation_profile")
        in {"nvenc-v8-v11", "unified-nvenc"}
        and profile.get("software_impl") in {5, 6}
        and profile.get("impl_33") == "software"
    )


def streamer_profile_payload(
    streamer: Path,
    version: str,
    *,
    require_portrait: bool,
) -> dict[str, object]:
    if not version or any(
        not part.isdigit() for part in version.split(".")
    ) or len(version.split(".")) not in {3, 4}:
        fail("UU 版本号格式无效")
    try:
        data = streamer.read_bytes()
    except OSError as error:
        fail(f"无法读取 streamer.dll：{error}")
    # Keep the established one-line semantic evidence in setup/update logs.
    # Existing diagnostics and regressions use these exact target counts to
    # distinguish a verified adapter path from a merely written profile file.
    probe = probe_streamer(streamer, emit=True)
    if not encoder_profile_ready(probe):
        fail("编码器语义档案缺少必需的唯一候选点")
    if require_portrait and not portrait_profile_ready(probe):
        fail("无法为当前 UU 唯一生成四处竖屏原画补丁档案")
    return {
        "format": 1,
        "uu_version": version,
        "streamer_sha256": hashlib.sha256(data).hexdigest(),
        "portrait_required": require_portrait,
        "portrait_ready": portrait_profile_ready(probe),
        "probe": probe,
    }


def write_streamer_profile(
    streamer: Path,
    version: str,
    destination: Path,
    *,
    require_portrait: bool,
) -> None:
    payload = streamer_profile_payload(
        streamer, version, require_portrait=require_portrait
    )
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{destination.name}.", dir=destination.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, ensure_ascii=False, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)
    print(
        "STREAMER_PROFILE_OK"
        f"\tversion={version}"
        f"\tsha256={payload['streamer_sha256']}"
        f"\tportrait={int(bool(payload['portrait_ready']))}"
    )


def verify_streamer_profile(
    streamer: Path,
    version: str,
    profile_path: Path,
    *,
    require_portrait: bool,
) -> None:
    try:
        saved = json.loads(profile_path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"streamer 自动兼容档案不存在：{profile_path}")
    except (OSError, json.JSONDecodeError) as error:
        fail(f"无法读取 streamer 自动兼容档案：{error}")
    current = streamer_profile_payload(
        streamer, version, require_portrait=require_portrait
    )
    if not isinstance(saved, dict) or saved.get("format") != 1:
        fail("streamer 自动兼容档案格式无效")
    if saved != current:
        fail("streamer 自动兼容档案与当前 UU 二进制不匹配")
    print(
        "STREAMER_PROFILE_VERIFIED"
        f"\tversion={version}"
        f"\tsha256={current['streamer_sha256']}"
        f"\tportrait={int(bool(current['portrait_ready']))}"
    )


def match_streamer_profile(
    streamer: Path,
    version: str,
    profile_path: Path,
    *,
    require_portrait: bool,
) -> None:
    try:
        saved = json.loads(profile_path.read_text(encoding="utf-8"))
        streamer_sha256 = hashlib.sha256(streamer.read_bytes()).hexdigest()
    except FileNotFoundError:
        fail(f"streamer 自动兼容档案不存在：{profile_path}")
    except (OSError, json.JSONDecodeError) as error:
        fail(f"无法快速核验 streamer 自动兼容档案：{error}")
    probe = saved.get("probe") if isinstance(saved, dict) else None
    if (
        not isinstance(saved, dict)
        or saved.get("format") != 1
        or saved.get("uu_version") != version
        or saved.get("streamer_sha256") != streamer_sha256
        or not isinstance(probe, dict)
        or not encoder_profile_ready(probe)
        or saved.get("portrait_ready") != portrait_profile_ready(probe)
        or saved.get("portrait_required") != require_portrait
        or (require_portrait and not portrait_profile_ready(probe))
    ):
        fail("streamer 自动兼容档案与当前 UU 二进制不匹配")
    print(
        "STREAMER_PROFILE_MATCHED"
        f"\tversion={version}"
        f"\tsha256={streamer_sha256}"
        f"\tportrait={int(bool(saved.get('portrait_ready')))}"
    )


def main(argv: list[str]) -> None:
    if len(argv) == 3 and argv[1] == "probe-streamer":
        probe_streamer(Path(argv[2]))
        return
    if len(argv) in {5, 6} and argv[1] in {
        "derive-streamer-profile",
        "verify-streamer-profile",
        "match-streamer-profile",
    }:
        require_portrait = len(argv) == 6 and argv[5] == "--require-portrait"
        if len(argv) == 6 and not require_portrait:
            fail(f"未知参数：{argv[5]}")
        streamer = Path(argv[2])
        version = argv[3]
        profile_path = Path(argv[4])
        if argv[1] == "derive-streamer-profile":
            write_streamer_profile(
                streamer,
                version,
                profile_path,
                require_portrait=require_portrait,
            )
        elif argv[1] == "verify-streamer-profile":
            verify_streamer_profile(
                streamer,
                version,
                profile_path,
                require_portrait=require_portrait,
            )
        else:
            match_streamer_profile(
                streamer,
                version,
                profile_path,
                require_portrait=require_portrait,
            )
        return
    if len(argv) == 8 and argv[1] == "watch":
        watch(
            Path(argv[2]),
            Path(argv[3]),
            parse_id(argv[4], "DEVICE_ID"),
            parse_id(argv[5], "ADAPTER_ID"),
            Path(argv[6]),
            Path(argv[7]),
        )
        return
    if len(argv) < 4 or argv[1] not in {"enable", "disable", "verify"}:
        fail(
            "用法：uu-remote-encoder-policy "
            "enable|verify CACHE BACKUP DEVICE_ID ADAPTER_ID；"
            "或 disable CACHE BACKUP；或 probe-streamer STREAMER_DLL；"
            "或 derive-streamer-profile|verify-streamer-profile|"
            "match-streamer-profile "
            "STREAMER_DLL UU_VERSION PROFILE [--require-portrait]；"
            "或 watch CACHE BACKUP DEVICE_ID ADAPTER_ID ENABLED_STAMP LOCK"
        )
    command = argv[1]
    cache = Path(argv[2])
    backup = Path(argv[3])
    if command == "disable":
        if len(argv) != 4:
            fail("disable 只接受 CACHE 和 BACKUP")
        disable(cache, backup)
        return
    if len(argv) != 6:
        fail(f"{command} 需要 DEVICE_ID 和 ADAPTER_ID")
    device_id = parse_id(argv[4], "DEVICE_ID")
    adapter_id = parse_id(argv[5], "ADAPTER_ID")
    if command == "enable":
        enable(cache, backup, device_id, adapter_id)
    else:
        verify(cache, device_id, adapter_id)


if __name__ == "__main__":
    main(sys.argv)
