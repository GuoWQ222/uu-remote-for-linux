        "connected_monitor_override": ["DFP-0", "DFP-1", "DFP-3"],
        "virtual_output": "DP-0",
        "virtual_dpy": "DFP-1",
    }
    config = render_xorg(info)
    assert b'Option "ConnectedMonitor" "DFP-0, DFP-1, DFP-3"' in config
    assert b'Option "CustomEDID" "DFP-1:' in config
    print(
        json.dumps(
            {"result": "pass", "edid_sha256": sha256_bytes(edid)},
            ensure_ascii=False,
            indent=2,
        )
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="UU Remote NVIDIA X11 虚拟显示器阶段 0/1 管理工具"
    )
    parser.add_argument("--output", default=DEFAULT_OUTPUT, help="虚拟 RandR 输出")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("preflight", help="只读检查当前显示栈")
    subparsers.add_parser("snapshot", help="保存阶段 0 可审计基线")
    subparsers.add_parser("prepare", help="生成 EDID 和 Xorg 配置，不写系统目录")
    apply_parser = subparsers.add_parser("apply-prepared", help="root 安装已准备的配置")
    apply_parser.add_argument("--staged-dir", type=Path, required=True)
    subparsers.add_parser("remove-system", help="root 删除 UU Remote 专属系统配置")
    enable_parser = subparsers.add_parser("enable", help="启用已配置的虚拟输出")
    enable_parser.add_argument("--mode", default=DEFAULT_MODE)
    enable_parser.add_argument("--rate", default=DEFAULT_RATE)
    enable_parser.add_argument("--right-of", dest="right_of")
    enable_parser.add_argument(
        "--projection", choices=("extend", "duplicate"), default="extend"
    )
    enable_parser.add_argument(
        "--rotate",
        choices=("normal", "left", "right", "inverted"),
        default="normal",
    )
    enable_parser.add_argument("--position", help="显式 XRandR 坐标，例如 4000x0")
    subparsers.add_parser("disable", help="关闭虚拟输出")
    restore_parser = subparsers.add_parser(
        "restore-layout", help="关闭虚拟输出并原子恢复已验证的物理布局"
    )
    restore_parser.add_argument("--layout-json", required=True)
    subparsers.add_parser("status", help="显示虚拟输出状态")
    verify_parser = subparsers.add_parser("verify", help="验证 Xorg 已识别虚拟输出")
    verify_parser.add_argument("--require-active", action="store_true")
    subparsers.add_parser("self-test", help="运行无副作用内部测试")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command == "preflight":
        print(json.dumps(preflight(args.output), ensure_ascii=False, indent=2))
    elif args.command == "snapshot":
        print(snapshot(args.output))
    elif args.command == "prepare":
        staged = prepare(args.output)
        print(staged)
        print("下一步需要 root 安装这两个已校验文件；安装本身不会重启当前会话。")
        command = [
            "sudo",
            "-E",
            str(Path(sys.argv[0]).resolve()),
            "apply-prepared",
            "--staged-dir",
            str(staged),
        ]
        print(" ".join(shlex.quote(part) for part in command))
    elif args.command == "apply-prepared":
        apply_prepared(args.staged_dir)
    elif args.command == "remove-system":
        remove_system()
    elif args.command == "enable":
        enable(
            args.output,
            args.mode,
            args.rate,
            args.right_of,
            args.rotate,
            args.position,
            args.projection,
        )
    elif args.command == "disable":
        disable(args.output)
    elif args.command == "restore-layout":
        restore_layout(args.output, args.layout_json)
    elif args.command == "status":
        status(args.output)
    elif args.command == "verify":
        verify(args.output, args.require_active)
    elif args.command == "self-test":
        self_test()
    else:
        fail(f"未知命令：{args.command}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except VirtualDisplayError as error:
        print(f"错误：{error}", file=sys.stderr)
        raise SystemExit(1)
