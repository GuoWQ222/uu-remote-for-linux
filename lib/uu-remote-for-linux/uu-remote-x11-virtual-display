#!/usr/bin/env python3
"""Safely stage and operate an NVIDIA-backed X11 virtual display.

The system Xorg configuration is prepared in per-user state first.  Installing
it is a separate, root-only action so a failed probe can never mutate the
running desktop.  Runtime enable/disable only touches the dedicated output.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any


class VirtualDisplayError(RuntimeError):
    pass


TOOL_VERSION = 1
DEFAULT_OUTPUT = "DP-0"
DEFAULT_MODE = "1920x1080"
DEFAULT_RATE = "60"
SYSTEM_EDID = Path(
    os.environ.get(
        "UU_REMOTE_X11_VDISPLAY_SYSTEM_EDID",
        "/usr/share/uu-remote-for-linux/edid/uu-remote-virtual-display.bin",
    )
)
SYSTEM_XORG = Path(
    os.environ.get(
        "UU_REMOTE_X11_VDISPLAY_SYSTEM_XORG",
        "/etc/X11/xorg.conf.d/20-uu-remote-nvidia-virtual-display.conf",
    )
)
STATE_ROOT = Path(
    os.environ.get(
        "UU_REMOTE_X11_VDISPLAY_STATE_DIR",
        str(
            Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
            / "uu-remote-for-linux/x11-virtual-display"
        ),
    )
)
XRANDR = os.environ.get("UU_REMOTE_X11_VDISPLAY_XRANDR", "xrandr")
NVIDIA_SETTINGS = os.environ.get(
    "UU_REMOTE_X11_VDISPLAY_NVIDIA_SETTINGS", "nvidia-settings"
)


def fail(message: str) -> None:
    raise VirtualDisplayError(message)


def run(command: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(
            command,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
        )
    except FileNotFoundError:
        fail(f"缺少命令：{command[0]}")
    except subprocess.TimeoutExpired:
        fail(f"命令超时：{' '.join(command)}")
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        fail(f"命令失败（{result.returncode}）：{' '.join(command)}：{detail}")
    return result


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def atomic_write(path: Path, data: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def manufacturer_id(value: str) -> tuple[int, int]:
    if not re.fullmatch(r"[A-Z]{3}", value):
        fail("EDID 厂商标识必须是三个大写字母。")
    encoded = 0
    for character in value:
        encoded = (encoded << 5) | (ord(character) - ord("A") + 1)
    return (encoded >> 8, encoded & 0xFF)


def detailed_timing(
    *,
    pixel_clock_khz: int,
    h_active: int,
    h_blank: int,
    v_active: int,
    v_blank: int,
    h_sync_offset: int,
    h_sync_width: int,
    v_sync_offset: int,
    v_sync_width: int,
    width_mm: int = 509,
    height_mm: int = 286,
    flags: int = 0x1E,
) -> bytes:
    clock = pixel_clock_khz // 10
    if pixel_clock_khz % 10 or not 0 < clock <= 0xFFFF:
        fail("EDID 像素时钟必须能用 10 kHz 单位表示。")
    values = (
        h_active,
        h_blank,
        v_active,
        v_blank,
        h_sync_offset,
        h_sync_width,
        v_sync_offset,
        v_sync_width,
        width_mm,
        height_mm,
    )
    if any(value < 0 or value > 0xFFF for value in values):
        fail("EDID timing 字段超出 12 位范围。")
    return bytes(
        [
            clock & 0xFF,
            clock >> 8,
            h_active & 0xFF,
            h_blank & 0xFF,
            ((h_active >> 8) << 4) | (h_blank >> 8),
            v_active & 0xFF,
            v_blank & 0xFF,
            ((v_active >> 8) << 4) | (v_blank >> 8),
            h_sync_offset & 0xFF,
            h_sync_width & 0xFF,
            ((v_sync_offset & 0xF) << 4) | (v_sync_width & 0xF),
            ((h_sync_offset >> 8) << 6)
            | ((h_sync_width >> 8) << 4)
            | ((v_sync_offset >> 4) << 2)
            | (v_sync_width >> 4),
            width_mm & 0xFF,
            height_mm & 0xFF,
            ((width_mm >> 8) << 4) | (height_mm >> 8),
            0,
            0,
            flags,
        ]
    )


def descriptor(tag: int, text: bytes) -> bytes:
    if len(text) > 13:
        fail("EDID 描述符正文不能超过 13 字节。")
    return bytes([0, 0, 0, tag, 0]) + text.ljust(13, b" ")


def build_edid() -> bytes:
    """Return a single-block EDID 1.4 with 1080p and 1440p timings."""
    block = bytearray(128)
    block[0:8] = b"\x00\xff\xff\xff\xff\xff\xff\x00"
    block[8:10] = bytes(manufacturer_id("UUR"))
    block[10:12] = b"\x01\x00"
    block[12:16] = (0x55520001).to_bytes(4, "little")
    block[16] = 1
    block[17] = 36  # 2026
    block[18:20] = b"\x01\x04"
    block[20:25] = bytes([0x80, 51, 29, 120, 0x0A])
    block[25:35] = bytes.fromhex("ee91a3544c99260f5054")
    block[35:38] = b"\x00\x00\x00"
    # EDID 1.4 standard timings: 1280x720, 1600x900, 1920x1080 at 60 Hz.
    block[38:54] = bytes.fromhex("81c0a9c0d1c001010101010101010101")
    block[54:72] = detailed_timing(
        pixel_clock_khz=148500,
        h_active=1920,
        h_blank=280,
        v_active=1080,
        v_blank=45,
        h_sync_offset=88,
        h_sync_width=44,
        v_sync_offset=4,
        v_sync_width=5,
    )
    block[72:90] = detailed_timing(
        pixel_clock_khz=241500,
        h_active=2560,
        h_blank=160,
        v_active=1440,
        v_blank=41,
        h_sync_offset=48,
        h_sync_width=32,
        v_sync_offset=3,
        v_sync_width=5,
        flags=0x1A,
    )
    block[90:108] = descriptor(0xFC, b"UU Virtual\n")
    block[108:126] = bytes.fromhex("000000fd00304b1ea01e000a202020202020")
    block[126] = 0
    block[127] = (-sum(block[:127])) & 0xFF
    validate_edid(bytes(block))
    return bytes(block)


def validate_edid(data: bytes) -> None:
    if len(data) != 128:
        fail(f"EDID 长度错误：{len(data)}，预期 128。")
    if data[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00":
        fail("EDID 头部无效。")
    if sum(data) % 256:
        fail("EDID 校验和无效。")
    if data[18:20] != b"\x01\x04":
        fail("EDID 版本不是 1.4。")
    if data[54:56] != bytes([0x02, 0x3A]):
        fail("EDID 首选模式不是 1920x1080@60。")


def parse_nvidia_dpys(output: str) -> list[dict[str, Any]]:
    devices: list[dict[str, Any]] = []
    matches = list(re.finditer(r"(?m)^\s*\[\d+\].*$", output))
    for index, match in enumerate(matches):
        end = matches[index + 1].start() if index + 1 < len(matches) else len(output)
        block = output[match.start() : end]
        header = match.group(0)
        output_name_match = re.search(r"\(([^()]+)\)", header)
        dpy_match = re.search(r"(?m)^\s+(DFP-\d+)\s*$", block)
        if not output_name_match or not dpy_match:
            continue
        devices.append(
            {
                "output": output_name_match.group(1),
                "dpy": dpy_match.group(1),
                "connected": "(connected" in header,
                "enabled": "enabled)" in header,
            }
        )
    return devices


def parse_xrandr(output: str) -> dict[str, Any]:
    screen_match = re.search(
        r"Screen 0: minimum (\d+) x (\d+), current (\d+) x (\d+), "
        r"maximum (\d+) x (\d+)",
        output,
    )
    if not screen_match:
        fail("无法解析 xrandr Screen 0 几何。")
    result: dict[str, Any] = {
        "minimum": [int(screen_match.group(1)), int(screen_match.group(2))],
        "current": [int(screen_match.group(3)), int(screen_match.group(4))],
        "maximum": [int(screen_match.group(5)), int(screen_match.group(6))],
        "outputs": [],
    }
    lines = output.splitlines()
    current_device: dict[str, Any] | None = None
    for line in lines:
        device_match = re.match(r"^(\S+) (connected|disconnected)(.*)$", line)
        if device_match:
            tail = device_match.group(3)
            geometry = re.search(r"(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", tail)
            orientation_prefix = tail.split("(normal", maxsplit=1)[0]
            rotation_match = re.search(
                r"\b(left|right|inverted)\b", orientation_prefix
            )
            current_device = {
                "output": device_match.group(1),
                "connected": device_match.group(2) == "connected",
                "primary": bool(re.search(r"\bprimary\b", tail)),
                "active": geometry is not None,
                "geometry": (
                    [int(geometry.group(index)) for index in range(1, 5)]
                    if geometry
                    else None
                ),
                "rotation": (
                    rotation_match.group(1)
                    if geometry and rotation_match
                    else "normal" if geometry else None
                ),
                "current_mode": None,
                "current_rate": None,
                "modes": [],
                "mode_rates": {},
            }
            result["outputs"].append(current_device)
            continue
        if current_device is not None:
            mode_match = re.match(r"^\s+(\d+x\d+)\s+", line)
            if mode_match:
                mode = mode_match.group(1)
                if mode not in current_device["modes"]:
                    current_device["modes"].append(mode)
                rates = []
                for token in line[mode_match.end() :].split():
                    rate = token.rstrip("*+")
                    if not re.fullmatch(r"\d+(?:\.\d+)?", rate):
                        continue
                    rates.append(rate)
                    if "*" in token:
                        current_device["current_mode"] = mode
                        current_device["current_rate"] = rate
                current_device["mode_rates"][mode] = rates
    return result


def live_state() -> tuple[dict[str, Any], list[dict[str, Any]], str]:
    xrandr_query = run([XRANDR, "--query"]).stdout
    devices = parse_xrandr(xrandr_query)
    dpys_text = run([NVIDIA_SETTINGS, "-q", "dpys"]).stdout
    dpys = parse_nvidia_dpys(dpys_text)
    if not dpys:
        fail("nvidia-settings 没有返回可识别的 DFP 输出。")
    return devices, dpys, xrandr_query


def find_output(items: list[dict[str, Any]], name: str) -> dict[str, Any]:
    for item in items:
        if item["output"] == name:
            return item
    fail(f"没有找到输出：{name}")


def preflight(output_name: str) -> dict[str, Any]:
    session_type = os.environ.get("XDG_SESSION_TYPE", "")
    if session_type and session_type.lower() != "x11":
        fail(f"当前会话不是 X11：{session_type}")
    if not os.environ.get("DISPLAY"):
        fail("DISPLAY 未设置，无法访问当前 X11 会话。")
    providers_text = run([XRANDR, "--listproviders"]).stdout
    providers_match = re.search(r"Providers: number\s*:\s*(\d+)", providers_text)
    if not providers_match:
        fail("无法解析 RandR provider 数量。")
    providers = int(providers_match.group(1))
    if providers != 1 or "name:NVIDIA-0" not in providers_text:
        fail("阶段 1 只支持单 NVIDIA-0 provider 的 X11 会话。")
    crtc_match = re.search(r"crtcs:\s*(\d+)", providers_text)
    devices, dpys, _ = live_state()
    target_dpy = find_output(dpys, output_name)
    active_count = sum(1 for item in devices["outputs"] if item["active"])
    crtc_count = int(crtc_match.group(1)) if crtc_match else 0
    if crtc_count and active_count >= crtc_count and not target_dpy["enabled"]:
        fail(f"没有空闲 CRTC：{active_count}/{crtc_count} 已占用。")
    if not target_dpy["output"].startswith("DP-"):
        fail(f"阶段 1 拒绝将非 DP 输出作为虚拟显示器：{output_name}")
    connected_dpys = sorted(
        {item["dpy"] for item in dpys if item["connected"]} | {target_dpy["dpy"]},
        key=lambda value: int(value.split("-")[1]),
    )
    return {
        "tool_version": TOOL_VERSION,
        "session_type": session_type or "x11",
        "display": os.environ.get("DISPLAY"),
        "providers": providers,
        "provider": "NVIDIA-0",
        "crtcs": crtc_count,
        "active_outputs": active_count,
        "desktop": devices["current"],
        "maximum": devices["maximum"],
        "virtual_output": target_dpy["output"],
        "virtual_dpy": target_dpy["dpy"],
        "virtual_connected": target_dpy["connected"],
        "connected_monitor_override": connected_dpys,
        "physical_outputs": [
            item["output"]
            for item in devices["outputs"]
            if item["connected"] and item["output"] != output_name
        ],
    }


def timestamp() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")


def snapshot(output_name: str) -> Path:
    target = STATE_ROOT / "snapshots" / timestamp()
    target.mkdir(parents=True, mode=0o700)
    os.chmod(target, 0o700)
    captures = {
        "xrandr-query.txt": [XRANDR, "--query"],
        "xrandr-providers.txt": [XRANDR, "--listproviders"],
        "nvidia-dpys.txt": [NVIDIA_SETTINGS, "-q", "dpys"],
        "nvidia-metamode.txt": [NVIDIA_SETTINGS, "-q", "CurrentMetaMode"],
    }
    captured: dict[str, Any] = {}
    for filename, command in captures.items():
        result = run(command, check=False)
        data = (result.stdout + result.stderr).encode()
        atomic_write(target / filename, data, 0o600)
        captured[filename] = {
            "command": command,
            "returncode": result.returncode,
            "sha256": sha256_bytes(data),
        }
    saved_files: list[dict[str, Any]] = []
    paths = [
        Path("/etc/X11/xorg.conf"),
        Path("/usr/share/X11/xorg.conf.d/10-nvidia.conf"),
        Path.home() / ".config/monitors.xml",
    ]
    paths.extend(sorted(Path("/etc/X11/xorg.conf.d").glob("*.conf")))
    for source in paths:
        if not source.exists() and not source.is_symlink():
            continue
        relative = Path("files") / str(source).lstrip("/")
        destination = target / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            destination.symlink_to(os.readlink(source))
        else:
            shutil.copy2(source, destination)
            os.chmod(destination, stat.S_IRUSR | stat.S_IWUSR)
        saved_files.append(
            {
                "source": str(source),
                "snapshot": str(relative),
                "sha256": sha256_bytes(source.read_bytes()) if source.is_file() else None,
            }
        )
    manifest = {
        "tool_version": TOOL_VERSION,
        "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "requested_output": output_name,
        "environment": {
            name: os.environ.get(name)
            for name in ("DISPLAY", "XAUTHORITY", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP")
        },
        "captures": captured,
        "saved_files": saved_files,
    }
    atomic_write(
        target / "manifest.json",
        (json.dumps(manifest, ensure_ascii=False, indent=2) + "\n").encode(),
        0o600,
    )
    return target


def render_xorg(info: dict[str, Any]) -> bytes:
    monitors = ", ".join(info["connected_monitor_override"])
    return (
        "# Generated by uu-remote-x11-virtual-display.\n"
        "# Delete this one file to disable the Xorg-side virtual display.\n"
        f"# Virtual connector: {info['virtual_output']} ({info['virtual_dpy']})\n"
        'Section "OutputClass"\n'
        '    Identifier "uu-remote-for-linux-nvidia-virtual-display"\n'
        '    MatchDriver "nvidia-drm"\n'
        f'    Option "ConnectedMonitor" "{monitors}"\n'
        f'    Option "CustomEDID" "{info["virtual_dpy"]}:{SYSTEM_EDID}"\n'
        "EndSection\n"
    ).encode()


def prepare(output_name: str) -> Path:
    info = preflight(output_name)
    snapshot_path = snapshot(output_name)
    staged = STATE_ROOT / "prepared"
    staged.mkdir(parents=True, exist_ok=True)
    os.chmod(staged, 0o700)
    edid = build_edid()
    config = render_xorg(info)
    edid_path = staged / SYSTEM_EDID.name
    config_path = staged / SYSTEM_XORG.name
    atomic_write(edid_path, edid, 0o644)
    atomic_write(config_path, config, 0o644)
    manifest = {
        "tool_version": TOOL_VERSION,
        "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "snapshot": str(snapshot_path),
        "preflight": info,
        "files": {
            "edid": {
                "source": str(edid_path),
                "target": str(SYSTEM_EDID),
                "sha256": sha256_bytes(edid),
            },
            "xorg": {
                "source": str(config_path),
                "target": str(SYSTEM_XORG),
                "sha256": sha256_bytes(config),
            },
        },
    }
    atomic_write(
        staged / "manifest.json",
        (json.dumps(manifest, ensure_ascii=False, indent=2) + "\n").encode(),
        0o600,
    )
    return staged


def load_prepared(staged: Path) -> dict[str, Any]:
    manifest_path = staged / "manifest.json"
    if not manifest_path.is_file() or manifest_path.is_symlink():
        fail(f"准备清单不存在或不安全：{manifest_path}")
    manifest = json.loads(manifest_path.read_text())
    if manifest.get("tool_version") != TOOL_VERSION:
        fail("准备清单版本不兼容，请重新运行 prepare。")
    expected_targets = {"edid": SYSTEM_EDID, "xorg": SYSTEM_XORG}
    for label, expected_target in expected_targets.items():
        entry = manifest.get("files", {}).get(label, {})
        source = Path(entry.get("source", ""))
        if source.parent.resolve() != staged.resolve() or source.is_symlink():
            fail(f"准备文件路径不安全：{source}")
        if Path(entry.get("target", "")) != expected_target:
            fail(f"准备文件目标不匹配：{label}")
        data = source.read_bytes()
        if sha256_bytes(data) != entry.get("sha256"):
            fail(f"准备文件哈希不匹配：{source}")
        if label == "edid":
            validate_edid(data)
        elif b'Identifier "uu-remote-for-linux-nvidia-virtual-display"' not in data:
            fail("Xorg 配置缺少 UU Remote 所有权标记。")
    return manifest


def apply_prepared(staged: Path) -> None:
    if os.geteuid() != 0:
        fail("apply-prepared 必须以 root 运行。")
    manifest = load_prepared(staged)
    pending: list[tuple[Path, bytes]] = []
    for label in ("edid", "xorg"):
        entry = manifest["files"][label]
        source = Path(entry["source"])
        target = Path(entry["target"])
        data = source.read_bytes()
        if target.exists() and target.read_bytes() != data:
            fail(f"拒绝覆盖已有的不同文件：{target}")
        pending.append((target, data))
    for target, data in pending:
        atomic_write(target, data, 0o644)
    print(f"已安装：{SYSTEM_EDID}")
    print(f"已安装：{SYSTEM_XORG}")
    print("配置会在下一次 X11 登录时生效；当前会话未被重启。")


def remove_system() -> None:
    if os.geteuid() != 0:
        fail("remove-system 必须以 root 运行。")
    config = SYSTEM_XORG.read_bytes() if SYSTEM_XORG.exists() else None
    edid = SYSTEM_EDID.read_bytes() if SYSTEM_EDID.exists() else None
    if config is not None:
        if b'Identifier "uu-remote-for-linux-nvidia-virtual-display"' not in config:
            fail(f"拒绝删除不属于 UU Remote 的配置：{SYSTEM_XORG}")
    if edid is not None:
        validate_edid(edid)
    if config is not None:
        SYSTEM_XORG.unlink()
    if edid is not None:
        SYSTEM_EDID.unlink()
    print("已移除 UU Remote 虚拟显示器系统配置；下一次 X11 登录后完全生效。")


def output_status(output_name: str) -> tuple[dict[str, Any], dict[str, Any]]:
    devices, dpys, _ = live_state()
    return find_output(devices["outputs"], output_name), find_output(dpys, output_name)


def wait_for_active(output_name: str, expected: bool) -> dict[str, Any]:
    latest: dict[str, Any] | None = None
    for _ in range(20):
        latest, _ = output_status(output_name)
        if latest["active"] is expected:
            return latest
        time.sleep(0.1)
    fail(f"输出 {output_name} 的 active 状态没有变为 {expected}：{latest}")


def enable(
    output_name: str,
    mode: str,
    rate: str,
    reference: str | None,
    rotation: str,
    position: str | None,
    projection: str,
) -> None:
    devices, dpys, _ = live_state()
    output = find_output(devices["outputs"], output_name)
    nvidia_output = find_output(dpys, output_name)
    if not output["connected"] or not nvidia_output["connected"]:
        fail(
            f"{output_name} 仍是 disconnected；请先安装配置并重新登录 X11，"
            "不要在当前会话强行启用。"
        )
    if mode not in output["modes"]:
        fail(f"{output_name} 不提供模式 {mode}：{', '.join(output['modes'])}")
    if rotation not in {"normal", "left", "right", "inverted"}:
        fail(f"不支持的旋转方向：{rotation}")
    placement: list[str]
    if projection == "duplicate":
        if position is not None:
            fail("复制模式不能同时指定显式坐标。")
        if reference is None:
            primary = next(
                (
                    item
                    for item in devices["outputs"]
                    if item["active"]
                    and item["primary"]
                    and item["output"] != output_name
                ),
                None,
            )
            if primary is None:
                fail("复制模式没有找到活动主显示器。")
            reference = str(primary["output"])
        reference_output = find_output(devices["outputs"], reference)
        if not reference_output["active"] or reference == output_name:
            fail(f"复制目标无效或未启用：{reference}")
        if reference_output["current_mode"] != mode:
            fail(
                f"复制模式要求与 {reference} 使用相同分辨率："
                f"{reference_output['current_mode']}，收到 {mode}"
            )
        placement = ["--same-as", reference]
    elif projection != "extend":
        fail(f"不支持的投影模式：{projection}")
    elif position is not None:
        if not re.fullmatch(r"\d+x\d+", position):
            fail(f"位置必须是非负 XRandR 坐标，例如 4000x0：{position}")
        placement = ["--pos", position]
    elif reference is not None:
        reference_output = find_output(devices["outputs"], reference)
        if not reference_output["active"] or reference == output_name:
            fail(f"参考显示器无效或未启用：{reference}")
        placement = ["--right-of", reference]
    else:
        physical_geometries = [
            item["geometry"]
            for item in devices["outputs"]
            if item["active"] and item["output"] != output_name and item["geometry"]
        ]
        if not physical_geometries:
            fail("没有找到可用于自动布局的活动物理显示器。")
        right_edge = max(geometry[2] + geometry[0] for geometry in physical_geometries)
        placement = ["--pos", f"{right_edge}x0"]
    command = [
        XRANDR,
        "--output",
        output_name,
        "--mode",
        mode,
        "--rate",
        rate,
        "--rotate",
        rotation,
        *placement,
    ]
    try:
        run(command)
        active = wait_for_active(output_name, True)
    except VirtualDisplayError:
        run([XRANDR, "--output", output_name, "--off"], check=False)
        raise
    print(
        json.dumps(
            {
                "result": "enabled",
                "output": output_name,
                "projection": projection,
                "geometry": active["geometry"],
            },
            ensure_ascii=False,
            indent=2,
        )
    )


def disable(output_name: str) -> None:
    output, _ = output_status(output_name)
    if not output["active"]:
        print(json.dumps({"result": "already-off", "output": output_name}, ensure_ascii=False))
        return
    run([XRANDR, "--output", output_name, "--off"])
    wait_for_active(output_name, False)
    print(json.dumps({"result": "disabled", "output": output_name}, ensure_ascii=False))


def validate_layout(
    output_name: str,
    value: Any,
    devices: dict[str, Any],
) -> list[dict[str, Any]]:
    if not isinstance(value, list) or not value or len(value) > 16:
        fail("显示布局必须是包含 1 到 16 个输出的 JSON 数组。")
    known = {item["output"]: item for item in devices["outputs"]}
    restored: list[dict[str, Any]] = []
    seen: set[str] = set()
    primary_count = 0
    for raw in value:
        if not isinstance(raw, dict):
            fail("显示布局中的输出必须是 JSON 对象。")
        name = raw.get("output")
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_.:-]+", name):
            fail(f"显示布局包含无效输出名：{name!r}")
        if name == output_name:
            fail(f"物理显示布局不能包含虚拟输出：{output_name}")
        if name in seen:
            fail(f"显示布局重复包含输出：{name}")
        seen.add(name)
        live = known.get(name)
        if not live or not live.get("connected"):
            fail(f"显示布局输出不存在或未连接：{name}")
        active = raw.get("active")
        if not isinstance(active, bool):
            fail(f"显示布局 active 必须是布尔值：{name}")
        primary = raw.get("primary", False)
        if not isinstance(primary, bool) or (primary and not active):
            fail(f"显示布局 primary 状态无效：{name}")
        primary_count += int(primary)
        entry: dict[str, Any] = {
            "output": name,
            "active": active,
            "primary": primary,
        }
        if active:
            mode = raw.get("mode")
            rate = raw.get("rate")
            rotation = raw.get("rotation")
            position = raw.get("position")
            if not isinstance(mode, str) or mode not in live.get("modes", []):
                fail(f"显示布局模式不受支持：{name} {mode!r}")
            if not isinstance(rate, str) or not re.fullmatch(
                r"\d{2,3}(?:\.\d{1,3})?", rate
            ):
                fail(f"显示布局刷新率无效：{name} {rate!r}")
            supported_rates = live.get("mode_rates", {}).get(mode, [])
            if supported_rates and rate not in supported_rates:
                fail(
                    f"显示布局刷新率不受支持：{name} {mode}@{rate}，"
                    f"可用值：{', '.join(supported_rates)}"
                )
            if rotation not in {"normal", "left", "right", "inverted"}:
                fail(f"显示布局旋转方向无效：{name} {rotation!r}")
            if (
                not isinstance(position, list)
                or len(position) != 2
                or any(not isinstance(item, int) or item < 0 for item in position)
            ):
                fail(f"显示布局坐标无效：{name} {position!r}")
            entry.update(
                mode=mode,
                rate=rate,
                rotation=rotation,
                position=position,
            )
        restored.append(entry)
    if primary_count > 1:
        fail("显示布局不能包含多个主显示器。")
    return restored


def restore_layout(output_name: str, layout_json: str) -> None:
    try:
        raw = json.loads(layout_json)
    except json.JSONDecodeError as error:
        fail(f"显示布局 JSON 无效：{error}")
    devices, _dpys, _ = live_state()
    layout = validate_layout(output_name, raw, devices)
    command = [XRANDR, "--output", output_name, "--off"]
    for item in layout:
        command.extend(["--output", item["output"]])
        if not item["active"]:
            command.append("--off")
            continue
        command.extend(
            [
                "--mode",
                item["mode"],
                "--rate",
                item["rate"],
                "--rotate",
                item["rotation"],
                "--pos",
                f"{item['position'][0]}x{item['position'][1]}",
            ]
        )
        if item["primary"]:
            command.append("--primary")
    run(command)
    latest, _dpys, _ = live_state()
    virtual = find_output(latest["outputs"], output_name)
    if virtual.get("active"):
        fail(f"恢复布局后虚拟输出仍处于活动状态：{output_name}")
    for expected in layout:
        actual = find_output(latest["outputs"], expected["output"])
        if bool(actual.get("active")) != expected["active"]:
            fail(f"恢复布局后活动状态不匹配：{expected['output']}")
        if not expected["active"]:
            continue
        if (
            actual.get("current_mode") != expected["mode"]
            or actual.get("current_rate") != expected["rate"]
            or actual.get("rotation") != expected["rotation"]
            or actual.get("geometry", [None, None, None, None])[2:]
            != expected["position"]
            or bool(actual.get("primary")) != expected["primary"]
        ):
            fail(
                f"恢复布局后输出状态不匹配：{expected['output']}，"
                f"实际={actual}，预期={expected}"
            )
    print(
        json.dumps(
            {"result": "layout-restored", "output": output_name, "layout": layout},
            ensure_ascii=False,
            indent=2,
        )
    )


def status(output_name: str) -> None:
    devices, dpys, _ = live_state()
    print(
        json.dumps(
            {
                "desktop": devices["current"],
                "maximum": devices["maximum"],
                "outputs": devices["outputs"],
                "xrandr": find_output(devices["outputs"], output_name),
                "nvidia": find_output(dpys, output_name),
                "system_xorg_installed": SYSTEM_XORG.is_file(),
                "system_edid_installed": SYSTEM_EDID.is_file(),
            },
            ensure_ascii=False,
            indent=2,
        )
    )


def verify(output_name: str, require_active: bool) -> None:
    output, nvidia_output = output_status(output_name)
    problems: list[str] = []
    if not output["connected"] or not nvidia_output["connected"]:
        problems.append("虚拟输出尚未被 NVIDIA/XRandR 识别为 connected")
    if DEFAULT_MODE not in output["modes"]:
        problems.append(f"缺少 {DEFAULT_MODE} 模式")
    if require_active and not output["active"]:
        problems.append("虚拟输出未启用")
    result = {
        "result": "pass" if not problems else "fail",
        "output": output,
        "nvidia": nvidia_output,
        "problems": problems,
    }
    print(json.dumps(result, ensure_ascii=False, indent=2))
    if problems:
        raise SystemExit(1)


def self_test() -> None:
    edid = build_edid()
    validate_edid(edid)
    sample_dpys = """
    [0] host:1[dpy:0] (HDMI-0) (connected, enabled)
      Has the following names:
        DFP
        DFP-0
        HDMI-0
    [1] host:1[dpy:1] (DP-0)
      Has the following names:
        DFP
        DFP-1
        DP-0
    [2] host:1[dpy:2] (HDMI-1) (connected, enabled)
      Has the following names:
        DFP
        DFP-3
        HDMI-1
    """
    parsed_dpys = parse_nvidia_dpys(sample_dpys)
    assert parsed_dpys == [
        {"output": "HDMI-0", "dpy": "DFP-0", "connected": True, "enabled": True},
        {"output": "DP-0", "dpy": "DFP-1", "connected": False, "enabled": False},
        {"output": "HDMI-1", "dpy": "DFP-3", "connected": True, "enabled": True},
    ]
    sample_xrandr = """Screen 0: minimum 8 x 8, current 4000 x 2560, maximum 32767 x 32767
HDMI-0 connected 1440x2560+0+0 left
   2560x1440  74.97*
DP-0 disconnected
HDMI-1 connected primary 2560x1440+1440+0 normal
   2560x1440  59.95*+
"""
    parsed_xrandr = parse_xrandr(sample_xrandr)
    assert parsed_xrandr["current"] == [4000, 2560]
    assert find_output(parsed_xrandr["outputs"], "HDMI-1")["primary"]
    assert find_output(parsed_xrandr["outputs"], "HDMI-0")["current_rate"] == "74.97"
