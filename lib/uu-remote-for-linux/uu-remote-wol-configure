#!/usr/bin/env bash
set -euo pipefail

die() {
    printf '错误：%s\n' "$1" >&2
    exit 1
}

(($# == 3)) || die "用法：uu-remote-wol-configure enable INTERFACE CONNECTION"
[[ $1 == enable ]] || die "只支持 enable 操作"
((EUID == 0)) || die "必须由 root 运行"

interface=$2
connection=$3
[[ $interface =~ ^[[:alnum:]_.:-]+$ ]] ||
    die "无效网卡名"
[[ -e /sys/class/net/"$interface"/device ]] ||
    die "不是物理网卡：$interface"
[[ $(nmcli -g connection.type connection show "$connection") == \
    802-3-ethernet ]] ||
    die "NetworkManager 连接不是有线类型"
devices=$(nmcli -g GENERAL.DEVICES connection show "$connection")
grep -Fxq "$interface" <<<"$devices" ||
    die "连接 $connection 当前未绑定到 $interface"

capabilities=$(ethtool "$interface")
supports=$(sed -n 's/^[[:space:]]*Supports Wake-on: //p' <<<"$capabilities")
[[ $supports == *g* ]] ||
    die "网卡 $interface 不支持 Magic Packet"

nmcli connection modify "$connection" 802-3-ethernet.wake-on-lan magic
ethtool -s "$interface" wol g
if [[ -w /sys/class/net/"$interface"/device/power/wakeup ]]; then
    printf 'enabled\n' >"/sys/class/net/$interface/device/power/wakeup"
fi

verified=$(ethtool "$interface")
grep -Eq '^[[:space:]]*Wake-on: g$' <<<"$verified" ||
    die "网卡写入后未保持 Wake-on: g"
printf '已为 %s（%s）启用 Magic Packet。\n' "$interface" "$connection"
